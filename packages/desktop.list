# Compositor, shell and session. None of this is in ublue base-main.
niri                        # copr:yalter/niri
xwayland-satellite
xorg-x11-server-Xwayland
greetd
greetd-selinux
foot
xdg-terminal-exec
xdg-desktop-portal-gnome
xdg-desktop-portal-gtk

# Keyring. gnome-keyring-pam is the load-bearing half: without it the
# pam_gnome_keyring line in /etc/pam.d/greetd cannot unlock the login keyring
# and every app prompts. Assert the .so exists at build time.
gnome-keyring
gnome-keyring-pam
gcr

# File manager and thumbnailing
nautilus
nautilus-python
glycin-thumbnailer
gst-thumbnailers
gnome-disk-utility

# gvfs: absent from base-main. Needed for network browsing in the file
# manager; there is an NFS NAS in /etc/fstab. The fstab mount itself uses
# kernel NFS via nfs-utils, which base-main already ships.
gvfs
gvfs-fuse
gvfs-nfs
gvfs-smb

# Session utilities referenced by the niri binds or our own scripts
brightnessctl               # binds.kdl volume/brightness
playerctl                   # binds.kdl media keys
ddcutil
kanshi
udiskie
btop                        # bound to Ctrl+Alt+Delete in local.kdl
wl-mirror
wtype                       # workstation-dictate
wev
tesseract                   # workstation-ocr (replaces Zirconium's zocr)
tesseract-langpack-eng
gum
chezmoi                     # ABSENT from base-main; seeding and `just audit` both die without it
fish                        # the image owns /usr/bin/fish; never install via brew
bolt                        # thunderbolt: /sys/bus/thunderbolt/devices/domain0 present
NetworkManager-tui          # nmtui
