// Image-owned niri system configuration.
//
// DO NOT EDIT on a running machine: this file is shipped by the image and is
// replaced on every update. Personal overrides belong in
// ~/.config/niri/local.kdl, which the user config includes last so it wins.
//
// Include order is load-bearing. niri resolves duplicate binds
// last-definition-wins, and the user's config.kdl includes DMS's generated
// dms.kdl after this file, so anything DMS binds takes precedence over the
// binds below. tooling/audit/niri-binds fails the build on a shadowed bind,
// which `niri validate` does not catch.
//
// Portions vendored from zirconium-dev/zdots under the Apache License 2.0.
// See NOTICE in this directory.

include "includes/binds.kdl"
include "includes/dms-base.kdl"
include "includes/input.kdl"
include "includes/layout.kdl"
include "includes/misc.kdl"
include "includes/shadow.kdl"
include "includes/window-rules.kdl"
include optional=true "/etc/niri/local.kdl"
