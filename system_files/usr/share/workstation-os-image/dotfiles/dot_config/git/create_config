# Global git config for user marc. The workstation runs Homebrew's git, which
# reads ~/.config/git/config (this file, seeded by chezmoi) but NOT /etc/gitconfig,
# so every git customization lives here — this is the single source of truth.

[user]
    name = marcortola
    email = 15958009+marcortola@users.noreply.github.com

[core]
    pager = delta
    autocrlf = input

[init]
    defaultBranch = main
    templateDir = ~/.config/git/template

[alias]
    st = status
    ci = commit
    co = checkout
    br = branch
    unstage = reset HEAD --
    last = log -1 HEAD

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[commit]
    verbose = true

[diff]
    algorithm = histogram
    colorMoved = default
    mnemonicPrefix = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true
    autoupdate = true

[branch]
    sort = -committerdate

[tag]
    sort = -version:refname

[column]
    ui = auto

[worktree]
    # Linked worktrees record the main repo with a relative path, so a checkout
    # stays a repository when it is bind-mounted into a Dev Container alongside
    # the common .git (see `dev`, which passes --mount-git-worktree-common-dir).
    useRelativePaths = true

[filter "lfs"]
    # `git lfs install` normally writes this block itself, but it also insists on
    # installing its own hooks and refuses to merge with the managed
    # post-checkout hook that init.templateDir already put in place. So the
    # config half is declared here and the hook half is chained from
    # ~/.config/git/template/hooks/post-checkout, and `git lfs install` is never
    # needed on this machine.
    #
    # required = true is upstream's own default and the loud one: without
    # git-lfs on PATH an LFS checkout fails instead of silently writing pointer
    # files into the working tree. The image ships git-lfs (dev.list) so that
    # branch is a build regression, not a state a user can reach.
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
