#!/usr/bin/env bash
# workstation-worktree-init: managed post-checkout hook v3
# post-checkout — chain Git LFS, then populate new git worktrees with their
# .worktreeinclude-listed gitignored files. Seeded into every repository's
# .git/hooks by init.templateDir (new clones) and by `just worktree-init`
# (existing repos). Because herdr and the agent recipes both shell out to the
# git binary, this fires for `git worktree add` from any client.
#
# The version in the sentinel above is the upgrade lever: `just worktree-init`
# replaces any installed hook whose version is older than this one. Bump it in
# the same change as an edit to the body, or the edit reaches no repository that
# already carries a hook.
#
# Args: $1 previous HEAD, $2 new HEAD, $3 branch-checkout flag (1 branch, 0 file).

# Git LFS wants this exact slot. `git lfs install` writes its own post-checkout
# here and refuses to merge with an incumbent -- it offers --force to clobber or
# --manual to print instructions, never a chain -- so whichever hook landed
# first shuts the other out. init.templateDir puts ours in first for every new
# clone, which makes ours the one that has to carry LFS.
#
# This runs BEFORE the branch-checkout gate below, because git-lfs's stock hook
# has no such gate: it refreshes the read-only bit on lockable files after a
# file checkout too. Gating it would make this hook a subset of the one it
# stands in for.
#
# Unlike that stock hook this never exits non-zero. A post-checkout exit status
# becomes `git worktree add`'s exit status, and a caller that reads that as
# failure walks away from a checkout git already finished -- the half-created
# state this hook exists downstream of.
if command -v git-lfs >/dev/null 2>&1; then
    git lfs post-checkout "$@" || true
fi

# The rest is worktree population, which only a branch checkout can need
# (git worktree add / git switch), never a file checkout.
[ "${3:-}" = "1" ] || exit 0

# Delegate to the shared helper, resolved without relying on PATH (a hook can
# be invoked with a minimal environment). Its own guards
# make it a no-op unless this is a linked worktree with files to copy. Called
# rather than exec'd, and followed by an unconditional `exit 0`: an exec would
# hand the caller the helper's exit status as this hook's, which is exactly the
# misreading the paragraph above exists to prevent.
for cand in workstation-worktree-sync "$HOME/.local/bin/workstation-worktree-sync"; do
    if command -v "$cand" >/dev/null 2>&1; then
        "$cand" || true
        break
    fi
done
exit 0
