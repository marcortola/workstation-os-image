#!/usr/bin/env bash
set -euo pipefail

projects_root="${WORKSTATION_PROJECTS_ROOT:-$HOME/projects}"
open_shell=false
open_herdr=false
case ${1:-} in
    --shell) open_shell=true ;;
    --herdr) open_herdr=true ;;
esac

mapfile -t projects < <(
    find "$projects_root" -mindepth 2 -maxdepth 3 \
        -type d -name .git -prune \
        -printf '%h\n' | sort
)

if (( ${#projects[@]} == 0 )); then
    echo "No Git projects found below $projects_root" >&2
    exit 1
fi

entries=()
for project in "${projects[@]}"; do
    relative=${project#"$projects_root/"}
    project_root=${relative%%/*}
    project_name=${relative#*/}
    entries+=("$project"$'\t'"$project_root / $project_name")
done

selection="$(
    printf '%s\n' "${entries[@]}" | \
        /usr/bin/fzf --layout=reverse --height=80% --border \
            --delimiter=$'\t' --with-nth=2 \
            --header='Enter: switch project · Esc: cancel' \
            --prompt='Projects > '
)" || exit 0

project=${selection%%$'\t'*}

# These helpers read the resolved "$herdr_bin" and "$jq_bin" plus the picked
# "$project" and "$label"; the --herdr branch below is their only caller and
# sets all four first.

# The dev layout is three tabs -- main running the agent, plus nvim and term. The
# plugin applies it only for a herdr-created worktree (worktree-create.sh) or on
# demand from prefix+shift+n, so a workspace reached through this picker never
# gets it. Gate on the tab count rather than on which branch called: layout.sh
# creates its tabs unconditionally, so a second run stacks another nvim and term.
# That gate also lays out a single-tab workspace restored from a session that
# predates this. layout.sh calls herdr, jq, git and dirname by name, and this
# script does not trust the PATH a niri keybind hands it. A failure here must not
# cost the caller its exec below, so it never propagates.
herdr_apply_layout() {
    local workspace=$1 tabs

    tabs="$("$herdr_bin" tab list --workspace "$workspace" 2>/dev/null |
        "$jq_bin" -r '[.result.tabs[]?] | length')" || return 0
    [[ $tabs == 1 ]] || return 0

    HERDR_BIN_PATH="$herdr_bin" \
        PATH="/usr/bin:/home/linuxbrew/.linuxbrew/bin:$PATH" \
        "$HOME/.config/herdr/plugins/dev-flow/layout.sh" "$workspace" "$project" >/dev/null ||
        return 0
}

# Focus the workspace an earlier pick already opened for this project rather
# than stacking a second one under the same label. The compare is exact, so it
# never captures a worktree workspace, which carries a branch slug as its label.
herdr_scope_workspace() {
    local existing

    # $label is a jq variable, not a shell one.
    # shellcheck disable=SC2016
    existing="$(
        "$herdr_bin" workspace list 2>/dev/null |
            "$jq_bin" -r --arg label "$label" \
                '[.result.workspaces[]? | select(.label == $label) | .workspace_id] | first // empty'
    )" || existing=''

    if [[ -n $existing ]]; then
        "$herdr_bin" workspace focus "$existing" >/dev/null
        herdr_apply_layout "$existing"
    else
        local created

        created="$(
            "$herdr_bin" workspace create --cwd "$project" \
                --label "$label" --focus |
                "$jq_bin" -r '.result.workspace.workspace_id // empty'
        )" || created=''

        if [[ -n $created ]]; then
            herdr_apply_layout "$created"
        fi
    fi
}

# The client this script execs into is what starts the server, so poll the API
# socket rather than guess how long that takes, and give up rather than linger
# when it never answers.
herdr_scope_workspace_when_ready() {
    local attempt

    for ((attempt = 0; attempt < 100; attempt++)); do
        if "$herdr_bin" workspace list >/dev/null 2>&1; then
            herdr_scope_workspace
            return
        fi
        sleep 0.1
    done

    return 1
}

# Every attached herdr client mirrors the others, so a second window is a second
# view of one session rather than a second context. When a window is already up,
# scoping the workspace has already moved it to the picked project -- so focus
# it and let this one close, instead of stacking a clone beside it. Both binds
# that launch a client are matched: Mod+Shift+T uses app-id `herdr`, this picker
# uses `dev-terminal`. Returns non-zero when there is nothing to focus, and the
# caller falls through to exec'ing a client of its own.
herdr_focus_existing_window() {
    local self other

    self="$("$niri_bin" msg -j focused-window 2>/dev/null |
        "$jq_bin" -r '.id // empty')" || return 1

    # This picker's own window is the focused one, so exclude it by id.
    # shellcheck disable=SC2016
    other="$(
        "$niri_bin" msg -j windows 2>/dev/null |
            "$jq_bin" -r --arg self "$self" \
                '[.[] | select(.app_id == "herdr" or .app_id == "dev-terminal")
                      | select((.id | tostring) != $self) | .id] | first // empty'
    )" || return 1

    [[ -n $other ]] || return 1
    "$niri_bin" msg action focus-window --id "$other" >/dev/null 2>&1
}

if $open_herdr; then
    # Attaching an existing session lands on whatever pane is focused, so the
    # picked project has to be the focused workspace before the client attaches.
    # A niri keybind runs this with a minimal PATH, so do not trust it.
    herdr_bin=herdr
    command -v herdr >/dev/null 2>&1 || herdr_bin=/home/linuxbrew/.linuxbrew/bin/herdr
    jq_bin=jq
    command -v jq >/dev/null 2>&1 || jq_bin=/usr/bin/jq
    niri_bin=niri
    command -v niri >/dev/null 2>&1 || niri_bin=/usr/bin/niri
    label="$(basename -- "$project")"

    # herdr scopes its startup workspace from the cwd only while the restored
    # session has none, and session.json carries workspaces across restarts, so
    # on a cold start the cwd is ignored and the pick lands in whichever
    # workspace was persisted. Scope over the socket instead: inline when a
    # server is already up, and from a waiter that outlives the exec below when
    # this launch is the one starting it.
    if "$herdr_bin" workspace list >/dev/null 2>&1; then
        herdr_scope_workspace
        # A client is already showing the workspace we just focused.
        herdr_focus_existing_window && exit 0
    else
        herdr_scope_workspace_when_ready >/dev/null 2>&1 &
    fi

    cd -- "$project"
    exec "$herdr_bin"
fi

if $open_shell; then
    cd -- "$project"
    exec /usr/bin/fish
fi

printf '%s\n' "$project"
