" =============================================================================
"  ~/.ideavimrc — Vim/LazyVim bindings for the JetBrains IDEs
"
"  Purpose: the JetBrains IDEs and Neovim answer to the same keys, so every
"  habit built in PhpStorm/WebStorm/DataGrip/IntelliJ/PyCharm transfers to
"  `nvim` and `dev nvim`. Where LazyVim and JetBrains disagree, LazyVim wins;
"  the displaced IDE action is re-exposed on the LazyVim <leader> key for it.
"
"  Repo-owned: chezmoi seed dot_ideavimrc, declared in tooling/data/dotfiles.manifest.
"  IdeaVim reads the FIRST of $IDEA_VIM_CUSTOM_VIMRC, ~/.ideavimrc, ~/_ideavimrc,
"  $XDG_CONFIG_HOME/ideavim/ideavimrc — and creates ~/.ideavimrc itself when
"  absent, which is why this lives at ~/.ideavimrc rather than under XDG.
"
"  Requires IdeaVim >= 2.45 (IntelliJ platform 2025.3+) and these Marketplace
"  plugins, installed by `just jetbrains-plugins` from _shared/plugins.list:
"    IdeaVIM                       the emulator
"    eu.theblob42.idea.whichkey    <leader> menus
"    org.yelog.ideavim.flash       s / S / f / t / ; / , — flash.nvim parity
"    com.magidc.ideavim.dial       <C-a> / <C-x> over dates, booleans, semver
"
"  Reload after editing: :source ~/.ideavimrc  (or the floating Reload button)
"  Find an action id:    :set trackactionids   then trigger it from the menu
" =============================================================================


" -----------------------------------------------------------------------------
" 1. Leaders. Must come first — plugin key variables are read at enable time.
" -----------------------------------------------------------------------------
let mapleader = " "
" IdeaVim does not implement <localleader>; LazyVim's <localleader> bindings are
" Neovim-only and cannot be practised here.


" -----------------------------------------------------------------------------
" 2. Core Vim options — the LazyVim defaults that actually transfer
" -----------------------------------------------------------------------------
set scrolloff=4
set sidescrolloff=8
set incsearch
set hlsearch
set ignorecase
set smartcase
set showcmd
set inccommand=nosplit

" 'number' and 'relativenumber' are IDE-setting-backed: these lines really flip
" the editor gutter, but only the per-editor local setting — the global IDE value
" in options/editor.xml is untouched. That is intended: counted motions (5j, 12k)
" are unreadable without them. Turn them off for the session with :set nonumber /
" :set norelativenumber (<leader>ul / <leader>uL below). Note :set number& does
" NOT mean "off" — it copies the current global IDE value.
set number
set relativenumber

" 'ideaput' routes p through the IDE paste, so multi-caret and reformat-on-paste
" keep working.
set clipboard+=unnamedplus
set clipboard+=ideaput

" Deliberately NOT set:
"   'wrap'       — IDE-setting-backed; would overwrite the repo's
"                  soft-wrap-in-preview-mode setting for *.md/*.txt/*.rst/*.adoc.
"                  Flip it per file with <leader>uw.
"   'undolevels' — registered so it parses, but nothing reads it (Options.kt
"                  carries the maintainers' own "doesn't appear to be used
"                  anywhere" TODO). Undo is the IDE's UndoManager.
"   'shiftround' / 'shiftwidth' — IdeaVim registers neither; > and < take their
"                  width from Settings | Editor | Code Style.


" -----------------------------------------------------------------------------
" 3. IdeaVim-only options
" -----------------------------------------------------------------------------
set ideajoin                 " J uses the IDE's smart join
set ideamarks                " capital marks <-> IDE bookmarks (feeds <leader>sm)
set idearefactormode=keep    " stay in the current Vim mode during refactorings
set ideastatusicon=gray      " the status-bar icon is the only Vim on/off toggle,
                             " because the repo sets SHOW_MAIN_MENU=false
set ideavimsupport=dialog
set ideawrite=all            " :w runs Save All, so Actions-on-Save still fire


" -----------------------------------------------------------------------------
" 4. Emulated plugins — all built into IdeaVim unless noted
" -----------------------------------------------------------------------------
Plug 'tpope/vim-commentary'              " gcc, gc{motion}  (LazyVim: mini.comment)
Plug 'tpope/vim-surround'                " remapped to gs* below
Plug 'tpope/vim-abolish'                 " crs crc crm cru cr- cr. crt
Plug 'machakann/vim-highlightedyank'
Plug 'wellle/targets.vim'
Plug 'vim-scripts/argtextobj.vim'        " aa / ia
Plug 'tommcdo/vim-exchange'              " cxx, cx{motion}, X
Plug 'kana/vim-textobj-entire'           " remapped to ag/ig below
Plug 'michaeljsmith/vim-indent-object'   " ii / ai / iI / aI (keys are fixed)
Plug 'jeetsukumaran/vim-indentwise'      " [- ]- [+ ]+ [= ]=
Plug 'dbakker/vim-paragraph-motion'
packadd matchit
set mini-ai                              " aq/iq any quote, ab/ib any bracket
set functextobj                          " am / aM / im   (PSI function object)
set classtextobj                         " ac             (PSI class object)
set dial                                 " needs com.magidc.ideavim.dial
set which-key                            " needs eu.theblob42.idea.whichkey

" Deliberately NOT enabled:
"   sneak               — vim-flash owns s/S below and does it with labels.
"   ReplaceWithRegister — owns gr/grr; LazyVim uses gr for LSP references.
"   CamelCaseMotion     — g:camelcasemotion_key='<leader>' eats <leader>w.
"   NERDTree            — the Project tool window is the file explorer here.
"   yankring            — minimal emulation and it steals <C-p>/<C-n>.
"   multiple-cursors    — not a LazyVim default. The transferable replacement is
"                         * then cgn then . repeated, which works in both editors.

let g:highlightedyank_highlight_duration = "200"

" dial registers only the :DialIncrement / :DialDecrement ex-commands — no keys
" of its own — so <C-a>/<C-x> must be wired up explicitly. Without this they fall
" through to IdeaVim's builtin number increment and never touch booleans, dates
" or semver. (The sethandler block below only decides that Vim, not the IDE,
" receives the keys.) Normal mode only: the commands are not visual-aware.
nnoremap <C-a> :DialIncrement<CR>
nnoremap <C-x> :DialDecrement<CR>

" mini.surround parity: LazyVim binds gsa/gsd/gsr, not tpope's ys/ds/cs.
let g:surround_no_mappings = 1
nmap gsa <Plug>YSurround
xmap gsa <Plug>VSurround
nmap gsd <Plug>DSurround
nmap gsr <Plug>CSurround

" vim-indent-object's keys cannot be remapped from here. IdeaVim defers every
" Plug extension's init() until after this file has finished executing
" (VimExtensionRegistrar.initExtension -> enableDelayedExtensions), and
" VimIndentObject.init() then calls the unconditional putKeyMapping for ai/aI/ii
" with no opt-out variable, so anything mapped over them here is silently
" overwritten at startup. Use its native keys: ii / ai for the indent block, aI
" to include the line below (LazyVim's mini.ai `ai` behaves like aI here).

" mini.ai exposes the whole buffer as ag/ig, not textobj-entire's ae/ie. The
" <Plug> names are parenthesised and carry the full two-char key.
xmap ag <Plug>(textobj-entire-ae)
omap ag <Plug>(textobj-entire-ae)
xmap ig <Plug>(textobj-entire-ie)
omap ig <Plug>(textobj-entire-ie)


" -----------------------------------------------------------------------------
" 5. vim-flash — LazyVim binds s/S/r to flash.nvim, so these are daily keys.
"    Needs the org.yelog.ideavim.flash Marketplace plugin.
" -----------------------------------------------------------------------------
nmap s <Action>(flash.search)
xmap s <Action>(flash.search)
nmap S <Action>(flash.treesitter)
xmap S <Action>(flash.treesitter)
omap r <Action>(flash.remote)
" flash.nvim's char mode enhances f/t/F/T/;/, by default; mirror it.
nmap f <Action>(flash.find)
xmap f <Action>(flash.find)
nmap F <Action>(flash.find_backward)
xmap F <Action>(flash.find_backward)
nmap t <Action>(flash.till)
xmap t <Action>(flash.till)
nmap T <Action>(flash.till_backward)
xmap T <Action>(flash.till_backward)
nmap ; <Action>(flash.repeat)
xmap ; <Action>(flash.repeat)
nmap , <Action>(flash.repeat_backward)
xmap , <Action>(flash.repeat_backward)


" -----------------------------------------------------------------------------
" 6. Which-Key. It renders only the mappings defined in this file; it never
"    creates any. Leaf entries fall back to showing their <Action> target, which
"    is self-describing, so only the group names are declared here.
" -----------------------------------------------------------------------------
set notimeout
set timeoutlen=10000

let g:WhichKey_DefaultDelay = 200
let g:WhichKey_ShowTypedSequence = "true"
let g:WhichKey_ShowVimActions = "false"
let g:WhichKey_SortOrder = "by_key_prefix_first"
let g:WhichKey_SortCaseSensitive = "false"
let g:WhichKey_Divider = " -> "
let g:WhichKey_KeyStyle = "bold"

let g:WhichKeyDesc_buffer      = "<leader>b +buffer"
let g:WhichKeyDesc_code        = "<leader>c +code"
let g:WhichKeyDesc_debug       = "<leader>d +debug"
let g:WhichKeyDesc_file        = "<leader>f +file/find"
let g:WhichKeyDesc_git         = "<leader>g +git"
let g:WhichKeyDesc_git_hunks   = "<leader>gh +hunks"
let g:WhichKeyDesc_quit        = "<leader>q +quit/session"
let g:WhichKeyDesc_search      = "<leader>s +search"
let g:WhichKeyDesc_test        = "<leader>t +test"
let g:WhichKeyDesc_ui          = "<leader>u +ui"
let g:WhichKeyDesc_windows     = "<leader>w +windows"
let g:WhichKeyDesc_diagnostics = "<leader>x +diagnostics"


" -----------------------------------------------------------------------------
" 7. sethandler — who owns each contested Ctrl key.
"    keymapFlags.xml ships an empty descriptor list, so without this block the
"    IDE pops an "undefined handler" dialog per key on first launch and silently
"    defaults them to Vim. Declaring them here makes them read-only in
"    Settings | Editor | Vim, which is what a repo-owned config wants.
" -----------------------------------------------------------------------------

" Vim wins. Each displaced IDE action is re-exposed on a <leader> key below.
sethandler <C-B> a:vim         " page up            (IDE Go to Declaration -> gd)
sethandler <C-D> a:vim         " half page down     (IDE Duplicate -> yyp)
sethandler <C-U> a:vim         " half page up       (IDE Go to Super Method)
sethandler <C-E> a:vim         " scroll down        (IDE Recent Files -> <leader>fr)
sethandler <C-F> a:vim         " page down          (IDE Find -> <leader>sb)
sethandler <C-Y> a:vim         " scroll up          (IDE Delete Line -> dd)
sethandler <C-T> a:vim         " pop tag stack      (Terminal -> <leader>ft)
sethandler <C-O> a:vim         " jumplist back
sethandler <C-I> a:vim         " jumplist forward
sethandler <C-R> a:vim         " redo               (IDE Replace -> <leader>sr)
sethandler <C-W> a:vim         " window prefix      (IDE Extend Selection -> S)
sethandler <C-H> a:vim         " window left
sethandler <C-J> a:vim         " window down        (IDE Live Template is lost)
sethandler <C-K> a:vim         " window up          (IDE Commit -> <leader>gs)
sethandler <C-L> a:vim         " window right

" Split: Vim in normal/visual, IDE while typing.
sethandler <C-A> n-x:vim i:ide     " dial increment  / Select All
sethandler <C-X> n-x:vim i:ide     " dial decrement  / Cut
sethandler <C-V> n-x:vim i:ide     " visual block    / Paste
sethandler <C-N> n-x:vim i:ide     " (unused in Vim) / completion
sethandler <C-P> n-x:vim i:ide     " (unused in Vim) / completion
" Ctrl+C is an OS convention, not a JetBrains customisation: it keeps copying
" when there is a selection, and aborts while typing. For strict Vim semantics
" change this to a:vim and rely on y (clipboard+=unnamedplus).
sethandler <C-C> n-x:ide i:vim

" IDE wins outright — no Vim meaning worth reclaiming in a GUI.
sethandler <C-S> a:ide         " Save All
sethandler <C-Z> a:ide         " IDE undo (kept out of the Vim undo tree)
sethandler <C-G> a:ide         " Go to Line
sethandler <C-Q> a:ide         " Quick Documentation
sethandler <C-Space> a:ide     " code completion; S is the treesitter key here


" -----------------------------------------------------------------------------
" 8. Neovim default behaviours worth reproducing
" -----------------------------------------------------------------------------
nnoremap Y y$
xnoremap < <gv
xnoremap > >gv
inoremap <C-U> <C-G>u<C-U>
inoremap <C-W> <C-G>u<C-W>
" <C-u> clears the range IdeaVim prefills from a pending count, so 5<Esc> runs
" :nohlsearch instead of :.,.+4nohlsearch (E481: no range allowed).
nnoremap <esc> :<C-u>nohlsearch<CR>

" Window navigation (LazyVim binds <C-h/j/k/l>; these drive IDE editor splits)
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Move line / selection — LazyVim's <A-j>/<A-k>. This takes IntelliJ's
" Add Selection for Next Occurrence off Alt+J; use * cgn . instead.
nmap <A-j> <Action>(MoveLineDown)
nmap <A-k> <Action>(MoveLineUp)
imap <A-j> <Action>(MoveLineDown)
imap <A-k> <Action>(MoveLineUp)
xmap <A-j> <Action>(MoveLineDown)
xmap <A-k> <Action>(MoveLineUp)


" -----------------------------------------------------------------------------
