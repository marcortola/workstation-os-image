#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} != "--accept-microsoft-eula" ]]; then
    echo "This downloads and installs Microsoft fonts from their original distributors."
    echo "Using the fonts signifies acceptance of the applicable Microsoft EULAs."
    echo "Re-run with --accept-microsoft-eula to continue."
    exit 2
fi

font_root="${XDG_DATA_HOME:-$HOME/.local/share}/fonts"
target="$font_root/Microsoft"
marker="${XDG_STATE_HOME:-$HOME/.local/state}/workstation-os-image/fonts-installed"

# The marker records the hash of THIS script, not merely that it ran once.
# With a plain existence check every later edit here was dead code on any
# account that had already run it -- a new font, a changed URL, a fixed
# checksum, none of it would land, and the unit reported success by not
# running. Same treatment as workstation-bootstrap-user.
script_hash="$(tr -d "[:space:]" <"$0" | sha256sum | cut -d " " -f 1)"
if [[ -f $marker && "$(cat "$marker")" == "$script_hash" ]]; then
    echo "Microsoft fonts already current."
    exit 0
fi

workdir="$(mktemp -d)"
trap 'rm -rf -- "$workdir"' EXIT

# Pinned upstream references so a compromised or changed HEAD/latest cannot
# alter what this installer fetches.
nerd_fonts_version=v3.4.0
ia_fonts_commit=f32c04c3058a75d7ce28919ce70fe8800817491b
font_awesome_version=6.7.2

mkdir -p "$target" "$font_root/CaskaydiaMono" \
    "$font_root/iAWriterMono" "$font_root/FontAwesome" \
    "$workdir/rpm"

# Redistributable user fonts used by terminal and desktop applications.
curl -fL --retry 3 -o "$workdir/CascadiaMono.tar.xz" \
    "https://github.com/ryanoasis/nerd-fonts/releases/download/$nerd_fonts_version/CascadiaMono.tar.xz"
tar -xJf "$workdir/CascadiaMono.tar.xz" -C "$font_root/CaskaydiaMono"

curl -fL --retry 3 -o "$workdir/ia-fonts.zip" \
    "https://github.com/iaolo/iA-Fonts/archive/$ia_fonts_commit.zip"
unzip -j -o "$workdir/ia-fonts.zip" '*/iA Writer Mono/Static/*.ttf' \
    -d "$font_root/iAWriterMono"

curl -fL --retry 3 -o "$workdir/font-awesome.zip" \
    "https://github.com/FortAwesome/Font-Awesome/releases/download/$font_awesome_version/fontawesome-free-$font_awesome_version-desktop.zip"
unzip -j -o "$workdir/font-awesome.zip" '*/otfs/*.otf' \
    -d "$font_root/FontAwesome"

# The mscorefonts2 project publishes no checksum for this RPM; the cab files
# it later downloads are verified against the sha256sums embedded in it.
curl -fL --retry 3 \
    -o "$workdir/msttcore-fonts-installer.rpm" \
    https://downloads.sourceforge.net/project/mscorefonts2/rpms/msttcore-fonts-installer-2.6-1.noarch.rpm

(
    cd "$workdir/rpm"
    rpm2cpio "$workdir/msttcore-fonts-installer.rpm" | cpio -idm --quiet
)

"$workdir/rpm/usr/lib/msttcore-fonts-installer/refresh-msttcore-fonts.sh" \
    -F "$target" \
    -S "$workdir/rpm/usr/lib/msttcore-fonts-installer/cabfiles.sha256sums" \
    -I "$target/installed-list.txt" \
    -L "$target"

# Regular Cambria is not installed here. It ships only as a TTC collection that
# the msttcore helper's TTF-only filter skips, so this script used to fetch it
# separately from a sha256-pinned PowerPointViewer.exe. That download broke:
# the SourceForge mirror now serves a different artifact (27,024,112 bytes,
# inner cambria.ttc 44b855cf...) than the pinned one (63,210,976 bytes, inner
# cambria.ttc d675f6ef...), Microsoft's own URL is 404, and the whole run failed
# at the checksum on every login. Bumping the pin to match the mirror would have
# turned the check into a rubber stamp for exactly the case it exists to catch.
#
# google-crosextra-caladea-fonts (build_files/packages/fonts.list) covers it
# instead: Caladea is metric-compatible with Cambria and its shipped
# 30-0-google-crosextra-caladea-fonts.conf aliases the name, so a request for
# Cambria resolves to Caladea. Verified that its 62- rule does NOT steal the
# generic serif, which stays Noto Serif.

fc-cache -f "$font_root"
install -D -m 0644 /dev/null "$marker"
printf '%s\n' "$script_hash" > "$marker"
echo "Workstation fonts installed in $font_root"
