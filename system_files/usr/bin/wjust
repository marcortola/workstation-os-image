#!/usr/bin/env bash
# Image-owned launcher for the workstation justfile: run any `wjust <recipe>`
# from any shell or directory, cloning the checkout on demand. Lives in the
# image rather than a create-only Fish alias, so it ships and updates with every
# build and reaches existing machines. The first-login bootstrap no longer clones
# eagerly; the checkout materialises here the first time a recipe runs.
set -euo pipefail

repo="$HOME/projects/personal/workstation-os-image"

if [[ ! -e $repo ]]; then
    mkdir -p "$(dirname "$repo")"
    # shellcheck source=/dev/null
    source /usr/share/workstation-os-image/image.env
    git clone "https://github.com/${REPO_ORGANIZATION}/${IMAGE_NAME}.git" "$repo"
elif [[ ! -d $repo/.git ]]; then
    echo "wjust: $repo exists but is not a Git checkout." >&2
    exit 1
fi

# cd rather than --justfile/--working-directory: just requires --justfile
# whenever --working-directory is given, which would hardcode the file name
# into the image. Searching from the checkout keeps the launcher agnostic to
# justfile vs Justfile, so a rename never needs a matching bootc upgrade.
cd "$repo"
exec just "$@"
