# Image-owned. The previous base shipped this unit; ublue base-main does not,
# and the RPM providing the binary ships no unit of its own.
[Unit]
Description=Autorotation service
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/iio-niri listen
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
