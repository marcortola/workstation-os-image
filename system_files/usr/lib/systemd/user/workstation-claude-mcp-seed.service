[Unit]
Description=Seed default Claude Code MCP servers
Documentation=https://github.com/marcortola/workstation-os-image
Wants=network-online.target
# graphical-session.target: ordered after it for the same reason as
# workstation-bootstrap.service, whose DMS-dependent chain we run after.
After=network-online.target workstation-bootstrap.service graphical-session.target
ConditionPathExists=!%h/.local/state/workstation-os-image/claude-mcp-seeded
# Every user manager reaches default.target, including the one pam_systemd
# starts for greetd's `greeter` account, whose home is read-only. Without this
# the unit fails on every login screen. `!@system` excludes accounts below
# SYS_UID_MAX.
ConditionUser=!@system

[Service]
Type=oneshot
# Homebrew provides claude, and workstation-bootstrap installs it. Until then
# this has nothing to seed. As an ExecCondition that is a SKIP; as a non-zero
# ExecStart it was a failed unit, which our own audit then reported on every
# fresh machine. The retry is unchanged -- the marker still stays absent.
ExecCondition=/usr/bin/test -x /home/linuxbrew/.linuxbrew/bin/claude
ExecStart=/usr/libexec/workstation-seed-claude-mcp

[Install]
WantedBy=graphical-session.target
