#!/usr/bin/env bash
# Ensure the image's Flatpak Google Chrome is running with a CDP endpoint on
# loopback so playwright-cli can attach over CDP -- no second browser is layered
# into the image. Idempotent: an already-running endpoint is reused. Prints the
# CDP endpoint on stdout.
#
# Chrome is only a Flatpak here (com.google.Chrome); Playwright cannot launch a
# Flatpak directly, so we start Chrome ourselves with a debugging port and let
# the CLI connect with `attach --cdp`. (This is the CDP half of the former
# workstation-playwright-mcp wrapper, now shared by the CLI.)
#
# `--stop` tears the browser down again, and nothing did before it. The browser
# outliving each CLI invocation is the design; outliving the work is not, and
# two were found here 2.65 and 2.84 days old still holding the pages of finished
# sessions. `playwright-cli close` reaches this, so the close the skill
# documents is now a real one.
#
# Env: WORKSTATION_PLAYWRIGHT_CDP_PORT (default 9222),
#      WORKSTATION_PLAYWRIGHT_HEADED (1 for a visible window).
set -euo pipefail

port="${WORKSTATION_PLAYWRIGHT_CDP_PORT:-9222}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
state_dir="$runtime_dir/workstation-playwright"
profile_dir="$state_dir/chrome-profile"
log_file="$state_dir/chrome.log"

cdp_endpoint="http://127.0.0.1:${port}"

# --connect-timeout bounds the connect, not the response. A browser that has
# wedged still accepts the connection and then answers nothing, and curl has no
# default overall limit, so this probe -- and every `playwright-cli open` behind
# it -- hung on it. One was reproduced here returning nothing after 3 s.
cdp_up() {
    curl -fs --connect-timeout 1 --max-time 3 \
        "${cdp_endpoint}/json/version" >/dev/null 2>&1
}

# The profile directory is this script's own per-boot path, which makes it an
# exact identity for every process of this browser -- the zypak-forked children
# included, since they inherit the cmdline that carries it -- and one that cannot
# match the user's real Chrome, whose profile is elsewhere. Two more obvious
# mechanisms were measured and both fail:
#
#   * Recording `flatpak run`'s pid and killing it does nothing. flatpak moves
#     the app into its own transient app-flatpak-*.scope, so that bwrap is not
#     the browser's cgroup owner and killing it left 16 processes alive with the
#     CDP port still answering.
#   * `flatpak run --die-with-parent` does fix the ancestry -- the same kill then
#     takes the browser down completely -- but it binds the app to the invoking
#     shell, so Chrome died the instant this script exited and every subcommand
#     would have relaunched it. That defeats the reuse this whole file exists for.
#
# pgrep only narrows the candidates; /proc decides. A cmdline SUBSTRING match is
# not good enough, and excluding this shell and its parent does not rescue it:
# any process whose command line merely mentions the profile path matches, and a
# grandparent shell, a sibling, or a parallel agent's `bash -c` is neither $$ nor
# $PPID. Three shells were killed that way during development, the first on a
# read-only investigation. So require the path to be an exact argv ELEMENT --
# which a shell's `-c` string, carrying the whole command as one element, can
# never be, while every real process of this browser carries it as its own.
targets() {
    local pid arg
    for pid in $(pgrep -u "$(id -u)" -f "user-data-dir=$profile_dir" 2>/dev/null || true); do
        [[ $pid == "$$" || $pid == "$PPID" ]] && continue
        [[ -r /proc/$pid/cmdline ]] || continue
        while IFS= read -r -d '' arg; do
            if [[ $arg == "--user-data-dir=$profile_dir" ]]; then
                printf '%s\n' "$pid"
                break
            fi
        done < "/proc/$pid/cmdline"
    done
}

stop_chrome() {
    local pids
    mapfile -t pids < <(targets)
    (( ${#pids[@]} )) || return 0
    kill "${pids[@]}" 2>/dev/null || true
    for _ in $(seq 1 40); do
        mapfile -t pids < <(targets)
        (( ${#pids[@]} )) || return 0
        sleep 0.25
    done
    kill -9 "${pids[@]}" 2>/dev/null || true
}

if [[ ${1:-} == --stop ]]; then
    stop_chrome
    exit 0
fi

mkdir -p "$profile_dir"

headless_flag="--headless=new"
[[ "${WORKSTATION_PLAYWRIGHT_HEADED:-0}" == "1" ]] && headless_flag=""

if ! cdp_up; then
    # Loopback-only debugging port; a throwaway per-boot profile under the tmpfs
    # runtime dir. nohup (not setsid) keeps Chrome attached to the graphical
    # session's D-Bus portal while surviving this script's exit, so the next
    # invocation reuses the same browser. Deliberately no --die-with-parent
    # here; see stop_chrome above for what that flag actually binds to.
    nohup flatpak run com.google.Chrome \
        ${headless_flag:+"$headless_flag"} \
        --no-first-run \
        --no-default-browser-check \
        --disable-gpu \
        --user-data-dir="$profile_dir" \
        --remote-debugging-address=127.0.0.1 \
        --remote-debugging-port="$port" \
        about:blank \
        >"$log_file" 2>&1 &

    for _ in $(seq 1 60); do
        cdp_up && break
        sleep 0.5
    done

    if ! cdp_up; then
        echo "workstation-playwright-chrome: CDP endpoint ${cdp_endpoint} did not come up." >&2
        echo "Is the com.google.Chrome Flatpak installed? See ${log_file}." >&2
        exit 1
    fi
fi

printf '%s\n' "$cdp_endpoint"
