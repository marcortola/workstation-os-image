# Image-owned foot entrypoint.
#
# DO NOT EDIT on a running machine: chezmoi replaces this file. Personal
# settings belong in ~/.config/foot/workstation.ini, which is included last
# so it wins.
#
# dank-colors.ini is regenerated by DMS/matugen on every theme change and is
# seeded create_-only, so a fresh account still parses before DMS first runs.
# foot has no optional include, so the file must exist.

[main]
include={{ .chezmoi.homeDir }}/.config/foot/dank-colors.ini

[main]
include={{ .chezmoi.homeDir }}/.config/foot/workstation.ini
