[Unit]
Description=Seed workstation dotfiles for a new account
Documentation=https://github.com/marcortola/workstation-os-image
ConditionPathExists=!%h/.config/workstation-os-image/chezmoi/chezmoi.toml

[Service]
Type=oneshot
ExecStart=/usr/libexec/workstation-chezmoi-apply --init

[Install]
WantedBy=graphical-session-pre.target
