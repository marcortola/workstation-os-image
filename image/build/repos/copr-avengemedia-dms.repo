# DankMaterialShell proper. dms-cli is a subpackage of the dms source package;
# dms-greeter is built in the danklinux project, not this one.
[copr:copr.fedorainfracloud.org:avengemedia:dms]
name=Copr repo for dms owned by avengemedia
baseurl=https://download.copr.fedorainfracloud.org/results/avengemedia/dms/fedora-$releasever-$basearch/
type=rpm-md
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/copr-avengemedia-dms.asc
repo_gpgcheck=0
enabled=1
priority=1
includepkgs=dms,dms-cli
