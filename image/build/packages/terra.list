# Terra (Fyra Labs). Fenced hard with includepkgs: on the Zirconium image Terra
# shipped sdbus-cpp.terra, which satisfies libsdbus-c++.so.2 for dnf5 itself.
# An allowlist makes the repo structurally incapable of shadowing anything else.
uupd                        # unified bootc + flatpak + brew + distrobox updates
satty                       # DMS_SCREENSHOT_EDITOR
iio-niri                    # display autorotation; iio:device0 present on this machine
maple-fonts
xdg-terminal-exec-nautilus
# NOT openh264: fedora-cisco-openh264 is already in base-main.
# NOT brew-proxy: dropped; Homebrew comes from ghcr.io/ublue-os/brew (Containerfile).
# NOT cardwire: GPU management, inert on an Intel-only laptop.
