#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

git diff --check

mapfile -t shell_files < <(
    find scripts system_files/usr/bin system_files/usr/libexec -type f \
        \( -perm /111 -o -name '*.sh' \) -print | sort
    find system_files/usr/share/zirconium/zdots -type f \
        -name 'create_executable_*' -print | sort
    # Bundle scripts only (maxdepth 1 skips the vendored Node installer).
    find share/ai-cli-setup -maxdepth 1 -name '*.sh' -print | sort
)
bash -n "${shell_files[@]}"
shellcheck "${shell_files[@]}"
just --fmt --check
just --list >/dev/null

# Lint the image build and CI workflows, and scan the tree for committed
# secrets. CI enforces the same three checks in .github/workflows/lint.yml.
scripts/validate-image-build
hadolint --config .hadolint.yaml Containerfile
actionlint
gitleaks dir . --no-banner --redact

[[ $(< CLAUDE.md) == '@AGENTS.md' ]]
(( $(wc -l < AGENTS.md) <= 200 ))

# AI CLI config seeds must be secret-free by construction: the scrub filters
# strip secrets/machine-state on capture, and these positive gates assert the
# committed seeds (visible to CI even when live files are absent). gitleaks
# above is the generic backstop; these catch the tool-specific shapes it misses
# (e.g. the dash-broken context7 key gitleaks does not flag).
ai_seeds=system_files/usr/share/zirconium/zdots
assert_absent() {
    # Fail if the extended-regexp $1 matches (case-insensitively) anywhere in
    # file $2. A plain `! grep` would be exempt from errexit and silently pass,
    # so branch.
    if grep -qiE "$1" "$2"; then
        echo "Secret/machine-state leaked into $2 (matched: $1)" >&2
        exit 1
    fi
}
claude_settings="$ai_seeds/dot_claude/create_settings.json"
jq -e 'has("env") | not' "$claude_settings" >/dev/null
# Help Scout leaks as the env-var values (HELPSCOUT_APP_*) AND as the lowercase
# plugin/marketplace identifiers (helpscout-navigator, help-scout-mcp).
assert_absent 'helpscout|help-scout' "$claude_settings"
assert_absent 'enabledPlugins|extraKnownMarketplaces' "$claude_settings"
assert_absent '/(var/)?home/' "$claude_settings"
jq -e '(.mcp.context7 == null)
    or (.mcp.context7.headers.CONTEXT7_API_KEY
        | . == null or startswith("{file:") or startswith("{env:"))' \
    "$ai_seeds/dot_config/opencode/create_opencode.json" >/dev/null
# The codex seed is top-level keys only; ANY [table] means machine/runtime state
# (trust, nux, mcp_servers, ...) leaked past the scrub -- fail closed.
assert_absent '^\[' "$ai_seeds/dot_codex/create_config.toml"
assert_absent '/(var/)?home/' "$ai_seeds/dot_codex/create_config.toml"
assert_absent \
    '(\.local/share/opencode/auth\.json|\.codex/auth\.json|\.claude/\.credentials\.json)' \
    config/dotfiles.manifest
# The portable bundle is a projection of the seeds; it too must carry no key,
# no Help Scout association, and no absolute home path.
if grep -rIliE 'ctx7sk-|helpscout|help-scout|/home/[a-z]' \
    share/ai-cli-setup/config share/ai-cli-setup/opencode-mcp-fragment.json \
    >/dev/null 2>&1; then
    echo "Secret or absolute home path leaked into share/ai-cli-setup" >&2
    exit 1
fi

# Worktree untracked-file propagation: every creation path (workmux, Claude
# Code, the post-checkout hook, the JetBrains External Tool) must read the same
# committed .worktreeinclude, so assert the wiring that keeps them in sync.
workmux_seed=system_files/usr/share/zirconium/zdots/dot_config/workmux/create_config.yaml
grep -q '^post_create:' "$workmux_seed"
grep -q 'workstation-worktree-sync' "$workmux_seed"
grep -q 'satococoa/tap/git-worktreeinclude' \
    system_files/usr/share/zirconium/zdots/dot_config/homebrew/create_Brewfile
grep -q 'templateDir' system_files/usr/share/zirconium/zdots/dot_config/git/create_config
[[ -x scripts/worktree-init ]]
scripts/test-worktree-init

scripts/validate-dms-overlay
jq -n -e \
    --slurpfile defaults <(scripts/dms-settings-defaults) \
    --rawfile denied config/dms-settings-denylist '
    ($denied | split("\n")
      | map(sub("[[:space:]]*#.*$"; "") | select(length > 0))) as $keys
    | $keys | all(. as $key | $defaults[0] | has($key))
' >/dev/null

scripts/test-dms-settings

fish --no-execute \
    system_files/usr/share/zirconium/zdots/dot_config/fish/create_config.fish \
    system_files/usr/share/zirconium/zdots/dot_config/fish/conf.d/*.fish \
    system_files/usr/share/zirconium/zdots/dot_config/fish/functions/*.fish

scripts/validate-manifest
scripts/validate-jetbrains-settings
scripts/test-reset-ai-cli
scripts/build-ai-cli-bundle --check

tmp="$(mktemp -d)"
trap 'rm -rf -- "$tmp"' EXIT

# Git reads the XDG global config before ~/.gitconfig, so a create-only
# identity seed coexists with credential helpers and lets explicit user
# identity overrides in ~/.gitconfig continue to win.
git_home="$tmp/git-home"
install -D -m 0644 \
    system_files/usr/share/zirconium/zdots/dot_config/git/create_config \
    "$git_home/.config/git/config"
git config --file "$git_home/.gitconfig" credential.helper store
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config user.name
) == marcortola ]]
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config user.email
) == 15958009+marcortola@users.noreply.github.com ]]
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config credential.helper
) == store ]]
git config --file "$git_home/.gitconfig" user.name "Local Override"
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config user.name
) == "Local Override" ]]

scripts/audit-workstation
foot --check-config -c "$HOME/.config/foot/foot.ini"

cp -a /usr/share/zirconium/zdots/. "$tmp/"
cp -a system_files/usr/share/zirconium/zdots/. "$tmp/"
chezmoi managed -S "$tmp" > "$tmp/managed"

for target in \
    .config/foot/foot.ini \
    .config/foot/workstation.ini \
    .config/DankMaterialShell/themes/tokyoNightDark/theme.json \
    .config/git/config \
    .config/git/ignore \
    .config/git/template/hooks/post-checkout \
    .config/niri/config.kdl \
    .config/niri/local.kdl \
    .config/homebrew/Brewfile; do
    grep -Fqx "$target" "$tmp/managed"
done

echo "Repository and local workstation validation passed."
