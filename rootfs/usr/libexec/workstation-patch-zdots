#!/usr/bin/env bash
set -euo pipefail

foot=/usr/share/zirconium/zdots/dot_config/foot/foot.ini.tmpl
include='include={{.chezmoi.homeDir}}/.config/foot/workstation.ini'

if ! grep -Fqx "$include" "$foot"; then
    grep -Fq 'include={{.chezmoi.homeDir}}/.config/foot/dank-colors.ini' "$foot"

    # Extend the current upstream template instead of replacing it. The include
    # is last so personal settings win while future Zirconium template updates
    # remain.
    printf '\n[main]\n%s\n' "$include" >> "$foot"
fi

# Zirconium ships DankMaterialShell/clsettings.json as a plain chezmoi source,
# which reapplies over the clipboard settings the DMS UI owns. This image ships
# create_clsettings.json so the seed lands once and later UI edits win. chezmoi
# refuses two sources for one target ("inconsistent state"), which breaks every
# `chezmoi diff` the audit runs, so drop the upstream copy.
dms=/usr/share/zirconium/zdots/dot_config/DankMaterialShell
if [[ -f $dms/create_clsettings.json && -f $dms/clsettings.json ]]; then
    rm -f "$dms/clsettings.json"
fi
