// Entrypoint for the image's niri configuration.
//
// DO NOT EDIT: chezmoi replaces this file on every update. Personal overrides
// belong in ~/.config/niri/local.kdl, which is included last so it wins.
//
// niri docs: https://yalter.github.io/niri/
// DMS docs:  https://danklinux.com/docs/
//
// Include order is load-bearing and must not be reordered casually. niri
// resolves duplicate binds last-definition-wins, so dms.kdl coming after the
// system config means DMS owns every key its generated fragment binds, and
// local.kdl coming last means the user always wins.
// tooling/audit-niri-binds fails on a shadowed bind; `niri validate` does not.

// image-owned system configuration (binds, input, layout, window rules)
include "/usr/share/workstation-os-image/niri/workstation.kdl"

// DankMaterialShell's generated fragments
include "dms.kdl"

// personal overrides, last so they win
include optional=true "local.kdl"
