# kind|live path relative to $HOME|chezmoi source path|file pattern
#
# scaffold: image-owned, chezmoi-applied, never captured from live and never
# drift-audited. These files exist because the base no longer supplies them.
# The static ones chezmoi keeps in sync by itself, so auditing them would be
# redundant; dank-colors.ini is regenerated by matugen at runtime, so auditing
# it would report drift on every theme change.
scaffold|.config/niri/config.kdl|dot_config/niri/config.kdl|-
scaffold|.config/niri/dms.kdl|dot_config/niri/dms.kdl|-
scaffold|.config/foot/foot.ini|dot_config/foot/foot.ini.tmpl|-
scaffold|.config/foot/dank-colors.ini|dot_config/foot/create_dank-colors.ini|-
copy|.codex/AGENTS.md|dot_codex/create_AGENTS.md|-
scrub|.codex/config.toml|dot_codex/create_config.toml|codex-config
copy|.codex/bin/helpscout-mcp|dot_codex/bin/create_helpscout-mcp|-
copy|.claude/CLAUDE.md|dot_claude/create_CLAUDE.md|-
scrub|.claude/settings.json|dot_claude/create_settings.json|claude-settings
copy|.claude/rules/context7.md|dot_claude/rules/create_context7.md|-
tree|.claude/skills/context7-mcp|dot_claude/skills/context7-mcp|*
tree|.claude/skills/weekly-summary|dot_claude/skills/weekly-summary|*
tree|.codex/skills/weekly-summary|dot_codex/skills/weekly-summary|*
copy|.claude/commands/worktree-create.md|dot_claude/commands/create_worktree-create.md|-
copy|.claude/commands/worktree-push.md|dot_claude/commands/create_worktree-push.md|-
copy|.claude/commands/worktree-remove.md|dot_claude/commands/create_worktree-remove.md|-
tree|.codex/skills/worktree-create|dot_codex/skills/worktree-create|*
tree|.codex/skills/worktree-push|dot_codex/skills/worktree-push|*
tree|.codex/skills/worktree-remove|dot_codex/skills/worktree-remove|*
copy|.config/opencode/AGENTS.md|dot_config/opencode/create_AGENTS.md|-
copy|.config/opencode/commands/worktree-create.md|dot_config/opencode/commands/create_worktree-create.md|-
copy|.config/opencode/commands/worktree-push.md|dot_config/opencode/commands/create_worktree-push.md|-
copy|.config/opencode/commands/worktree-remove.md|dot_config/opencode/commands/create_worktree-remove.md|-
copy|.config/git/config|dot_config/git/create_config|-
copy|.config/git/ignore|dot_config/git/create_ignore|-
copy|.config/git/template/hooks/post-checkout|dot_config/git/template/hooks/create_executable_post-checkout|-
copy|.config/fish/config.fish|dot_config/fish/create_config.fish|-
directory|.config/fish/conf.d|dot_config/fish/conf.d|*.fish
directory|.config/fish/functions|dot_config/fish/functions|*.fish
copy|.config/foot/tokyo-night.ini|dot_config/foot/create_tokyo-night.ini|-
template|.config/foot/workstation.ini|dot_config/foot/create_workstation.ini.tmpl|-
copy|.config/herdr/config.toml|dot_config/herdr/create_config.toml|-
template|.config/niri/local.kdl|dot_config/niri/create_local.kdl.tmpl|-
template|.config/starship.toml|dot_config/create_starship.toml.tmpl|-
copy|.config/lazygit/config.yml|dot_config/lazygit/create_config.yml|-
copy|.config/lazydocker/config.yml|dot_config/lazydocker/create_config.yml|-
copy|.config/btop/btop.conf|dot_config/btop/create_btop.conf|-
copy|.config/fontconfig/fonts.conf|dot_config/fontconfig/create_fonts.conf|-
copy|.config/fcitx5/config|dot_config/fcitx5/create_config|-
copy|.config/fcitx5/profile|dot_config/fcitx5/create_profile|-
copy|.config/fcitx5/conf/unicode.conf|dot_config/fcitx5/conf/create_unicode.conf|-
copy|.config/DankMaterialShell/clsettings.json|dot_config/DankMaterialShell/create_clsettings.json|-
copy|.config/DankMaterialShell/themes/tokyoNightDark/theme.json|dot_config/DankMaterialShell/themes/tokyoNightDark/create_theme.json|-
copy|.config/homebrew/Brewfile|dot_config/homebrew/create_Brewfile|-
copy|.config/mimeapps.list|dot_config/create_mimeapps.list|-
copy|.local/share/flatpak/overrides/com.onepassword.OnePassword|private_dot_local/share/flatpak/overrides/create_com.onepassword.OnePassword|-
# DankCalendar follows the DankMaterialShell palette by live-watching
# ~/.cache/DankMaterialShell/dms-colors.json, and already resolves the host path
# inside a sandbox. Its Flathub manifest grants no filesystem access at all, so
# without this read-only grant the calendar renders in its stock palette.
copy|.local/share/flatpak/overrides/com.danklinux.dankcalendar|private_dot_local/share/flatpak/overrides/create_com.danklinux.dankcalendar|-
# XDG autostart entry the Background portal writes when DankCalendar's "start at
# login" is granted (Settings, or 'dcal ipc system.autostart.set enabled=true').
# Machine-neutral, so a new machine gets the calendar daemon and its tray icon at
# login without repeating the grant. The app's own toggle reads a marker inside
# its sandbox, so Settings still shows "off" there until it is toggled once.
copy|.config/autostart/com.danklinux.dankcalendar.desktop|dot_config/autostart/create_com.danklinux.dankcalendar.desktop|-
copy|.var/app/md.obsidian.Obsidian/config/obsidian/user-flags.conf|dot_var/app/md.obsidian.Obsidian/config/obsidian/create_user-flags.conf|-
copy|.local/bin/workstation-dev|private_dot_local/bin/create_executable_workstation-dev|-
copy|.local/bin/workstation-dictate|private_dot_local/bin/create_executable_workstation-dictate|-
copy|.local/bin/workstation-openai-key|private_dot_local/bin/create_executable_workstation-openai-key|-
copy|.local/bin/workstation-cycle-keyboard-layout|private_dot_local/bin/create_executable_workstation-cycle-keyboard-layout|-
copy|.local/bin/workstation-worktree-sync|private_dot_local/bin/create_executable_workstation-worktree-sync|-
copy|.config/nvim/init.lua|dot_config/nvim/create_init.lua|-
copy|.config/nvim/lazy-lock.json|dot_config/nvim/create_lazy-lock.json|-
copy|.config/nvim/lazyvim.json|dot_config/nvim/create_lazyvim.json|-
copy|.config/nvim/stylua.toml|dot_config/nvim/create_stylua.toml|-
tree|.config/nvim/lua|dot_config/nvim/lua|*
# IdeaVim gives the JetBrains IDEs the same Vim/LazyVim bindings as nvim. Lives
# at ~/.ideavimrc, not under XDG: IdeaVim resolves the first existing rc and
# creates ~/.ideavimrc itself, which would shadow an XDG one. It cannot live in
# config/jetbrains-settings/ — that tree is an allowlist enforced by
# tooling/validate-jetbrains-settings.
copy|.ideavimrc|create_dot_ideavimrc|-
copy|.var/app/io.typora.Typora/config/Typora/themes/ia_typora.css|dot_var/app/io.typora.Typora/config/Typora/themes/create_ia_typora.css|-
copy|.var/app/io.typora.Typora/config/Typora/themes/ia_typora_night.css|dot_var/app/io.typora.Typora/config/Typora/themes/create_ia_typora_night.css|-
# jetbrains-app|version-globbed live product dir|product subdir|-
# Captures each IDE's product-specific remainder into config/jetbrains-settings/
# <Product>/ (version-normalised, outside the chezmoi seed tree, never deployed).
# The shared "feel the same" subset is maintained once in _shared/ via
# 'just jetbrains-promote' and written into the IDEs by 'just jetbrains-apply'.
# The first listed product is the canonical source for _shared/. See AGENTS.md.
jetbrains-app|.config/JetBrains/PhpStorm*|PhpStorm|-
jetbrains-app|.config/JetBrains/WebStorm*|WebStorm|-
jetbrains-app|.config/JetBrains/DataGrip*|DataGrip|-
jetbrains-app|.config/JetBrains/IntelliJIdea*|IntelliJIdea|-
jetbrains-app|.config/JetBrains/PyCharm*|PyCharm|-
