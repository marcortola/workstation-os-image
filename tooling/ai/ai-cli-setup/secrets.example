# Secrets for the codex / claude / opencode setup.
# NONE of these values live in git. The shipped config is secret-free by
# construction; supply the values locally after running ./install.sh.

# --- Tool auth: use each CLI's own login, nothing to store here ---
#   codex:    codex login
#   claude:   run `claude`, then /login
#   opencode: opencode auth login   (pick your provider/subscription)

# --- opencode Context7 MCP key ---
# opencode.json references it as {file:~/.config/opencode/context7-key}.
# Create that file (user-only perms):
#   printf %s 'ctx7sk-...' > ~/.config/opencode/context7-key
#   chmod 600 ~/.config/opencode/context7-key
CONTEXT7_API_KEY=

# --- Help Scout MCP credentials (Codex + opencode) ---
# Store values in local files referenced by the clients; never add them here:
#   printf %s 'your-app-id' > ~/.config/opencode/helpscout-app-id
#   printf %s 'your-app-secret' > ~/.config/opencode/helpscout-app-secret
#   chmod 600 ~/.config/opencode/helpscout-app-id \
#     ~/.config/opencode/helpscout-app-secret
HELPSCOUT_APP_ID=
HELPSCOUT_APP_SECRET=
