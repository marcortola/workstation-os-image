#!/usr/bin/env bash
# Install the third-party AI CLI tools via their OFFICIAL installers, idempotently.
# Run once after deploy, like `just brew-apply` -- this is a manual apply step, not
# an auto-updater. chezmoi deploys your personal config; this only installs and
# wires the tools themselves (caveman, rtk, opencode-fusion, playwright-cli), so
# none of their files are vendored into this repo.
#
# Prereqs: node >= 20.12, npm, npx; rtk from the Brewfile (`just brew-apply`).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

have() { command -v "$1" >/dev/null 2>&1; }

step() { printf '\n== %s ==\n' "$1"; }

# The tool installers (skills.sh, npm) drop files in the CWD; run from $HOME so
# they never land in a repo. Config/fragment paths above are already absolute.
cd "$HOME"

# Offer to run a CLI's login flow: skip if already authenticated, guide instead
# of launching when there is no TTY, and ask before opening a browser flow.
login_offer() {
    local name=$1 auth=$2; shift 2   # remaining args = the login command
    if [[ -s $auth ]]; then
        echo "  $name: already logged in"
    elif [[ ! -t 0 ]]; then
        echo "  $name: not logged in -- run: $*"
    else
        read -r -p "  Log in to $name now? [Y/n] " reply
        case "${reply:-y}" in
            [Nn]*) echo "  $name: skipped -- run \`$*\` later" ;;
            *) "$@" || echo "  $name: login did not complete -- run \`$*\` later" ;;
        esac
    fi
}

# --- rtk: bash-output compressor (binary from the Brewfile) --------------------
step "rtk"
if have rtk; then
    rtk init -g --auto-patch   # Claude Code PreToolUse hook + RTK.md + @RTK.md
    rtk init -g --opencode     # opencode plugin (~/.config/opencode/plugins/rtk.ts)
    rtk init -g --codex        # codex ~/.codex/RTK.md + AGENTS.md reference
    # rtk writes an absolute @/home/.../RTK.md ref for codex; normalise it to a
    # relative @RTK.md so it matches the captured seed (no spurious drift) and the
    # Claude side.
    sed -i "s#^@$HOME/.codex/RTK.md\$#@RTK.md#" "$HOME/.codex/AGENTS.md" 2>/dev/null || true
else
    echo "rtk not found; run 'just brew-apply' first (Brewfile ships brew \"rtk\")." >&2
fi

# --- caveman: ~65% output-token reduction skills ------------------------------
step "caveman"
npx -y skills add JuliusBrussee/caveman -a claude-code -a codex -a opencode -y

# --- opencode-fusion: main/sidekick agent team --------------------------------
step "opencode-fusion"
npx -y skills add mihneaptu/opencode-fusion --skill fusion-setup -g -a opencode -y
fusion_installer="$HOME/.agents/skills/fusion-setup/scripts/install.js"
if [[ -f $fusion_installer ]]; then
    # opencode-go profile + our context7 MCP fragment (secret-free {file:} key).
    # --adopt-config makes re-runs idempotent: it accepts an opencode.json edited
    # since the last install (or created by chezmoi) as the baseline, still
    # merging the fragment. Harmless on a first install.
    node "$fusion_installer" apply \
        --profile opencode-go \
        --config "$repo_root/config/ai-tools/opencode-mcp-fragment.json" \
        --extras commands,plugin \
        --adopt-config
else
    echo "fusion installer missing after skills add; check the network/install." >&2
fi

# --- playwright-cli: token-lean browser automation ----------------------------
# The image already ships the binary as the Flatpak-over-CDP wrapper
# (/usr/bin/playwright-cli + workstation-playwright-chrome), so we do NOT install
# the CLI here (`npm install -g` also fails on brew-managed node, whose global
# dir is not user-writable). We only place the skill that ships inside the
# package, sourced from the npx cache -- no global install, no chromium download.
step "playwright-cli"
npx -y @playwright/cli@latest --version >/dev/null 2>&1 || true
pw_skill="$(find "$HOME/.npm/_npx" -path '*cli-client/skill' -type d 2>/dev/null | head -1)"
if [[ -n ${pw_skill:-} && -d $pw_skill ]]; then
    for agent in claude codex; do
        rm -rf "$HOME/.$agent/skills/playwright-cli"
        cp -rL "$pw_skill" "$HOME/.$agent/skills/playwright-cli"
    done
    echo "  placed playwright-cli skill (binary is the image wrapper)"
else
    echo "  could not locate the playwright-cli skill from the npx cache." >&2
fi

# --- Provider logins ----------------------------------------------------------
# All three have a clean CLI login + an auth file to detect it, so orchestrate
# them here. Each opens a browser OAuth flow when accepted.
step "logins"
login_offer codex "$HOME/.codex/auth.json" codex login
login_offer claude "$HOME/.claude/.credentials.json" claude auth login
login_offer opencode "$HOME/.local/share/opencode/auth.json" opencode auth login

# --- Context7 MCP key (opencode) ----------------------------------------------
# opencode.json references {file:~/.config/opencode/context7-key}. Ask for it
# interactively (hidden input) when we have a terminal and it is not already set;
# otherwise print how to set it. Never echoes or logs the key.
step "context7 key"
ctx7_file="$HOME/.config/opencode/context7-key"
if [[ -s $ctx7_file ]]; then
    echo "  already set (~/.config/opencode/context7-key) -- delete it to re-enter"
elif [[ -t 0 ]]; then
    read -r -s -p "  Context7 API key (Enter to skip): " ctx7_key
    printf '\n'
    if [[ -n $ctx7_key ]]; then
        install -d -m 0700 "$(dirname "$ctx7_file")"
        (umask 077; printf '%s\n' "$ctx7_key" > "$ctx7_file")
        echo "  saved to ~/.config/opencode/context7-key (0600)"
    else
        echo "  skipped"
    fi
else
    echo "  non-interactive; set later: printf %s KEY > $ctx7_file && chmod 600 it"
fi

printf '\nDone. Restart each CLI so it reloads config.\n'
