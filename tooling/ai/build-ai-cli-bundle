#!/usr/bin/env bash
# Generate the portable tooling/ai/ai-cli-setup/ config tree from the repository seeds
# so the standalone installer stays a projection of the one canonical source
# (the create_ seeds inventoried by config/dotfiles.manifest). Only config/ and
# the opencode mcp fragment are generated here; install.sh, reset.sh, README.md,
# secrets.example and vendor/ are committed artifacts this script never touches.
#
# With --check it regenerates into a temp tree and diffs against the committed
# bundle instead of writing, so validate can assert the bundle is in sync.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=tooling/lib/dotfiles.sh
source "$repo_root/tooling/lib/dotfiles.sh"

manifest="$repo_root/config/dotfiles.manifest"
seed_root="$repo_root/rootfs/usr/share/workstation-os-image/dotfiles"
bundle="$repo_root/tooling/ai/ai-cli-setup"

check=false
[[ ${1:-} == --check ]] && check=true

if $check; then
    work="$(mktemp -d)"
    trap 'rm -rf -- "$work"' EXIT
    config_out="$work/config"
    fragment_out="$work/opencode-mcp-fragment.json"
else
    config_out="$bundle/config"
    fragment_out="$bundle/opencode-mcp-fragment.json"
fi

tool_of() {
    case "$1" in
        .codex/*) printf 'codex' ;;
        .claude/*) printf 'claude' ;;
        .config/opencode/*) printf 'opencode' ;;
        *) return 1 ;;
    esac
}
rest_of() {
    case "$1" in
        .codex/*) printf '%s' "${1#.codex/}" ;;
        .claude/*) printf '%s' "${1#.claude/}" ;;
        .config/opencode/*) printf '%s' "${1#.config/opencode/}" ;;
    esac
}

emit() {
    local live_rel=$1 seed=$2 tool rest
    tool="$(tool_of "$live_rel")" || return 0
    rest="$(rest_of "$live_rel")"
    install -D -m 0644 "$seed" "$config_out/$tool/$rest"
}

rm -rf -- "$config_out"
while IFS='|' read -r kind live_path source_path _; do
    [[ -z $kind || $kind == \#* ]] && continue
    tool_of "$live_path" >/dev/null 2>&1 || continue
    case "$kind" in
        copy | scrub)
            emit "$live_path" "$seed_root/$source_path"
            ;;
        tree | directory)
            seed_dir="$seed_root/$source_path"
            [[ -d $seed_dir ]] || continue
            maxdepth=()
            [[ $kind == directory ]] && maxdepth=(-maxdepth 1)
            while IFS= read -r -d '' seed; do
                seedrel="${seed#"$seed_dir/"}"
                liverel="$live_path/$(workstation_live_relative "$seedrel")"
                emit "$liverel" "$seed"
            done < <(find "$seed_dir" "${maxdepth[@]}" -type f \
                -name 'create_*' -print0 | sort -z)
            ;;
        template | jetbrains-app) : ;;
        *) echo "bundle does not handle manifest kind: $kind" >&2; exit 2 ;;
    esac
done < "$manifest"

# Ship the tracked context7 mcp fragment so install.sh can pass it to the fusion
# installer (opencode.json is generated by fusion, not vendored).
install -D -m 0644 "$repo_root/config/ai-tools/opencode-mcp-fragment.json" \
    "$fragment_out"

if $check; then
    if ! diff -rq "$config_out" "$bundle/config" \
        || ! diff -q "$fragment_out" "$bundle/opencode-mcp-fragment.json"; then
        echo "tooling/ai/ai-cli-setup is stale: run 'just ai-bundle' and commit." >&2
        exit 1
    fi
    echo "tooling/ai/ai-cli-setup is in sync with the seeds."
else
    echo "Regenerated $config_out and opencode-mcp-fragment.json from seeds."
fi
