#!/usr/bin/env bash
set -euo pipefail

spec=${DMS_SETTINGS_SPEC:-/usr/share/quickshell/dms/Common/settings/SettingsSpec.js}
node=${NODE:-$(command -v node || true)}

[[ -r $spec ]] || {
    echo "DMS settings schema is unavailable: $spec" >&2
    exit 2
}
[[ -n $node ]] || {
    echo "Node.js is required to inspect the installed DMS settings schema." >&2
    exit 2
}

"$node" - "$spec" <<'NODE'
const fs = require("fs");
const nodePath = require("path");
const vm = require("vm");

// A QML JS resource is not JavaScript: it opens with directives node cannot
// parse -- `.pragma library`, and since DMS 1.6.0 also
// `.import "./SpecUtil.js" as Util`. Resolve each imported resource into its
// alias first, then blank every directive line (blank, not delete, so stack
// traces keep their line numbers) and evaluate the resource itself.
const IMPORT = /^\s*\.import\s+"([^"]+)"\s+as\s+([A-Za-z_$][\w$]*)\s*;?\s*$/;
const DIRECTIVE = /^\s*\.(?:pragma|import)\b/;
const loaded = new Map();

function evaluate(file) {
  const resolved = nodePath.resolve(file);
  if (loaded.has(resolved)) return loaded.get(resolved);
  const scope = {};
  loaded.set(resolved, scope);
  const lines = fs.readFileSync(resolved, "utf8").split("\n");
  for (const line of lines) {
    const match = IMPORT.exec(line);
    if (match) scope[match[2]] = evaluate(nodePath.resolve(nodePath.dirname(resolved), match[1]));
  }
  const source = lines.map((l) => (DIRECTIVE.test(l) ? "" : l)).join("\n");
  vm.runInNewContext(source, scope, { filename: resolved });
  return scope;
}

// Assert coverage, not success: a spec that evaluated to nothing must fail
// loudly here rather than emit an empty object every caller then reads as
// "this key is not in the schema".
const specPath = process.argv[2];
const SPEC = evaluate(specPath).SPEC;
if (!SPEC || typeof SPEC !== "object" || Object.keys(SPEC).length === 0) {
  throw new Error(`No usable SPEC object in ${specPath}`);
}

const defaults = {};
for (const [key, entry] of Object.entries(SPEC)) {
  if (entry.persist === false) continue;
  if (!("def" in entry)) throw new Error(`SPEC key without a default in ${specPath}: ${key}`);
  defaults[key] = entry.def;
}
process.stdout.write(`${JSON.stringify(defaults, null, 2)}\n`);
NODE
