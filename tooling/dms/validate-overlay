#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
overlay=${DMS_SETTINGS_OVERLAY:-$repo_root/system_files/usr/share/workstation-os-image/dms-settings.json}

[[ -r $overlay ]] || {
    echo "DMS settings overlay is missing: $overlay" >&2
    exit 2
}

workdir="$(mktemp -d)"
trap 'rm -rf -- "$workdir"' EXIT
"$repo_root/tooling/dms/defaults" > "$workdir/defaults.json"

jq -e 'type == "object" and (has("configVersion") | not)' "$overlay" >/dev/null
jq -e --slurpfile defaults "$workdir/defaults.json" '
    keys | all(. as $key | $defaults[0] | has($key))
' "$overlay" >/dev/null
jq -e --slurpfile defaults "$workdir/defaults.json" '
    def valid_widgets:
      type == "array" and all(
        type == "string"
        or (type == "object"
          and (.id | type == "string" and length > 0)
          and ((.enabled // true) | type == "boolean")
          and (keys | all(. == "id" or . == "enabled"
              or . == "minimumWidth" or . == "showInGb"))
          and ((has("minimumWidth") | not) or (.minimumWidth | type == "boolean"))
          and ((has("showInGb") | not) or (.showInGb | type == "boolean")))
      );
    (.barConfigs // []) as $bars
    | ($defaults[0].barConfigs[0]) as $template
    | ["shadowDirection", "shadowDirectionMode"] as $extra_fields
    | ($bars | type == "array")
      and ($bars | all(.id
        | type == "string"
          and test("^[A-Za-z0-9_-]+$")
          and length > 0))
      and (($bars | map(.id) | unique | length) == ($bars | length))
      and ($bars | all(
        . as $bar
        | ($defaults[0].barConfigs | map(select(.id == $bar.id)) | first) as $default
        | ($bar | to_entries | all(. as $entry
            | if $entry.key == "id" then true
            elif ($template | has($entry.key)) then
              ($entry.value | type) == ($template[$entry.key] | type)
            elif ($extra_fields | index($entry.key)) != null then
              ($entry.value | type) == "string"
            else false
            end
          ))
          and (if $default != null then true
            else ($bar
              | has("name") and (.name | type == "string" and length > 0)
              and has("enabled") and (.enabled | type == "boolean")
              and has("position")
              and (.position | type == "number" and floor == . and . >= 0 and . <= 3)
              and has("leftWidgets") and (.leftWidgets | valid_widgets)
              and has("centerWidgets") and (.centerWidgets | valid_widgets)
              and has("rightWidgets") and (.rightWidgets | valid_widgets)
              and (.screenPreferences // ["all"] | type == "array")
              and (.showOnLastDisplay // true | type == "boolean"))
            end)
          and (($bar | has("position") | not)
            or ($bar.position
              | type == "number" and floor == . and . >= 0 and . <= 3))
          and (($bar | has("screenPreferences") | not)
            or $bar.screenPreferences == ["all"])
          and (($bar | has("showOnLastDisplay") | not)
            or $bar.showOnLastDisplay == true)
          and (["leftWidgets", "centerWidgets", "rightWidgets"] | all(
            . as $field
            | ($bar | has($field) | not) or ($bar[$field] | valid_widgets)))
      ))
' "$overlay" >/dev/null

jq -e '
    if has("builtInPluginSettings") then
      .builtInPluginSettings as $plugins
      | ($plugins | type == "object")
        and ($plugins | keys | all(
          . == "dms_clipboard_search" or . == "dms_settings_search"))
        and ($plugins | to_entries | all(
          (.value | type == "object")
          and (.value | keys | all(. == "trigger"))
          and (.value.trigger | type == "string" and length > 0)))
    else true end
' "$overlay" >/dev/null

# --- customThemeFile stays home-relative ---------------------------------
# It came off the denylist because it is templated, not because it is
# inherently safe: `${HOME}/...` is portable, `/var/home/marc/...` is a username
# baked into a public repository. Nothing enforced the template, so enforce it
# here rather than trusting whoever runs the capture next.
jq -e '
    if has("customThemeFile") then
      .customThemeFile | type == "string" and startswith("${HOME}/")
    else true end
' "$overlay" >/dev/null || {
    echo "customThemeFile must be \${HOME}-relative, not an absolute path" >&2
    exit 1
}

# --- the denylist is policy; enforce it ----------------------------------
# Nothing checked this before, which is how two stale entries survived.
#
# barConfigs is exempt at the top level ON PURPOSE: tooling/dms/capture
# explodes it into dotted sub-keys (barConfigs.<id>.<key>) and the device-bound
# ones -- screenPreferences, showOnLastDisplay -- are denylisted separately.
# So the meaningful assertion is that no denylisted key appears INSIDE a bar
# config, and that no other denylisted key appears at the top level.
#
# screenPreferences and showOnLastDisplay are exempt INSIDE barConfigs: the
# shape validation above already permits them only at their portable values
# (["all"] and true). Rejecting them here as well would make two validators in
# the same file disagree about the same key.
denylist=${DMS_SETTINGS_DENYLIST:-$repo_root/tooling/data/dms-settings-denylist}
[[ -r $denylist ]] || { echo "DMS denylist is missing: $denylist" >&2; exit 2; }

sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$denylist" \
    | jq -Rsc 'split("\n") | map(select(length > 0))' > "$workdir/denied.json"

if ! jq -e --slurpfile denied "$workdir/denied.json" '
    ($denied[0] - ["barConfigs"]) as $d
    | ($d - ["screenPreferences", "showOnLastDisplay"]) as $bd
    | (keys | map(select(. as $k | $d | index($k))) | length == 0)
      and ((.barConfigs // [])
        | all(keys | map(select(. as $k | $bd | index($k))) | length == 0))
' "$overlay" >/dev/null; then
    echo "Denylisted DMS keys captured into the overlay:" >&2
    jq -r --slurpfile denied "$workdir/denied.json" '
        ($denied[0] - ["barConfigs"]) as $d
        | ($d - ["screenPreferences", "showOnLastDisplay"]) as $bd
        | (keys | map(select(. as $k | $d | index($k))) | .[] | "  \(.)"),
          ((.barConfigs // [])[] | .id as $id | keys
            | map(select(. as $k | $bd | index($k))) | .[] | "  barConfigs.\($id).\(.)")
    ' "$overlay" >&2
    echo "Either drop them from the overlay, or -- if they are genuinely" >&2
    echo "portable -- remove them from $denylist with a note saying why." >&2
    exit 1
fi
