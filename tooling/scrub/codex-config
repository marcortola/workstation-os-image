#!/usr/bin/env bash
# Curate a Codex config.toml for capture: keep the portable top-level defaults,
# replace every table with canonical, secret-free MCP tables.
# Machine-local [projects.*] trust tables, [tui.*] NUX state, and unapproved MCP
# tables must never land in git.
# Reads the live config on stdin, writes the secret-free seed to stdout.
set -euo pipefail

# The Help Scout launcher reads credentials from local 0600 files; OpenAI's
# official developer-docs MCP needs no credentials. Keeping both tables
# canonical instead of copying live blocks prevents env or inline secrets from
# entering the seed. Reset re-adds only live trust/NUX tables.
awk '
    /^\[/  { stop = 1 }
    !stop  { lines[n++] = $0 }
    END {
        end = n
        while (end > 0 && lines[end - 1] ~ /^[[:space:]]*$/) end--
        for (i = 0; i < end; i++) print lines[i]
        print ""
        print "[mcp_servers.helpscout]"
        print "command = \"bash\""
        print "args = [\"-c\", \"exec bash \\\"$HOME/.codex/bin/helpscout-mcp\\\"\"]"
        print "startup_timeout_sec = 30"
        print ""
        print "[mcp_servers.openaiDeveloperDocs]"
        print "url = \"https://developers.openai.com/mcp\""
    }
'
