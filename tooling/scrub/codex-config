#!/usr/bin/env bash
# Curate a Codex config.toml for capture: keep the portable top-level defaults,
# drop machine-local [projects.*] trust tables and [tui.*] NUX state (absolute
# home paths + per-machine UI counters that must never land in git).
# Reads the live config on stdin, writes the secret-free seed to stdout.
set -euo pipefail

# Portable codex config is the top-level key block only; every [table]
# (projects trust, tui nux, and any future machine/runtime table such as
# mcp_servers/history) is machine state and is dropped. Keeping the seed
# table-free means no table can ever smuggle a value into git, and capture
# stays symmetric with the reset merge, which re-adds only the trust/nux tables.
awk '
    /^\[/  { stop = 1 }
    !stop  { lines[n++] = $0 }
    END {
        end = n
        while (end > 0 && lines[end - 1] ~ /^[[:space:]]*$/) end--
        for (i = 0; i < end; i++) print lines[i]
    }
'
