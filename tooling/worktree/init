#!/usr/bin/env bash
# worktree-init — make git-worktree file propagation work in a repository:
#   1. install the post-checkout hook into .git/hooks so worktrees created by
#      any `git worktree add` — herdr shells out to it — copy their untracked
#      files, and
#   2. drop a starter .worktreeinclude when the repo has none, so all three
#      creation paths (herdr, an agent recipe, the hook) have an inventory to
#      read.
#
# init.templateDir already seeds the hook into freshly cloned repos; this is the
# retrofit for repos that already exist, and the bulk bootstrap for every repo
# under the projects root.
#
# Usage:
#   tooling/worktree/init                 # the current repo (cwd)
#   tooling/worktree/init PATH [PATH...]  # specific repos
#   tooling/worktree/init --all           # every repo under WORKSTATION_PROJECTS_ROOT
#
# Idempotent and non-destructive: it never overwrites an existing
# .worktreeinclude, and never replaces an unmanaged or locally modified hook. It
# does replace an OLDER version of its own hook, which is the only way an edit to
# the hook ever reaches a repository that already carries one. The one hook it
# replaces without a version to compare against -- the pre-sentinel shape,
# recognised by its delegate loop verbatim -- is backed up beside itself first.
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/../.." && pwd)"
hook_seed="$repo_root/system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/template/hooks/create_executable_post-checkout"
hook_live="${XDG_CONFIG_HOME:-$HOME/.config}/git/template/hooks/post-checkout"
projects_root="${WORKSTATION_PROJECTS_ROOT:-$HOME/projects}"

# The hook carries a version in its ownership sentinel, and that version is the
# only thing that lets an edit to the hook reach a repository that already has
# one. Without it every existing repository fell through to the "a different
# hook" skip -- 27 of the 30 repositories on this machine still held the
# pre-sentinel hook, so `--all` updated none of them and the managed hook was
# frozen at whatever each clone got from init.templateDir.
managed_sentinel_re='^# workstation-worktree-init: managed post-checkout hook v(0|[1-9][0-9]*)$'

# The delegate loop is the one line only this hook has. A third party's hook that
# merely names the helper -- in a comment, or because it calls it too -- does not
# match it verbatim, and that is what keeps the pre-sentinel adoption below from
# overwriting somebody else's work.
# The single quotes are the point: this is the literal text to match in a file,
# not something to expand here.
# shellcheck disable=SC2016
managed_delegate_line='for cand in workstation-worktree-sync "$HOME/.local/bin/workstation-worktree-sync"; do'

if [[ -r $hook_seed ]]; then
    hook_src="$hook_seed"
elif [[ -r $hook_live ]]; then
    hook_src="$hook_live"
else
    echo "worktree-init: cannot find the post-checkout hook source" >&2
    exit 1
fi

# Prints the version in the hook's ownership sentinel, or nothing when there is
# none. Deliberately strict, with no fallback: the SEED is read through this, and
# the seed names the delegate too, so a fallback would let a sentinel broken by a
# stray space or a CRLF read as version 0 -- which makes every installed hook look
# current and freezes all of them while reporting success.
sentinel_version() {
    local file="$1" line
    [[ -r $file ]] || return 1
    while IFS= read -r line; do
        if [[ $line =~ $managed_sentinel_re ]]; then
            printf '%s\n' "${BASH_REMATCH[1]}"
            return 0
        fi
    done <"$file"
    return 1
}

# Prints the managed version of an INSTALLED hook, or nothing when it is not ours.
# A hook with no sentinel that still carries the delegate loop verbatim is the
# shape this script installed before the sentinel existed, so it reads as 0 and
# upgrades. Anything else belongs to a third party and is never touched.
installed_version() {
    local file="$1"
    sentinel_version "$file" && return 0
    [[ -r $file ]] || return 1
    grep -Fqx "$managed_delegate_line" "$file" || return 1
    printf '0\n'
}

if ! seed_version="$(sentinel_version "$hook_src")"; then
    echo "worktree-init: the hook source carries no ownership sentinel: $hook_src" >&2
    exit 1
fi

install_hook() {
    local repo="$1" common dest dest_version
    if ! common="$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null)"; then
        echo "  hook: failed to resolve the common Git directory" >&2
        return 1
    fi
    case "$common" in
        /*) : ;;
        *) common="$repo/$common" ;;
    esac
    dest="$common/hooks/post-checkout"
    if [[ -e $dest ]]; then
        if cmp -s "$hook_src" "$dest"; then
            echo "  hook: current"
            return 0
        fi
        if ! dest_version="$(installed_version "$dest")"; then
            echo "  hook: skip (a different post-checkout hook is already installed)"
            return 0
        fi
        # Ahead of the seed: an older image, or a rolled-back seed. Never
        # downgrade, and do not call it a local edit -- that reading would send
        # someone hunting for a change nobody made.
        if (( 10#$dest_version > 10#$seed_version )); then
            echo "  hook: skip (installed hook is newer: v$dest_version > v$seed_version)"
            return 0
        fi
        # Same version, different bytes: something composed onto the hook after
        # we installed it, and that edit outranks a reinstall of identical
        # content. Only an older version is replaced.
        if (( 10#$dest_version == 10#$seed_version )); then
            echo "  hook: skip (managed hook has local changes)"
            return 0
        fi
        # A pre-sentinel hook carries no version to compare against, so anything
        # composed onto it is indistinguishable from the original and would be
        # lost here. Keep a copy rather than guess. Versioned upgrades need no
        # backup: same version plus different bytes is caught above.
        if (( 10#$dest_version == 0 )) && ! cp -p "$dest" "$dest.pre-v$seed_version.bak"; then
            echo "  hook: failed to back up $dest" >&2
            return 1
        fi
        if ! install -m 0755 "$hook_src" "$dest"; then
            echo "  hook: failed to install $dest" >&2
            return 1
        fi
        echo "  hook: upgraded (v$dest_version -> v$seed_version)"
        return 0
    fi
    if ! mkdir -p "$common/hooks"; then
        echo "  hook: failed to create $common/hooks" >&2
        return 1
    fi
    if ! install -m 0755 "$hook_src" "$dest"; then
        echo "  hook: failed to install $dest" >&2
        return 1
    fi
    echo "  hook: installed"
}

generate_worktreeinclude() {
    local repo="$1" file="$1/.worktreeinclude"
    if [[ -e $file ]]; then
        echo "  wti:  skip (already present)"
        return 0
    fi
    if {
        echo "# Untracked files to copy into new git worktrees (gitignore syntax)."
        echo "# Only files git IGNORES and that match here are copied; tracked files"
        echo "# never are. Read by Claude Code, herdr and the post-checkout hook."
        echo "# Commit to share with the team."
        echo "# node_modules/vendor/.venv belong in a per-project install step, not"
        echo "# here — copying them per worktree is the wrong tool."
        echo
        echo ".env"
        echo ".env.local"
        echo ".env.*.local"
        echo ".idea/"
        echo ".vscode/"
        echo ".claude/settings.local.json"
        if compgen -G "$repo/*.tf" >/dev/null 2>&1 || [[ -d $repo/terraform ]]; then
            echo "*.tfvars"
            echo "*.tfvars.json"
        fi
    } >"$file"; then
        echo "  wti:  generated"
        return 0
    fi
    echo "  wti:  failed to generate $file" >&2
    return 1
}

primary_worktree() {
    local repo="$1" record
    # The first porcelain record is Git's primary/source worktree. Use NUL
    # delimiters so spaces and other quoted path characters remain literal.
    if ! IFS= read -r -d '' record < <(
        git -C "$repo" worktree list --porcelain -z 2>/dev/null
    ); then
        echo "worktree-init: cannot resolve the primary worktree for $repo" >&2
        return 1
    fi
    if [[ $record != 'worktree '* ]]; then
        echo "worktree-init: invalid worktree metadata for $repo" >&2
        return 1
    fi
    printf '%s\n' "${record#worktree }"
}

process() {
    local repo="$1" primary status=0
    if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "skip (not a git work tree): $repo"
        return 0
    fi
    if ! repo="$(git -C "$repo" rev-parse --show-toplevel)"; then
        echo "worktree-init: cannot resolve the worktree root for $repo" >&2
        return 1
    fi
    primary="$(primary_worktree "$repo")" || return 1
    echo "$primary"
    install_hook "$primary" || status=1
    generate_worktreeinclude "$primary" || status=1
    return "$status"
}

targets=()
if [[ ${1:-} == --all ]]; then
    while IFS= read -r gitdir; do
        targets+=("${gitdir%/.git}")
    done < <(find "$projects_root" -maxdepth 4 -type d -name .git \
        -not -path '*/node_modules/*' -not -path '*__worktrees*' \
        -not -path '*/vendor/*' 2>/dev/null | sort)
elif [[ $# -gt 0 ]]; then
    targets=("$@")
else
    targets=(".")
fi

if [[ ${#targets[@]} -eq 0 ]]; then
    echo "worktree-init: no git repositories found under $projects_root" >&2
    exit 0
fi

status=0
for repo in "${targets[@]}"; do
    process "$repo" || status=1
done
exit "$status"
