#!/usr/bin/env bash
# Prove the chezmoi state migration is safe BEFORE rebooting into the new image.
#
# Run this while still on the old image. It compares three chezmoi dry runs:
#
#   CONTROL   old source + old config   -- what today's unit actually does
#   CANDIDATE new source + MIGRATED state -- what the cutover will do
#   NEGATIVE  new source + EMPTY state    -- what happens if the state is lost
#
# CANDIDATE may rewrite ONLY the files the manifest marks `scaffold`. Those are
# image-owned and replacing them is the point. Anything else being rewritten is
# a migration failure.
#
# NEGATIVE must be LOUD: without it a bug that makes --dry-run silently no-op
# would let the other assertions pass vacuously.
#
# Why this matters: chezmoi's `yes s` answers "skip" to the "changed since
# chezmoi last wrote it" prompt. That prompt only fires when the state
# database has a recorded hash. With an empty state no prompt fires at all and
# chezmoi silently rewrites every managed target.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

old_src=${WORKSTATION_OLD_CHEZMOI_SOURCE:-/usr/share/zirconium/zdots}
old_cfg_dir=${WORKSTATION_OLD_CHEZMOI_CONFIG:-$HOME/.config/zirconium/chezmoi}
old_cfg="$old_cfg_dir/chezmoi.toml"
old_state="$old_cfg_dir/chezmoistate.boltdb"
new_src="$repo_root/system_files/usr/share/workstation-os-image/dotfiles"

for required in "$old_src" "$old_cfg" "$old_state" "$new_src"; do
    [[ -e $required ]] || {
        echo "preflight: missing $required" >&2
        echo "Run this on the machine still booted into the old image." >&2
        exit 2
    }
done

command -v chezmoi >/dev/null || { echo "preflight: chezmoi not on PATH" >&2; exit 2; }

work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT

run() { # run <config> <source> <outfile>
    yes s | chezmoi apply --dry-run --verbose --no-tty --keep-going \
        -S "$2" --config "$1" > "$3" 2>&1 || true
}

run "$old_cfg" "$old_src" "$work/control.txt"

mkdir -p "$work/migrated"
install -m 0600 "$old_state" "$work/migrated/chezmoistate.boltdb"
: > "$work/migrated/chezmoi.toml"
run "$work/migrated/chezmoi.toml" "$new_src" "$work/candidate.txt"

mkdir -p "$work/empty"
: > "$work/empty/chezmoi.toml"
run "$work/empty/chezmoi.toml" "$new_src" "$work/negative.txt"

status=0
hunks() { grep -cE '^[-+]{3} ' "$1" || true; }

# Targets the manifest declares image-owned. Rewriting these is intended.
mapfile -t scaffold < <(awk -F'|' '$1=="scaffold" {print $2}' "$repo_root/tooling/data/dotfiles.manifest")

# Every target the candidate run would rewrite, as $HOME-relative paths.
rewritten() {
    grep -E '^\+\+\+ b/' "$1" | sed 's|^+++ b/||' | sort -u
}

echo "=== 1. only image-owned scaffold files may be rewritten ==="
unexpected=()
while IFS= read -r t; do
    [[ -z $t ]] && continue
    keep=1
    for s in "${scaffold[@]}"; do [[ "$t" == "$s" ]] && keep=0 && break; done
    [[ $keep -eq 1 ]] && unexpected+=("$t")
done < <(rewritten "$work/candidate.txt")

if [[ ${#unexpected[@]} -gt 0 ]]; then
    echo "FAIL: these are NOT declared scaffold and would be rewritten:" >&2
    printf '    %s\n' "${unexpected[@]}" >&2
    status=1
else
    echo "PASS: only declared scaffold files change:"
    rewritten "$work/candidate.txt" | sed 's/^/    /'
    echo "  Review the diff below before proceeding; these replace what the old base shipped."
    sed -n '/^diff --git/,$p' "$work/candidate.txt" | sed 's/^/  | /'
fi

echo
echo "=== 2. every dropped protection is safe ==="
# CONTROL's prompts are the live-modified files chezmoi skips today. Some no
# longer prompt because we stopped shipping their source (Defence 1), and some
# because the source became create_, which never overwrites an existing file.
# Either is fine. What would NOT be fine is a file losing its prompt and then
# appearing in the rewrite set -- so check exactly that, rather than trying to
# guess source paths from target names.
prompts() { grep -oE '[^ ]+ has changed since chezmoi last wrote it' "$1" \
    | sed 's/ has changed.*//' | sort -u; }
lost=$(comm -23 <(prompts "$work/control.txt") <(prompts "$work/candidate.txt"))
at_risk=""
while IFS= read -r f; do
    [[ -z $f ]] && continue
    if rewritten "$work/candidate.txt" | grep -qxF "$f"; then
        at_risk="$at_risk $f"
    fi
done <<< "$lost"
if [[ -n ${at_risk// /} ]]; then
    echo "FAIL: lost their prompt AND would be rewritten:" >&2
    printf "    %s\n" "$at_risk" >&2
    status=1
else
    n=$(printf '%s\n' "$lost" | grep -c . || true)
    echo "PASS: $n file(s) no longer prompt, and none of them would be rewritten."
    printf '%s\n' "$lost" | grep . | sed 's/^/    /' || true
fi

echo
echo "=== 3. negative control: the harness must be able to detect damage ==="
if [[ "$(hunks "$work/negative.txt")" -eq 0 ]]; then
    echo "FAIL: an EMPTY state produced no changes either." >&2
    echo "The harness is not sensitive; assertions 1 and 2 passed vacuously." >&2
    status=1
elif ! grep -q 'DankMaterialShell' "$work/negative.txt"; then
    echo "FAIL: the empty-state run did not touch the DMS state files." >&2
    echo "Expected it to; the harness may be testing the wrong thing." >&2
    status=1
else
    echo "PASS: an empty state would rewrite these files, and the migration prevents it:"
    grep -E '^[-+]{3} ' "$work/negative.txt" | sed 's/^/    /' | sort -u
fi

echo
entries="$(chezmoi state dump --config "$work/migrated/chezmoi.toml" \
    | python3 -c 'import json,sys; print(len(json.load(sys.stdin).get("entryState") or {}))')"
echo "=== 4. migrated state carries $entries entries ==="
if [[ "$entries" -lt 100 ]]; then
    echo "FAIL: implausibly few entries; the database did not migrate." >&2
    status=1
else
    echo "PASS."
fi

echo
if [[ $status -eq 0 ]]; then
    echo "preflight: SAFE TO PROCEED."
else
    echo "preflight: DO NOT REBOOT. Resolve the failures above first." >&2
fi
exit "$status"
