#!/usr/bin/env bash
# Project the manifest's scaffold entries into the list the image ships.
#
# /usr/libexec/workstation-chezmoi-apply has to know which targets are
# image-owned so it can force them, and it runs on the machine where
# tooling/data/ does not exist -- that directory is repo-owned and never baked.
# So the list is generated here, committed under system_files/, and gated in
# tooling/validate/sources so the two cannot drift.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$repo_root/tooling/data/dotfiles.manifest"
generated="$repo_root/system_files/usr/share/workstation-os-image/scaffold-targets"

check=false
case "${1:-}" in
    --check) check=true ;;
    "") ;;
    *)
        echo "Usage: tooling/dotfiles/scaffold-list [--check]" >&2
        exit 2
        ;;
esac

test -f "$manifest" || {
    echo "gate input is missing: $manifest" >&2
    exit 1
}

render() {
    cat <<'HEADER'
# Image-owned chezmoi targets, relative to $HOME, one per line.
#
# Generated by tooling/dotfiles/scaffold-list from the scaffold entries of
# tooling/data/dotfiles.manifest. Do not hand-edit: run `just sync`.
#
# /usr/libexec/workstation-chezmoi-apply forces these rather than skipping them
# when they have diverged from chezmoi's entry state, because nothing but the
# image is supposed to write them.
HEADER
    while IFS='|' read -r kind live_path _; do
        [[ $kind == scaffold ]] || continue
        printf '%s\n' "$live_path"
    done < "$manifest"
}

# Assert coverage, not success: a manifest that stopped matching would render a
# header and nothing else, and both the writer and the checker would pass.
entries=$(render | grep -cv '^#' || true)
(( entries > 0 )) || {
    echo "no scaffold entries found in $manifest" >&2
    exit 1
}

if [[ $check == true ]]; then
    if ! diff -u "$generated" <(render) >/dev/null 2>&1; then
        echo "$generated is out of date; run 'just sync'" >&2
        diff -u "$generated" <(render) >&2 || true
        exit 1
    fi
    exit 0
fi

render > "$generated"
