#!/usr/bin/env bash
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source_dir=/usr/share/workstation-os-image/dotfiles
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/workstation-os-image/chezmoi/chezmoi.toml"
strict=false
show_details=false
status=0

for argument in "$@"; do
    case "$argument" in
        --strict) strict=true ;;
        --diff) show_details=true ;;
        *)
            echo "Usage: tooling/audit/dotfiles [--strict] [--diff]" >&2
            exit 2
            ;;
    esac
done

for command in chezmoi niri; do
    command -v "$command" >/dev/null || {
        echo "Missing required command: $command" >&2
        exit 2
    }
done

[[ -d $source_dir && -f $config_file ]] || {
    echo "Image chezmoi source or configuration is missing." >&2
    exit 2
}

"$repo_root/tooling/audit/personal-config" || {
    personal_status=$?
    if (( personal_status == 2 )); then
        status=2
    else
        status=1
    fi
}

printf '\nImage-managed configuration drift:\n'

show_diff() {
    local label=$1 severity=$2 output
    shift 2
    if ! output="$(chezmoi diff --no-pager --color=false \
        -S "$source_dir" --config "$config_file" "$@" 2>&1)"; then
        printf '\n%s comparison failed:\n%s\n' "$label" "$output" >&2
        status=2
        return
    fi
    if [[ -n $output ]]; then
        printf '%s differs from the installed image defaults.\n' "$label"
        if [[ $show_details == true ]]; then
            printf '%s\n' "$output"
        else
            echo "  Run 'just audit-diff' for the complete diff."
        fi
        [[ $severity == critical || $strict == true ]] && status=1
    else
        printf '%s matches the installed image defaults.\n' "$label"
    fi
}

# Every scaffold entry, not the two niri files this used to name. Scaffolding is
# image-owned, so any divergence is either a hand edit that will be reverted on
# the next apply or -- the case that went unseen for three days -- a target
# chezmoi has stopped writing at all, frozen at an old version while its
# siblings advance. Both are critical, and neither is visible anywhere else:
# `workstation-chezmoi-apply` reports "Finished" after skipping a target.
manifest="$repo_root/tooling/data/dotfiles.manifest"
scaffold_targets=()
if [[ -f $manifest ]]; then
    while IFS='|' read -r kind live_path _; do
        [[ $kind == scaffold ]] || continue
        scaffold_targets+=("$HOME/$live_path")
    done < "$manifest"
fi
# Assert coverage, not success: a loop fed by a missing or renamed manifest
# iterates zero times, and `chezmoi diff` with no arguments diffs everything.
if (( ${#scaffold_targets[@]} == 0 )); then
    printf 'No scaffold entries found in %s.\n' "$manifest" >&2
    status=2
else
    show_diff "Managed image scaffolding" critical "${scaffold_targets[@]}"
fi
# The DMS-generated niri fragments and settings.json are deliberately NOT
# shipped as chezmoi sources -- DMS regenerates them at runtime, and shipping a
# source for them is what let a lost state database silently rewrite live
# config. There is nothing to diff them against, so they are not compared here;
# the DMS overlay is audited below against the installed schema instead.
show_diff "DMS clipboard preferences" informational \
    "$HOME/.config/DankMaterialShell/clsettings.json"

printf '\nCaptured DMS preference defaults:\n'
"$repo_root/tooling/audit/dms-settings" || {
    dms_status=$?
    (( dms_status > status )) && status=$dms_status
}

printf '\nIntentional Niri overrides:\n'
found=false
for override in /etc/niri/local.kdl "$HOME/.config/niri/local.kdl"; do
    if [[ -f $override ]]; then
        found=true
        printf '  %s  %s\n' "$(sha256sum "$override" | cut -d' ' -f1)" "$override"
    fi
done
[[ $found == true ]] || echo "  none"

printf '\nNiri bind ownership:\n'
"$repo_root/tooling/audit/niri-binds" || {
    binds_status=$?
    (( binds_status > status )) && status=$binds_status
}

printf '\nEffective Niri validation:\n'
if niri validate -c "$HOME/.config/niri/config.kdl"; then
    echo "Niri configuration is valid."
else
    status=1
fi
exit "$status"
