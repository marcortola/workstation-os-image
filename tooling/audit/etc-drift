#!/usr/bin/env bash
# Image-owned /etc files that the machine has diverged from.
#
# /etc is a three-way ostree merge: a file the image ships is applied on first
# deploy, and once anything rewrites it locally, ostree records it as modified
# and every later image version of that file is silently ignored. Nothing else
# in this repository notices -- 99-check-build.sh asserts the image, and the
# image is fine.
#
# Found this way: /etc/greetd/niri/config.kdl had been frozen at its 2026-07-10
# state since `dms greeter install` rewrote it, so a later image that added
# `optional=true` to its dms.kdl include never reached the machine. That file is
# on the path whose failure costs a graphical login.
#
# Scoped to what this repository owns: system_files/etc plus the fragment
# 40-signing.sh generates. Files like passwd, fstab and machine-id are supposed
# to diverge.
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# Overridable so the comparison itself is testable without root.
pristine_root="${WORKSTATION_ETC_PRISTINE:-/usr/etc}"
status=0

echo "Image-owned /etc drift:"

if [[ ! -d $pristine_root ]]; then
    echo "  unavailable outside an ostree host"
    exit 0
fi

owned=()
while IFS= read -r f; do
    owned+=("${f#"$repo_root/system_files"}")
done < <(find "$repo_root/system_files/etc" -type f | sort)
# Generated by build_files/40-signing.sh rather than shipped, but image-owned
# just the same, and the file the machine's signature verification depends on.
owned+=(/etc/containers/registries.d/workstation-signing.yaml)

for path in "${owned[@]}"; do
    pristine="${pristine_root}${path#/etc}"
    if [[ ! -e $pristine ]]; then
        # Not drift. The booted deployment predates this file -- normal between
        # a merge and the reboot that adopts it. Reported so a file that
        # genuinely never lands is still visible.
        echo "  $path is not in the booted image (pending deployment)"
        continue
    fi
    if [[ ! -e $path ]]; then
        echo "  $path was deleted locally; the image version is being ignored" >&2
        status=1
        continue
    fi
    if ! cmp -s "$pristine" "$path"; then
        echo "  $path diverges from the image:" >&2
        diff -u "$pristine" "$path" 2>&1 | sed -n '3,12p' | sed 's/^/    /' >&2
        status=1
    fi
done

(( status == 0 )) && echo "  every image-owned /etc file present on this deployment matches it."
exit "$status"
