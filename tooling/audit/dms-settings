#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
live=${DMS_SETTINGS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/DankMaterialShell/settings.json}
overlay=${DMS_SETTINGS_OVERLAY:-$repo_root/system_files/usr/share/workstation-os-image/dms-settings.json}
status=0

[[ -r $live && -r $overlay ]] || {
    echo "DMS live settings or captured overlay is missing." >&2
    exit 2
}

workdir="$(mktemp -d)"
trap 'rm -rf -- "$workdir"' EXIT
install -m 0600 "$live" "$workdir/settings.json"
DMS_SETTINGS_FILE="$workdir/settings.json" \
WORKSTATION_DMS_SETTINGS_OVERLAY="$overlay" \
    "$repo_root/system_files/usr/bin/workstation-apply-dms-settings" >/dev/null
/usr/bin/jq -S . "$live" > "$workdir/live.json"
"$repo_root/tooling/dms/defaults" > "$workdir/defaults.json"

# DMS 1.6 stores settings.json as a diff against the spec defaults, so an
# overlay entry whose value IS the default can never appear in the live file.
# The merge above re-adds it and a raw comparison then reports drift that no
# documented action clears: capture cannot offer the key and apply is undone
# by the next save. Those entries are dropped from the comparison and named
# instead -- they are dead pins, not drift. The exclusion is narrow on
# purpose: it applies only while the key is ABSENT from live. Present with any
# value, it is compared exactly as before, so a real edit is never hidden.
/usr/bin/jq -n \
    --slurpfile overlay "$overlay" \
    --slurpfile defaults "$workdir/defaults.json" \
    --slurpfile live "$workdir/live.json" '
    [ $overlay[0] | keys[] as $k
      | select($live[0] | has($k) | not)
      | select($defaults[0] | has($k))
      | select($overlay[0][$k] == $defaults[0][$k])
      | $k ]
' > "$workdir/dead-pins.json"
/usr/bin/jq -S --slurpfile drop "$workdir/dead-pins.json" \
    'delpaths([$drop[0][] | [.]])' "$workdir/settings.json" > "$workdir/merged.json"
mapfile -t dead_pins < <(/usr/bin/jq -r '.[]' "$workdir/dead-pins.json")

if ! cmp -s "$workdir/merged.json" "$workdir/live.json"; then
    echo "Live DMS preferences differ from the captured defaults."
    echo "  Run 'just dms-capture' to keep reviewed UI changes, or"
    echo "  run 'just dms-apply' to explicitly restore captured defaults."
    status=1
else
    echo "Captured DMS preferences match the live settings."
fi

if (( ${#dead_pins[@]} > 0 )); then
    printf 'Overlay entries DMS cannot store, because they equal its defaults (%d):\n' \
        "${#dead_pins[@]}"
    printf '  %s\n' "${dead_pins[@]}"
    echo "  Informational. Drop them with 'just dms-capture --remove' if the"
    echo "  intent was to pin a value rather than to restate a default."
fi

# Assert the input, not the exit status. Fed by process substitution this
# loop passed silently whenever the schema read failed -- printing "no
# uncaptured deviations" from a scan that never ran, which is exactly the
# moment a DMS upgrade makes new deviations most likely.
"$repo_root/tooling/dms/capture" --list > "$workdir/candidates" || {
    echo "Could not enumerate DMS capture candidates; the deviation scan did not run." >&2
    exit 2
}
mapfile -t candidates < "$workdir/candidates"
uncaptured=()
for line in "${candidates[@]}"; do
    [[ $line == *'[new]'* ]] && uncaptured+=("$line")
done
if (( ${#uncaptured[@]} > 0 )); then
    printf 'Portable DMS deviations are not captured (%d).\n' "${#uncaptured[@]}"
    echo "  Run 'just dms-capture' to review them interactively."
    status=1
else
    echo "No uncaptured portable DMS deviations."
fi

exit "$status"
