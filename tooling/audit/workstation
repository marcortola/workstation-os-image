#!/usr/bin/env bash
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
status=0

"$repo_root/tooling/audit/deployment" || status=$?
printf '\n'
# Machine-state, not image-state: /etc is a three-way merge and a local mask or
# rewrite outlives every upgrade, so nothing in the build can assert either.
"$repo_root/tooling/audit/units" || status=$?
printf '\n'
"$repo_root/tooling/audit/etc-drift" || status=$?
printf '\n'
# Also machine-state: the greeter's links live in /var, which no build gate can
# reach, and a repoint there is only discovered at the next boot.
"$repo_root/tooling/audit/greeter" || status=$?
printf '\n'
"$repo_root/tooling/audit/updates" || status=$?
printf '\n'
"$repo_root/tooling/audit/packages" || status=$?
printf '\n'
# Machine-state again, and the only thing that can see a vendor changing the
# undocumented file a parked-work probe reads.
"$repo_root/tooling/audit/agent-probes" || status=$?
printf '\n'
"$repo_root/tooling/audit/dotfiles" "$@" || {
    dotfile_status=$?
    (( dotfile_status > status )) && status=$dotfile_status
}

exit "$status"
