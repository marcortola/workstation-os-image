<keymap version="1" name="custom" parent="Default for XWin">
  <!-- The IDEs have no Vim emulation. These are the editor keys, and they are
       the whole set: nothing here defers to a <leader> chord.

       No entry for GotoTypeDeclaration, deliberately. An <action> element
       REPLACES the parent keymap's whole shortcut list rather than adding to
       it, so the mouse-only override this file used to carry was silently
       deleting that action's default keyboard shortcut. $default supplies both
       halves — control+shift+B plus ctrl+shift+button1 — so inheriting keeps
       the mouse binding and the key.

       Back and Forward do carry an override, and it is a real preference:
       shift+alt+arrows in place of $default's control+alt+arrows. The mouse
       halves are restated because of the same replace rule.

       The bare <action> elements at the end are deliberate unbindings of
       actions whose defaults fire by accident. EditorToggleCase is unbound
       because shift+ctrl+U belongs to CamelCase below. -->
  <action id="ActivateTerminalToolWindow">
    <keyboard-shortcut first-keystroke="alt f12" />
    <keyboard-shortcut first-keystroke="ctrl t" />
  </action>
  <action id="Back">
    <mouse-shortcut keystroke="button4" />
    <keyboard-shortcut first-keystroke="shift alt left" />
  </action>
  <action id="Forward">
    <mouse-shortcut keystroke="button5" />
    <keyboard-shortcut first-keystroke="shift alt right" />
  </action>
  <action id="Git.Branches">
    <keyboard-shortcut first-keystroke="shift ctrl b" />
  </action>
  <action id="PasteMultiple">
    <keyboard-shortcut first-keystroke="shift ctrl insert" />
  </action>
  <action id="RenameElement">
    <keyboard-shortcut first-keystroke="ctrl alt r" />
  </action>
  <action id="SelectInProjectView">
    <keyboard-shortcut first-keystroke="shift alt s" />
  </action>
  <action id="Terminal.CopySelectedText">
    <keyboard-shortcut first-keystroke="ctrl c" />
    <keyboard-shortcut first-keystroke="ctrl insert" />
  </action>
  <action id="Terminal.Paste">
    <keyboard-shortcut first-keystroke="ctrl v" />
    <keyboard-shortcut first-keystroke="shift insert" />
  </action>
  <action id="de.netnexus.CamelCasePlugin.ToggleCamelCase">
    <keyboard-shortcut first-keystroke="shift ctrl u" />
  </action>
  <action id="Diff.ApplyLeftSide" />
  <action id="Diff.ApplyRightSide" />
  <action id="EditorToggleCase" />
  <action id="NextEditorTab" />
  <action id="PreviousEditorTab" />
  <action id="ShelveChanges.UnshelveWithDialog" />
  <action id="Vcs.UpdateProject" />
  <action id="context.save" />
</keymap>
