<keymap version="1" name="custom" parent="Default for XWin">
  <!-- Keyboard customisations were removed when the IDEs moved to Vim bindings:
       the editor keys now come from ~/.ideavimrc (IdeaVim), and every action
       that used to have a custom chord here is reachable on its LazyVim <leader>
       key (terminal <leader>ft, rename <leader>cr, branches <leader>gB, paste
       history <leader>p, reveal in project <leader>fE, back/forward <C-o>/<C-i>).
       What remains: the terminal tool window's copy/paste (not editor keys) and
       deliberate unbindings of actions whose defaults fire by accident.

       No entries for Back / Forward / GotoTypeDeclaration: an <action> element
       REPLACES the parent keymap's whole shortcut list rather than adding to it,
       so a mouse-only override silently deletes that action's default keyboard
       shortcut. $default already supplies both halves — Back control+alt+LEFT
       plus button4, Forward control+alt+RIGHT plus button5, GotoTypeDeclaration
       control+shift+B plus ctrl+shift+button1 — so inheriting keeps the mouse
       navigation and restores the keys. -->
  <action id="Terminal.CopySelectedText">
    <keyboard-shortcut first-keystroke="ctrl c" />
    <keyboard-shortcut first-keystroke="ctrl insert" />
  </action>
  <action id="Terminal.Paste">
    <keyboard-shortcut first-keystroke="ctrl v" />
    <keyboard-shortcut first-keystroke="shift insert" />
  </action>
  <action id="Diff.ApplyLeftSide" />
  <action id="Diff.ApplyRightSide" />
  <action id="NextEditorTab" />
  <action id="PreviousEditorTab" />
  <action id="ShelveChanges.UnshelveWithDialog" />
  <action id="Vcs.UpdateProject" />
  <action id="context.save" />
</keymap>
