#!/usr/bin/env bash
# Optional, interactive step of `just ide-setup`: offer to apply the shared
# JetBrains settings into this machine's IDEs. Applying overwrites each IDE's
# local config (a timestamped backup is made first), skips any running IDE, and
# primes the GUI "Push Settings to Account" step that overwrites the settings
# your OTHER machines synced to the cloud. Because of that blast radius it
# defaults to NO, is skipped when stdin is not a TTY, and shows a dry-run preview
# before asking. Applies to every IDE; use `just jetbrains-apply --product NAME`
# to scope, or as the non-interactive path.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
settings="$repo_root/tooling/apply-jetbrains-settings"

if [[ ! -t 0 ]]; then
    echo "ide-setup: skipping the optional JetBrains settings apply (non-interactive)."
    echo "           apply later with: just jetbrains-apply --force --i-understand-overwrites-cloud"
    exit 0
fi

echo
echo "Optional: apply the shared JetBrains settings to this machine's IDEs."
echo "Preview (nothing is written yet):"
"$settings" || true

echo
echo "Applying overwrites each IDE's local config (backed up first), skips running"
echo "IDEs, and primes a GUI cloud push that overwrites the settings your other"
echo "machines synced. Leave this at 'no' if you are unsure."
read -r -p "Apply these JetBrains settings now? [y/N] " reply
case "$reply" in
    [yY] | [yY][eE][sS])
        "$settings" --force --i-understand-overwrites-cloud \
            || echo "ide-setup: settings apply did not complete (see above); the key + plugins are done." >&2
        ;;
    *)
        echo "Skipped JetBrains settings. (The intelephense key + JetBrains plugins are done.)"
        ;;
esac
