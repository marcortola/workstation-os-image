#!/usr/bin/env bash
# Verify every input image this build consumes, before it consumes it.
#
# Both inputs are pinned by digest in the Containerfile and both are signed by
# ublue. Without this gate a compromised GHCR account or a bad push lands on the
# machine unremarked, and no historical build is reproducible. It is also the
# only pin that holds: the desktop stack floats because COPR prunes superseded
# builds, so there is nothing to versionlock there.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"
key=build_files/keys/ublue-os.pub

command -v cosign >/dev/null || { echo "cosign is not installed" >&2; exit 2; }
[[ -r $key ]] || { echo "vendored ublue key missing: $key" >&2; exit 2; }

# EVERY digest-pinned reference, not just the ublue ones. Scoping the grep to
# ghcr.io/ublue-os meant a pinned input from any other registry was silently
# unverified while this script still printed "All source images verified" and
# exited 0 -- asserting success rather than coverage. Default-deny instead:
# anything without a configured trust anchor fails the build.
mapfile -t refs < <(
    grep -oE '[a-z0-9.-]+\.[a-z]{2,}/[a-z0-9._/-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}' Containerfile \
        | sort -u
)
(( ${#refs[@]} )) || { echo "no digest-pinned images found in Containerfile" >&2; exit 1; }

# repo prefix -> vendored public key. A prefix absent from this table is not
# trusted, and there is deliberately no default branch.
key_for() {
    case "$1" in
        ghcr.io/ublue-os/*) printf '%s' "$key" ;;
        *) return 1 ;;
    esac
}

# A registry that answers "I do not have that" is a pruned pin, and the build
# must stop. Anything else -- a rate limit, a 5xx, DNS, a refused connection --
# means the question went unanswered, which is NOT the same answer.
#
# Measured with skopeo 1.x against ghcr.io, since guessing these is how the bug
# below got written:
#   pruned digest, real repo  manifest unknown                               exit 2
#   repo does not exist       bearer token: ... 403 Forbidden                exit 1
#   host does not resolve     dial tcp: lookup ...: no such host             exit 1
#   connection refused        dial tcp ...: connect: connection refused      exit 1
#
# Match on the message rather than the exit code: only "manifest unknown" is a
# statement about the digest, and exit 2 is corroboration, not the signal.
# Everything unrecognised is treated as unanswered on purpose. The two ways to
# be wrong are not symmetric -- calling a live pin pruned invites bumping a good
# pin, which destroys the signal this gate exists to give, while calling a dead
# pin unanswered only defers the failure to the build, which is where it landed
# before this check existed.
digest_is_gone() {
    case "$1" in
        *"manifest unknown"*|*MANIFEST_UNKNOWN*) return 0 ;;
        *) return 1 ;;
    esac
}

# present | gone | unanswered<TAB><the error skopeo actually gave>
probe_digest() {
    local err
    if err="$(skopeo inspect --no-tags --retry-times 3 "docker://$1" 2>&1 >/dev/null)"; then
        printf 'present'
    elif digest_is_gone "$err"; then
        printf 'gone\t%s' "$err"
    else
        printf 'unanswered\t%s' "$err"
    fi
}

# The one line worth printing out of cosign's stderr. It opens with a
# deprecation notice about --new-bundle-format on every run, and when a key does
# not match it embeds both PEMs in the message and spills over many lines -- so
# a plain `tail` prints the tail of a public key rather than the reason.
cosign_reason() {
    printf '%s\n' "$1" \
        | grep -m1 -E '^(Error|error during command execution):' \
        | cut -c1-200 \
        | grep . || printf 'cosign failed; re-run it by hand for the full output'
}

status=0
skipped=0
for ref in "${refs[@]}"; do
    printf '%s\n' "$ref"
    if ! ref_key="$(key_for "$ref")"; then
        echo "  NO TRUSTED SIGNING KEY CONFIGURED for this registry prefix" >&2
        status=1
        continue
    fi
    # Ask the registry about the digest BEFORE cosign, because its answer is
    # what explains a cosign failure. cosign cannot verify a digest it cannot
    # resolve and reports that as `no signatures found` -- indistinguishable
    # from a real signing problem -- so with the checks the other way round a
    # pruned pin was diagnosed as a signature failure and the "bump the pin"
    # branch below was unreachable.
    #
    # skopeo rejects the combined repo:tag@digest form that cosign accepts, so
    # strip the tag for this lookup.
    # Split on @ first: the tag is optional, so stripping at the first colon of
    # the whole reference would eat "sha256" out of a tagless pin.
    repo_and_tag="${ref%@*}"
    canonical="${repo_and_tag%:*}@${ref#*@}"
    probe="$(probe_digest "$canonical")"
    case "${probe%%$'\t'*}" in
        present)
            echo "  digest still present in the registry"
            ;;
        gone)
            echo "  DIGEST NO LONGER FETCHABLE -- bump the pin" >&2
            echo "    ${probe#*$'\t'}" >&2
            status=1
            continue
            ;;
        *)
            # Unanswered is not an answer of "gone". Report it as what it is and
            # keep going: the signature check below is the one that carries the
            # security weight, and it still has to pass.
            echo "  could not confirm the digest, so not claiming it is pruned:"
            echo "    ${probe#*$'\t'}"
            skipped=$((skipped + 1))
            ;;
    esac
    # A cosign failure is never downgraded -- this is the check the whole
    # inbound chain rests on. Only its diagnosis improves: the reason used to be
    # discarded with `2>&1`, so a rate limit and a bad signature printed the
    # same line.
    if cosign_err="$(cosign verify --new-bundle-format=false --key "$ref_key" "$ref" 2>&1 >/dev/null)"; then
        echo "  signature verified against $ref_key"
    else
        echo "  SIGNATURE VERIFICATION FAILED" >&2
        cosign_reason "$cosign_err" | sed 's/^/    /' >&2
        status=1
        continue
    fi
done

# Never print a clean bill for a check that did not run. The point of the gate
# is coverage, not a green line.
if (( status == 0 )); then
    if (( skipped )); then
        echo "Signatures verified, but $skipped digest presence check(s) went unanswered."
    else
        echo "All source images verified."
    fi
fi
exit "$status"
