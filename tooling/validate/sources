#!/usr/bin/env bash
# Repo-only gates: everything provable from the checkout alone, with no live
# account, no installed IDEs and no running desktop.
#
# Split out of tooling/validate/all so CI can run it. CI previously ran only
# validate/repo, image-build, source-images and rpm-keys, which left the
# AGENTS.md reference gates, the AI seed and scrub assertions, and the worktree
# wiring checks unrun on every push -- and those are the ones that rot silently,
# because nothing else proves a renamed path or a leaked key.
#
# Anything needing the live machine (DMS overlay, JetBrains, foot, chezmoi
# against $HOME, audit/workstation) deliberately stays in validate/all.
set -euo pipefail
# Several assertions here are bare `[[ ]]` with no message, so a failure used
# to exit 1 printing nothing at all. Name the line instead.
trap 'echo "FAILED ${BASH_SOURCE[0]}:${LINENO}" >&2' ERR

# A `while read ... done < <(grep FILE)` on a missing FILE iterates zero times
# and passes. Assert the inputs exist so a rename breaks the gate loudly.
require_file() { test -f "$1" || { echo "gate input is missing: $1" >&2; exit 1; }; }

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

require_file AGENTS.md
require_file README.md
require_file docs/README.md
[[ $(< CLAUDE.md) == '@AGENTS.md' ]]
# Raised from 210 when AGENTS.md gained its Conventions section, then to 266 for
# the upstream-Zirconium watermark entry -- a source of truth an agent has to
# know exists, since nothing else in the tree implies that upstream is tracked
# at all. Raised to 279 for the dev.flow herdr plugin: it makes worktree
# propagation a two-net mechanism where the rule had been "never add a second
# copy list", and a rule that reversed is worse than no rule if the reversal is
# not written down. The cap is a forcing function against AGENTS.md becoming a
# second README, and invariants are exactly what it should protect -- but it
# only works if each rise is deliberate, so keep it in one place with a reason
# attached. Raised to 289 for the agent-recency clock: herdr reports agent state
# without a timestamp, so three separate behaviours -- a freshness mark, an
# expiry window and whether a conversation resumes -- hang off one stamp file,
# and an agent that does not know that is one `date` call away from adding a
# second, silently disagreeing clock. Raised to 295 for the worktree/Dev Container
# invariant: a linked checkout is not a repository inside the container unless it
# records a relative path, the flag that fixes it is inert rather than loud when
# it does not, and an agent that does not know that will delete the flag to make
# a broken container start. Raised again to 300 for the second dev layout:
# `layout.apply` is the API anyone adding a third would reach for first, and it
# replaces the tab it is handed, so applying a layout with it restarts the
# agent -- a rule that has to be read before the code, not after. Raised to 305
# when the two layouts went onto one key: the rule that matters is that every
# step converges rather than builds, because four separate roots each added a
# tab and every one of them read as a plausible way to write it. `pane move`
# answering a refusal with a SUCCESS reply is the trap under all of them, and an
# agent that does not know it will read the tab id back out of that reply.
# Raised to 312 for the herdr bar widget: it is the first QML this repository
# ships and nothing on the machine lints QML, so the ways it breaks are all
# silent -- an id that disagrees across three files, a capability that moves it
# off the bar, a plugin directory DMS never scanned -- and an agent that does
# not know the check is a plugin reload will conclude the widget is fine
# because `just validate` passed. Raised to 316 for DataGrip: it is the one piece
# of software here that no package manager can install, so the Brewfile line an
# agent would reach for first is not an oversight to correct but the mistake the
# entry warns against -- the Homebrew cask is macOS-only and the Flathub build is
# retired, and both facts are invisible from inside this repository. Raised to
# 331 for parked background work: herdr's `idle` means no foreground turn and
# not no work, upstream settled that deliberately with a regression test, and
# the two rules an agent needs before touching this are both counter-intuitive
# -- the recency stamp now has two writers on one clock, and the obvious
# agent-agnostic predicate for "still busy" was measured false, so an agent that
# does not know will delete the per-agent probes and rebuild a process-tree walk
# that reads true through every foreground tool call.
(( $(wc -l < AGENTS.md) <= 331 ))

# README.md is a landing pad into docs/ and nothing else. Capped because it grows
# back otherwise: it was 855 lines covering fourteen concerns before the handbook
# existed, which is how install and recovery -- the two things wanted under time
# pressure -- ended up in the last 14% of the file. The handbook itself has no
# cap; a page may be as long as its subject. The front door may not.
(( $(wc -l < README.md) <= 170 ))

# The agent guide, the landing pad and the handbook state policy; nothing else
# proves their references still exist, so they silently rot as recipes and paths
# are renamed. Assert the two classes that are mechanically checkable: every
# `just`/`wjust` target named must be a real recipe, and every repo-root-relative
# path cited must exist. Prose stays the author's problem; dangling pointers do
# not. The path alternation must name the CURRENT top-level trees -- it named the
# deleted ones for two commits and matched nothing under either new tree.
agents_stale=0
recipes=" $(just --summary) "
# The prose files, the handbook, and the checked-in agent commands. A slash
# command is prose that an agent executes, so a stale recipe or path in one is
# worse than in AGENTS.md: nothing reads it until the moment it is being relied
# on. Each tree gets its own floor rather than one combined count, which would
# let a whole tree vanish while the others held the total up.
docs=(AGENTS.md README.md)
doc_pages=()
while IFS= read -r f; do doc_pages+=("$f"); done < <(find docs -name '*.md' | sort)
(( ${#doc_pages[@]} >= 15 )) \
    || { echo "handbook pages missing under docs/ (found ${#doc_pages[@]})" >&2; exit 1; }
commands=()
while IFS= read -r f; do commands+=("$f"); done < <(find .claude/commands -name '*.md' 2>/dev/null | sort)
(( ${#commands[@]} > 0 )) || { echo "no agent commands found under .claude/commands" >&2; exit 1; }
docs+=("${doc_pages[@]}" "${commands[@]}")
while read -r target; do
    [[ $recipes == *" $target "* ]] && continue
    echo "docs reference unknown recipe: just $target" >&2
    agents_stale=1
done < <(grep -ohE '`w?just [a-z][a-z0-9-]*' "${docs[@]}" \
    | sed -E 's/`w?just //' | sort -u)
while read -r path; do
    [[ -e $path ]] && continue
    echo "docs reference missing path: $path" >&2
    agents_stale=1
done < <(grep -ohE '`?(system_files|build_files|tooling|docs)/[A-Za-z0-9._/-]*' "${docs[@]}" \
    | tr -d '`' | sed 's/[.,]$//' | sort -u)
(( agents_stale == 0 ))

# The handbook is twenty files that link to each other, and the path gate above
# only sees a link whose target starts with a top-level tree name -- a sibling
# link like (architecture.md) is invisible to it. Resolve every relative target
# instead, and forbid a cross-file anchor outright: a fragment into another page
# looks fine forever after the heading it names is renamed, so one file is one
# address. Same-file anchors stay allowed and are checked against the headings.
# Runs over the same file set as the gates above rather than docs/ alone: today
# AGENTS.md carries no links at all, and the point is that adding one does not
# quietly land outside the check.
link_failures=0
while IFS= read -r f; do
    dir="$(dirname "$f")"
    while IFS= read -r target; do
        [[ -z $target ]] && continue
        case "$target" in http://* | https://* | mailto:*) continue ;; esac
        path="${target%%#*}"
        if [[ -z $path ]]; then
            # Pure fragment: GitHub slugs a heading by lowercasing, dropping
            # everything but alphanumerics, spaces and hyphens, then joining on
            # hyphens.
            grep -qxF "${target#\#}" < <(grep -oE '^#{1,6} .*' "$f" \
                | sed -E 's/^#+ //; s/`//g' \
                | tr '[:upper:]' '[:lower:]' \
                | sed -E 's/[^a-z0-9 -]//g; s/ /-/g') \
                || { echo "docs link to missing anchor: $f -> $target" >&2; link_failures=1; }
            continue
        fi
        if [[ $target == *'#'* ]]; then
            echo "docs link carries a cross-file anchor: $f -> $target" >&2
            link_failures=1
        fi
        [[ -e $dir/$path ]] \
            || { echo "docs link to missing path: $f -> $path" >&2; link_failures=1; }
    done < <(grep -ohE '\]\([^)]+\)' "$f" | sed -E 's/^\]\(//; s/\)$//')
done < <(printf '%s\n' "${docs[@]}")
(( link_failures == 0 ))

# AI CLI config seeds must be secret-free by construction: the scrub filters
# strip secrets/machine-state on capture, and these positive gates assert the
# committed seeds (visible to CI even when live files are absent). gitleaks
# above is the generic backstop; these catch the tool-specific shapes it misses
# (e.g. the dash-broken context7 key gitleaks does not flag).
ai_seeds=system_files/usr/share/workstation-os-image/dotfiles
assert_absent() {
    # Fail if the extended-regexp $1 matches (case-insensitively) anywhere in
    # file $2. A plain `! grep` would be exempt from errexit and silently pass,
    # so branch.
    if grep -qiE "$1" "$2"; then
        echo "Secret/machine-state leaked into $2 (matched: $1)" >&2
        exit 1
    fi
}
claude_settings="$ai_seeds/dot_claude/create_settings.json"
jq -e 'has("env") | not' "$claude_settings" >/dev/null
# Help Scout leaks as the env-var values (HELPSCOUT_APP_*) AND as the lowercase
# plugin/marketplace identifiers (helpscout-navigator, help-scout-mcp).
assert_absent 'helpscout|help-scout' "$claude_settings"
assert_absent 'enabledPlugins|extraKnownMarketplaces' "$claude_settings"
assert_absent '/(var/)?home/' "$claude_settings"
# opencode.json is generated by the fusion installer (just ai-tools-install), not
# captured; only our context7 mcp fragment is tracked, and its key must be a
# {file:}/{env:} placeholder, never a literal.
jq -e '.mcp.context7.headers.CONTEXT7_API_KEY
        | startswith("{file:") or startswith("{env:")' \
    tooling/data/ai-tools/opencode-mcp-fragment.json >/dev/null
codex_config="$ai_seeds/dot_codex/create_config.toml"
# Only the canonical, secret-free OpenAI developer-docs MCP table may survive
# codex scrub.
if grep '^\[' "$codex_config" \
    | grep -Fvx \
        -e '[mcp_servers.openaiDeveloperDocs]' >/dev/null; then
    echo "Unapproved table leaked into $codex_config" >&2
    exit 1
fi
[[ $(grep -Fxc '[mcp_servers.openaiDeveloperDocs]' "$codex_config") -eq 1 ]]
grep -Fqx 'url = "https://developers.openai.com/mcp"' "$codex_config"
assert_absent 'HELPSCOUT_APP_(ID|SECRET)[[:space:]]*=' "$codex_config"
assert_absent '/(var/)?home/' "$codex_config"
assert_absent \
    '(\.local/share/opencode/auth\.json|\.codex/auth\.json|\.claude/\.credentials\.json)' \
    tooling/data/dotfiles.manifest
# The portable bundle is a projection of the seeds; it too must carry no key or
# absolute home path.
if grep -rIliE 'ctx7sk-|/home/[a-z]' \
    tooling/ai/ai-cli-setup/config tooling/ai/ai-cli-setup/opencode-mcp-fragment.json \
    >/dev/null 2>&1; then
    echo "Secret or absolute home path leaked into tooling/ai/ai-cli-setup" >&2
    exit 1
fi

# Claude Code's auto mode rewrites autoMode.environment for whichever project it
# is run in: organisation, private repository names, secret names, internal
# domains. It regenerates constantly, this repository is public, and gitleaks
# does not recognise any of it as a secret, so assert the scrub actually held.
jq -e '.autoMode.environment == null' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_claude/create_settings.json >/dev/null
jq -e '.autoMode.environment == null' \
    tooling/ai/ai-cli-setup/config/claude/settings.json >/dev/null

# Worktree untracked-file propagation: every creation path (herdr, Claude Code,
# the post-checkout hook) reaches the same committed .worktreeinclude through
# `git worktree add`, so assert the wiring that keeps them in sync.
grep -q 'workstation-worktree-sync' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/template/hooks/create_executable_post-checkout
grep -q 'satococoa/tap/git-worktreeinclude' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/homebrew/create_Brewfile
grep -q 'templateDir' system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config
[[ -x tooling/worktree/init ]]

# The version in the hook's ownership sentinel is what lets `just worktree-init`
# replace an older copy of the hook in a repository that already has one. Without
# it every edit below this line is dead code in every existing repository.
grep -qE '^# workstation-worktree-init: managed post-checkout hook v[0-9]+$' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/template/hooks/create_executable_post-checkout

# One mechanism, three files. `git lfs install` writes its own post-checkout into
# the same slot and refuses to merge with an incumbent, and init.templateDir makes
# ours the incumbent in every new clone -- so the managed hook is the only thing
# carrying Git LFS here. The chain, the filter config the chain resolves content
# through, and the binary both of them call must ship together or LFS is silently
# half-configured.
grep -q 'git lfs post-checkout' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/template/hooks/create_executable_post-checkout
grep -q '^\[filter "lfs"\]' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config
grep -qE '^git-lfs([[:space:]]|$)' build_files/packages/dev.list

tooling/worktree/test-init

# The `dev` wrapper's --mount strings have to satisfy the devcontainer CLI's own
# grammar, which takes type/source/target plus an optional external= and rejects
# anything else at parse time. A `,readonly` suffix once slipped in here and
# broke `dev` for every project on the machine; `fish --no-execute` cannot see
# inside a string literal, so assert the grammar itself. Fish interpolation --
# "(command)" and $var -- collapses to a placeholder first.
dev_fish=system_files/usr/share/workstation-os-image/dotfiles/dot_config/fish/functions/create_dev.fish
require_file "$dev_fish"
dev_mounts=0
while read -r dev_mount; do
    dev_mounts=$((dev_mounts + 1))
    [[ $dev_mount =~ ^type=(bind|volume),source=[^,]+,target=[^,]+(,external=(true|false))?$ ]] \
        || { echo "not valid devcontainer --mount syntax: $dev_mount" >&2; exit 1; }
done < <(
    grep -oE '"type=(bind|volume),.*"' "$dev_fish" \
        | sed -E 's/"\(.*\)"/X/; s/\$[A-Za-z_][A-Za-z0-9_]*/X/g; s/^"//; s/"$//'
)
(( dev_mounts >= 5 ))

# One mechanism, two files: `dev` mounts a linked worktree's common .git, which
# the CLI honours only where the checkout records a RELATIVE path, so the git
# config seed is what makes the flag do anything at all.
grep -q -- '--mount-git-worktree-common-dir' "$dev_fish"
grep -q 'useRelativePaths = true' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config

# `up` and `exec` both derive the container workspace path from that flag, so a
# call that omits it chdirs into a path the container does not have.
while read -r dev_call; do
    # The single quotes are the point: match the literal fish variable name.
    # shellcheck disable=SC2016
    [[ $dev_call == *'$dcflags'* ]] \
        || { echo "devcontainer call without \$dcflags: $dev_call" >&2; exit 1; }
done < <(grep -E 'devcontainer (up|exec) --workspace-folder' "$dev_fish")

# The herdr bar widget spans four files that have to agree, and every way they
# can disagree is silent: a plugin whose id is missing from the bar config loads
# and never renders, a bar id with no enablement seed renders nothing, a stray
# "launcher" capability routes the widget off the bar entirely, and a renamed
# dev-flow script leaves a pill that polls an empty list forever. Nothing here
# parses QML -- there is no qmllint on this machine and the widget is the only
# QML the repo ships -- so these are the only mechanical checks it gets.
herdr_widget=system_files/usr/share/workstation-os-image/dotfiles/dot_config/DankMaterialShell/plugins/herdrJobs
herdr_widget_seed=system_files/usr/share/workstation-os-image/dotfiles/dot_config/DankMaterialShell/create_plugin_settings.json
dev_flow=system_files/usr/share/workstation-os-image/dotfiles/dot_config/herdr/plugins/dev-flow
require_file "$herdr_widget/plugin.json"
require_file "$herdr_widget_seed"
require_file "$dev_flow/executable_focus-space.sh"
herdr_widget_id=$(jq -r '.id' "$herdr_widget/plugin.json")
[[ -f $herdr_widget/$(jq -r '.component' "$herdr_widget/plugin.json") ]]
# index() answers 0 for a first-element hit, which jq -e reads as false, so both
# tests compare against null rather than relying on truthiness.
jq -e '(.capabilities | index("dankbar-widget") != null)
       and (.capabilities | index("launcher") == null)' "$herdr_widget/plugin.json" >/dev/null
jq -e --arg id "$herdr_widget_id" '.[$id].enabled == true' "$herdr_widget_seed" >/dev/null
jq -e --arg id "$herdr_widget_id" \
    '[.barConfigs[]
      | (.leftWidgets // []) + (.centerWidgets // []) + (.rightWidgets // [])
      | .[] | if type == "string" then . else .id end] | index($id) != null' \
    system_files/usr/share/workstation-os-image/dms-settings.json >/dev/null
# One mechanism, two files: the widget is a view of the space picker's rows, so
# it shells out to the picker's own script rather than asking herdr again.
grep -q 'spaces.sh --json' "$herdr_widget/HerdrJobsWidget.qml"
grep -q 'focus-space.sh' "$herdr_widget/HerdrJobsWidget.qml"
grep -q '"--json"' "$dev_flow/executable_spaces.sh"

# A checkout parked on background work spans five files that have to agree, and
# every way they can disagree is silent: herdr calls the pane idle either way,
# so a probe that never runs, a state word the row builder does not emit, or a
# colour the widget does not know produce exactly the behaviour this feature
# exists to replace, with nothing to show that it failed.
probes=system_files/usr/libexec/workstation-agent-probes
require_file "$probes/lib.sh"
require_file docs/subsystems/agent-probes.md
require_file tooling/data/agent-probe-registry
# Assert coverage, not success: require_file above proves the glob is non-empty,
# because a loop fed by a find that matches nothing passes without running.
require_file "$probes/probes/claude"
for probe in "$probes"/probes/*; do
    probe_name=$(basename "$probe")
    [[ -x $probe ]]
    grep -q "^## $probe_name" docs/subsystems/agent-probes.md
    grep -q "^$probe_name|probe|" tooling/data/agent-probe-registry
done
# The registry is the audit's list of what is covered and what is knowingly not,
# so a line claiming a probe must have one.
while IFS='|' read -r registry_agent registry_kind _; do
    [[ $registry_agent == \#* || -z $registry_agent ]] && continue
    [[ $registry_kind != probe ]] || require_file "$probes/probes/$registry_agent"
    [[ $registry_kind == probe || $registry_kind == none ]]
done < tooling/data/agent-probe-registry
# Both plugin scripts define a no-op fallback for the machine where the image
# half is absent, so grepping for the function name alone passes in the state
# where lib.sh is never sourced and the whole feature is quietly dead. Gate the
# source line itself.
grep -q '^agent_parked_probe()' "$probes/lib.sh"
grep -q '^agent_parked_write()' "$probes/lib.sh"
for wired in executable_spaces.sh executable_agent-freshness.sh; do
    grep -qF '. /usr/libexec/workstation-agent-probes/lib.sh' "$dev_flow/$wired"
    grep -q 'agent_parked_probe' "$dev_flow/$wired"
done
grep -q 'sweep_parked' "$dev_flow/executable_spaces.sh"
grep -q 'agent_parked_write' "$dev_flow/executable_spaces.sh"
# One mechanism, two files: lib.sh documents the marker columns and spaces.sh is
# the only thing that writes them.
grep -q 'nagged' "$probes/lib.sh"
grep -q 'nagged' "$dev_flow/executable_spaces.sh"
grep -q 'def is_parked' "$dev_flow/executable_spaces.sh"
grep -q 'colour\["parked"\]' "$dev_flow/executable_spaces.sh"
grep -q 'case "parked"' "$herdr_widget/HerdrJobsWidget.qml"
grep -q 'parkedCount' "$herdr_widget/HerdrJobsWidget.qml"
# The widget's in-flight latch must expire on its own. DMS's Proc fires a
# command callback only once exit, stdout AND stderr have all been seen, and its
# timeout path sets exit alone, so a child whose streams never finish -- what
# suspending the machine does to one in flight -- leaves the callback uncalled
# forever. A latch cleared only by that callback then stops the widget polling
# for the rest of the session, reporting herdr down with herdr up, leaving no
# orphan process and no logged error behind to find it by.
grep -q 'pollStartedMs' "$herdr_widget/HerdrJobsWidget.qml"
grep -q 'pollCeilingMs' "$herdr_widget/HerdrJobsWidget.qml"

# The probe against fixtures, which is the half that runs with no live machine.
# procStart is substituted rather than pinned: it is the starttime of a live
# process, and the point of the stale fixture is that a wrong one is rejected.
probe_fixtures=$(mktemp -d)
cp -r tooling/fixtures/agent-probes/claude/sessions "$probe_fixtures/"
sed -i "s/__PROC1_START__/$(sed 's/.*) //' /proc/1/stat | awk '{print $20}')/" \
    "$probe_fixtures"/sessions/*.json
probe_saw=$(CLAUDE_CONFIG_DIR=$probe_fixtures "$probes/probes/claude" \
    <tooling/fixtures/agent-probes/claude/panes.json)
rm -rf "$probe_fixtures"
# pA is parked. pB is busy, which is a foreground turn. pC carries a procStart
# that no longer matches its pid, which is a session file outliving its session.
# pD has no session id at all.
[[ $probe_saw == '["pA"]' ]] || { echo "claude probe: expected [\"pA\"], got $probe_saw" >&2; exit 1; }
probe_saw=$(CLAUDE_CONFIG_DIR=/nonexistent "$probes/probes/claude" \
    <tooling/fixtures/agent-probes/claude/panes.json)
[[ $probe_saw == '[]' ]] || { echo "claude probe with no sessions: got $probe_saw" >&2; exit 1; }

# A probe that is there and does not answer must stay distinguishable from one
# that says no. Conflating them turns a single bad tick -- a timeout under load,
# a session file read mid-rewrite -- into a finish that never happened, which is
# the exact false mark the parked state exists to remove.
probe_stub=$(mktemp -d)
printf '#!/usr/bin/env bash\ncat >/dev/null\nexit 1\n' >"$probe_stub/claude"
chmod +x "$probe_stub/claude"
probe_pane='[{"pane_id":"pA","agent":"claude"}]'
if (
    # shellcheck source=../../system_files/usr/libexec/workstation-agent-probes/lib.sh
    . "$probes/lib.sh"
    AGENT_PROBE_DIR=$probe_stub agent_parked_probe "$probe_pane" >/dev/null
); then
    echo "agent_parked_probe reported success for a probe that failed" >&2
    exit 1
fi
# An agent with no probe is not a failure: that is the degrade path, and a
# machine running an unprobed agent must not have every tick read as unknown.
if ! (
    # shellcheck source=../../system_files/usr/libexec/workstation-agent-probes/lib.sh
    . "$probes/lib.sh"
    AGENT_PROBE_DIR=$probe_stub agent_parked_probe '[{"pane_id":"pA","agent":"codex"}]' >/dev/null
); then
    echo "agent_parked_probe reported failure for an agent with no probe" >&2
    exit 1
fi
rm -rf "$probe_stub"

# One mechanism, two files: DataGrip has no package on Linux -- the Homebrew cask
# is macOS-only and the Flathub build was retired -- so the image ships the
# launcher while workstation-bootstrap-user unpacks the vendor tarball, puts the
# binary on the session PATH and installs the icon into the user's hicolor theme.
# Either half alone is a launcher that does nothing or an install with no way to
# start it, and neither failure is visible until someone clicks the icon.
datagrip_desktop=system_files/usr/share/applications/datagrip.desktop
datagrip_bootstrap=system_files/usr/libexec/workstation-bootstrap-user
require_file "$datagrip_desktop"
require_file "$datagrip_bootstrap"
datagrip_exec="$(sed -nE 's/^Exec=([^ ]+).*/\1/p' "$datagrip_desktop")"
datagrip_icon="$(sed -nE 's/^Icon=(.+)/\1/p' "$datagrip_desktop")"
[[ -n $datagrip_exec && -n $datagrip_icon ]]
grep -q "local/bin/$datagrip_exec\"" "$datagrip_bootstrap" \
    || { echo "$datagrip_desktop runs $datagrip_exec, which $datagrip_bootstrap never links" >&2; exit 1; }
grep -q "icons/hicolor/scalable/apps" "$datagrip_bootstrap"
grep -q "$datagrip_icon.svg\"" "$datagrip_bootstrap" \
    || { echo "$datagrip_desktop names icon $datagrip_icon, which $datagrip_bootstrap never installs" >&2; exit 1; }

# --- every tracked structured config file parses -----------------------------
# A malformed greeter/settings.json fails at the login screen, which is the one
# place on this machine where a bad file is genuinely expensive to discover.
# Most of these 31 files were never parsed by anything. Deliberately not a
# pre-commit framework: that would be a second enforcement surface, and this
# already runs in CI.
parse_failures=0
while IFS= read -r f; do
    case "$f" in
        *.json)
            # .json5 is excluded below: comments and trailing commas are valid
            # there and jq rejects both.
            jq -e . "$f" >/dev/null 2>&1 || { echo "invalid JSON: $f" >&2; parse_failures=1; } ;;
        *.toml)
            python3 -c 'import sys,tomllib;tomllib.load(open(sys.argv[1],"rb"))' "$f" \
                || { echo "invalid TOML: $f" >&2; parse_failures=1; } ;;
        *.yml | *.yaml)
            yq -e . "$f" >/dev/null 2>&1 || { echo "invalid YAML: $f" >&2; parse_failures=1; } ;;
    esac
done < <(git ls-files '*.json' '*.toml' '*.yml' '*.yaml')
(( parse_failures == 0 )) || exit 1

# --- shipped scripts use one of two shebangs ---------------------------------
# #!/usr/bin/env bash for bash, #!/bin/sh for the POSIX ones. Anything else is
# an outlier rather than a decision -- workstation-ocr carried #!/usr/bin/bash
# alone among ten. build_files/ is excluded deliberately: those run inside the
# image where bash is at a known path, and they all use #!/usr/bin/bash.
while IFS= read -r f; do
    head -1 "$f" | grep -qxE '#!/usr/bin/env bash|#!/bin/sh' \
        || { echo "unexpected shebang in $f: $(head -1 "$f")" >&2; exit 1; }
done < <(find system_files/usr/bin system_files/usr/libexec -type f)

echo "Repo-only source gates passed."
