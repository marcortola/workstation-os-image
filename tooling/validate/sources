#!/usr/bin/env bash
# Repo-only gates: everything provable from the checkout alone, with no live
# account, no installed IDEs and no running desktop.
#
# Split out of tooling/validate/all so CI can run it. CI previously ran only
# validate/repo, image-build, source-images and rpm-keys, which left the
# AGENTS.md reference gates, the AI seed and scrub assertions, and the worktree
# wiring checks unrun on every push -- and those are the ones that rot silently,
# because nothing else proves a renamed path or a leaked key.
#
# Anything needing the live machine (DMS overlay, JetBrains, foot, chezmoi
# against $HOME, audit/workstation) deliberately stays in validate/all.
set -euo pipefail
# Several assertions here are bare `[[ ]]` with no message, so a failure used
# to exit 1 printing nothing at all. Name the line instead.
trap 'echo "FAILED ${BASH_SOURCE[0]}:${LINENO}" >&2' ERR

# A `while read ... done < <(grep FILE)` on a missing FILE iterates zero times
# and passes. Assert the inputs exist so a rename breaks the gate loudly.
require_file() { test -f "$1" || { echo "gate input is missing: $1" >&2; exit 1; }; }

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

require_file AGENTS.md
require_file README.md
require_file docs/README.md
[[ $(< CLAUDE.md) == '@AGENTS.md' ]]
# Raised from 210 when AGENTS.md gained its Conventions section, then to 266 for
# the upstream-Zirconium watermark entry -- a source of truth an agent has to
# know exists, since nothing else in the tree implies that upstream is tracked
# at all. Raised to 279 for the dev.flow herdr plugin: it makes worktree
# propagation a two-net mechanism where the rule had been "never add a second
# copy list", and a rule that reversed is worse than no rule if the reversal is
# not written down. The cap is a forcing function against AGENTS.md becoming a
# second README, and invariants are exactly what it should protect -- but it
# only works if each rise is deliberate, so keep it in one place with a reason
# attached. Raised to 289 for the agent-recency clock: herdr reports agent state
# without a timestamp, so three separate behaviours -- a freshness mark, an
# expiry window and whether a conversation resumes -- hang off one stamp file,
# and an agent that does not know that is one `date` call away from adding a
# second, silently disagreeing clock. Raised to 295 for the worktree/Dev Container
# invariant: a linked checkout is not a repository inside the container unless it
# records a relative path, the flag that fixes it is inert rather than loud when
# it does not, and an agent that does not know that will delete the flag to make
# a broken container start. Raised again to 300 for the second dev layout:
# `layout.apply` is the API anyone adding a third would reach for first, and it
# replaces the tab it is handed, so applying a layout with it restarts the
# agent -- a rule that has to be read before the code, not after. Raised to 305
# when the two layouts went onto one key: the rule that matters is that every
# step converges rather than builds, because four separate roots each added a
# tab and every one of them read as a plausible way to write it. `pane move`
# answering a refusal with a SUCCESS reply is the trap under all of them, and an
# agent that does not know it will read the tab id back out of that reply.
# Raised to 312 for the herdr bar widget: it is the first QML this repository
# ships and nothing on the machine lints QML, so the ways it breaks are all
# silent -- an id that disagrees across three files, a capability that moves it
# off the bar, a plugin directory DMS never scanned -- and an agent that does
# not know the check is a plugin reload will conclude the widget is fine
# because `just validate` passed. Raised to 316 for DataGrip: it is the one piece
# of software here that no package manager can install, so the Brewfile line an
# agent would reach for first is not an oversight to correct but the mistake the
# entry warns against -- the Homebrew cask is macOS-only and the Flathub build is
# retired, and both facts are invisible from inside this repository. Raised to
# 331 for parked background work: herdr's `idle` means no foreground turn and
# not no work, upstream settled that deliberately with a regression test, and
# the two rules an agent needs before touching this are both counter-intuitive
# -- the recency stamp now has two writers on one clock, and the obvious
# agent-agnostic predicate for "still busy" was measured false, so an agent that
# does not know will delete the per-agent probes and rebuild a process-tree walk
# that reads true through every foreground tool call. Raised to 354 for the
# herdr server unit, whose three rules are each the opposite of the obvious move:
# `KillMode=mixed` looks like a stylistic choice and is the entire fix, an
# ExecStart naming the Homebrew binary looks correct and fails the build, and the
# recency stamp lost its expiry window rather than gaining one -- an agent tidying
# up would restore all three and the damage would surface only at the next
# reboot, one workspace at a time. Raised to 360 for the scaffold force pass,
# which reverses the direction of the whole dotfile mechanism for one manifest
# kind: everywhere else a live edit wins and the image yields, and an agent that
# does not know scaffolding is the exception will read a critical audit line as
# "someone edited this" when it means "chezmoi stopped writing this", and will
# reach for the skip that caused the failure rather than the force that fixed it.
# Raised to 366 for niri `input` ownership, where the omission IS the mechanism:
# `dms.kdl` lists every DMS fragment but one, so the rule is invisible in the file
# it governs and an agent tidying the list would add `dms/input.kdl` back and
# silently delete the touchpad and mouse tuning, with `niri validate` still
# exiting 0.
# Raised to 390 for the removal tail, the one place in this repository where an
# agent can destroy work that does not come back -- `sudo rm -rf` and
# `branch -D` -- and where both rules read as mistakes to anyone tidying up: the
# `--force` retry that looks correct answers a refusal that is not the one being
# hit, and the branch has to be deleted BEFORE the checkout it belongs to, which
# looks like the wrong order right until the workspace close takes the popup
# with it. The remote half is there for the same reason: it is the only action
# in this repository that changes a repository other people share, and the rule
# that keeps it safe -- one answer covering both sides, never the local half
# alone -- reads as careless to anyone who has not seen what deleting the local
# half on its own leaves behind.
# Raised to 398 for the herdr unit's two OOM directives, the fourth and fifth
# rules about this unit that read as the opposite of the obvious move. `OOMPolicy` is
# the one systemd default in the file that is actively wrong here -- everywhere
# else `stop` on an OOM kill is what you want, and it is wrong only because this
# unit deliberately owns a cgroup full of the user's own work rather than a
# worker it can afford to lose. And the pair is not one rule twice: an agent who
# understands the first will conclude the second is redundant, because
# "OOMPolicy already handles OOM" is true of the kernel killer and false of
# systemd-oomd, which selects a cgroup rather than a process and so cannot be
# governed by a per-process policy at all. Deleting either one costs every open
# workspace, at a moment when the machine is already failing for another reason.
# Raised to 410 for the multi-agent slot model, where the obvious tidy-up is the
# thing that breaks it. A slot is a tab whose LABEL is the agent's own kind, and
# `agent 1` / `agent 2` is what anyone would reach for instead -- it reads as the
# general case. It is not: every lookup in `layout-common.sh` is an equality test
# on that label, the layouts converge because a second run finds exactly what the
# first built, and a label that changes when the agent does breaks all of it at
# once. The legacy `main` half is the same trap from the other side: it looks
# like dead compatibility code, and deleting it makes every workspace laid out
# before the rename find no agent and build a SECOND agent tab beside the running
# one. And the stamp's agent key looks redundant beside its checkout key right up
# until a codex finish answers the resume question for claude, in a checkout
# claude has never run in, which drops that pane to a bare shell. Raised to 420
# for the two halves of making those agents visible, each of which reads as
# optional and is not. A slot is a LABELLED tab: an agent started into a split of
# another agent's tab has no label, so every lookup steps past it and the tab bar
# names one agent while two run -- claiming is what makes it a slot, and it has
# to happen at server start too, because herdr restores a session with its agents
# and a restored workspace carries whatever labels it was saved with. And the
# agent state on a picker row knowingly changes the cache on every turn. That
# reload-under-the-reader cost is recorded rather than hidden, and `prefix+a`
# remains the detailed per-pane view. The third line of that entry is the font
# pin: the widget draws those agents as codicon marks and
# asks for the FILE, because three copies of `FiraCode Nerd Font` are installed
# under one family name and only the image's carries codicons -- by name every
# mark is a tofu box, and nothing on this machine lints QML or can tell a
# missing glyph from a drawn one.
(( $(wc -l < AGENTS.md) <= 423 ))

# README.md is a landing pad into docs/ and nothing else. Capped because it grows
# back otherwise: it was 855 lines covering fourteen concerns before the handbook
# existed, which is how install and recovery -- the two things wanted under time
# pressure -- ended up in the last 14% of the file. The handbook itself has no
# cap; a page may be as long as its subject. The front door may not.
(( $(wc -l < README.md) <= 170 ))

# The agent guide, the landing pad and the handbook state policy; nothing else
# proves their references still exist, so they silently rot as recipes and paths
# are renamed. Assert the two classes that are mechanically checkable: every
# `just`/`wjust` target named must be a real recipe, and every repo-root-relative
# path cited must exist. Prose stays the author's problem; dangling pointers do
# not. The path alternation must name the CURRENT top-level trees -- it named the
# deleted ones for two commits and matched nothing under either new tree.
agents_stale=0
recipes=" $(just --summary) "
# The prose files, the handbook, and the checked-in agent commands. A slash
# command is prose that an agent executes, so a stale recipe or path in one is
# worse than in AGENTS.md: nothing reads it until the moment it is being relied
# on. Each tree gets its own floor rather than one combined count, which would
# let a whole tree vanish while the others held the total up.
docs=(AGENTS.md README.md)
doc_pages=()
while IFS= read -r f; do doc_pages+=("$f"); done < <(find docs -name '*.md' | sort)
(( ${#doc_pages[@]} >= 15 )) \
    || { echo "handbook pages missing under docs/ (found ${#doc_pages[@]})" >&2; exit 1; }
commands=()
while IFS= read -r f; do commands+=("$f"); done < <(find .claude/commands -name '*.md' 2>/dev/null | sort)
(( ${#commands[@]} > 0 )) || { echo "no agent commands found under .claude/commands" >&2; exit 1; }
docs+=("${doc_pages[@]}" "${commands[@]}")
while read -r target; do
    [[ $recipes == *" $target "* ]] && continue
    echo "docs reference unknown recipe: just $target" >&2
    agents_stale=1
done < <(grep -ohE '`w?just [a-z][a-z0-9-]*' "${docs[@]}" \
    | sed -E 's/`w?just //' | sort -u)
while read -r path; do
    [[ -e $path ]] && continue
    echo "docs reference missing path: $path" >&2
    agents_stale=1
done < <(grep -ohE '`?(system_files|build_files|tooling|docs)/[A-Za-z0-9._/-]*' "${docs[@]}" \
    | tr -d '`' | sed 's/[.,]$//' | sort -u)
(( agents_stale == 0 ))

# The handbook is twenty files that link to each other, and the path gate above
# only sees a link whose target starts with a top-level tree name -- a sibling
# link like (architecture.md) is invisible to it. Resolve every relative target
# instead, and forbid a cross-file anchor outright: a fragment into another page
# looks fine forever after the heading it names is renamed, so one file is one
# address. Same-file anchors stay allowed and are checked against the headings.
# Runs over the same file set as the gates above rather than docs/ alone: today
# AGENTS.md carries no links at all, and the point is that adding one does not
# quietly land outside the check.
link_failures=0
while IFS= read -r f; do
    dir="$(dirname "$f")"
    while IFS= read -r target; do
        [[ -z $target ]] && continue
        case "$target" in http://* | https://* | mailto:*) continue ;; esac
        path="${target%%#*}"
        if [[ -z $path ]]; then
            # Pure fragment: GitHub slugs a heading by lowercasing, dropping
            # everything but alphanumerics, spaces and hyphens, then joining on
            # hyphens.
            grep -qxF "${target#\#}" < <(grep -oE '^#{1,6} .*' "$f" \
                | sed -E 's/^#+ //; s/`//g' \
                | tr '[:upper:]' '[:lower:]' \
                | sed -E 's/[^a-z0-9 -]//g; s/ /-/g') \
                || { echo "docs link to missing anchor: $f -> $target" >&2; link_failures=1; }
            continue
        fi
        if [[ $target == *'#'* ]]; then
            echo "docs link carries a cross-file anchor: $f -> $target" >&2
            link_failures=1
        fi
        [[ -e $dir/$path ]] \
            || { echo "docs link to missing path: $f -> $path" >&2; link_failures=1; }
    done < <(grep -ohE '\]\([^)]+\)' "$f" | sed -E 's/^\]\(//; s/\)$//')
done < <(printf '%s\n' "${docs[@]}")
(( link_failures == 0 ))

# AI CLI config seeds must be secret-free by construction: the scrub filters
# strip secrets/machine-state on capture, and these positive gates assert the
# committed seeds (visible to CI even when live files are absent). gitleaks
# above is the generic backstop; these catch the tool-specific shapes it misses
# (e.g. the dash-broken context7 key gitleaks does not flag).
ai_seeds=system_files/usr/share/workstation-os-image/dotfiles
assert_absent() {
    # Fail if the extended-regexp $1 matches (case-insensitively) anywhere in
    # file $2. A plain `! grep` would be exempt from errexit and silently pass,
    # so branch.
    if grep -qiE "$1" "$2"; then
        echo "Secret/machine-state leaked into $2 (matched: $1)" >&2
        exit 1
    fi
}
claude_settings="$ai_seeds/dot_claude/create_settings.json"
jq -e 'has("env") | not' "$claude_settings" >/dev/null
# Help Scout leaks as the env-var values (HELPSCOUT_APP_*) AND as the lowercase
# plugin/marketplace identifiers (helpscout-navigator, help-scout-mcp).
assert_absent 'helpscout|help-scout' "$claude_settings"
assert_absent 'enabledPlugins|extraKnownMarketplaces' "$claude_settings"
assert_absent '/(var/)?home/' "$claude_settings"
# opencode.json is generated by the fusion installer (just ai-tools-install), not
# captured; only our context7 mcp fragment is tracked, and its key must be a
# {file:}/{env:} placeholder, never a literal.
jq -e '.mcp.context7.headers.CONTEXT7_API_KEY
        | startswith("{file:") or startswith("{env:")' \
    tooling/data/ai-tools/opencode-mcp-fragment.json >/dev/null
codex_config="$ai_seeds/dot_codex/create_config.toml"
# Only the canonical, secret-free OpenAI developer-docs MCP table may survive
# codex scrub.
if grep '^\[' "$codex_config" \
    | grep -Fvx \
        -e '[mcp_servers.openaiDeveloperDocs]' >/dev/null; then
    echo "Unapproved table leaked into $codex_config" >&2
    exit 1
fi
[[ $(grep -Fxc '[mcp_servers.openaiDeveloperDocs]' "$codex_config") -eq 1 ]]
grep -Fqx 'url = "https://developers.openai.com/mcp"' "$codex_config"
assert_absent 'HELPSCOUT_APP_(ID|SECRET)[[:space:]]*=' "$codex_config"
assert_absent '/(var/)?home/' "$codex_config"
assert_absent \
    '(\.local/share/opencode/auth\.json|\.codex/auth\.json|\.claude/\.credentials\.json)' \
    tooling/data/dotfiles.manifest
# The portable bundle is a projection of the seeds; it too must carry no key or
# absolute home path.
if grep -rIliE 'ctx7sk-|/home/[a-z]' \
    tooling/ai/ai-cli-setup/config tooling/ai/ai-cli-setup/opencode-mcp-fragment.json \
    >/dev/null 2>&1; then
    echo "Secret or absolute home path leaked into tooling/ai/ai-cli-setup" >&2
    exit 1
fi

# Claude Code's auto mode rewrites autoMode.environment for whichever project it
# is run in: organisation, private repository names, secret names, internal
# domains. It regenerates constantly, this repository is public, and gitleaks
# does not recognise any of it as a secret, so assert the scrub actually held.
jq -e '.autoMode.environment == null' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_claude/create_settings.json >/dev/null
jq -e '.autoMode.environment == null' \
    tooling/ai/ai-cli-setup/config/claude/settings.json >/dev/null

# Image-owned scaffolding, one mechanism across four files. The manifest says
# which targets the image owns; the generated list is the only copy of that
# fact on the machine, because tooling/data/ never reaches a layer; the apply
# wrapper forces exactly what the list names; and the audit reports what has
# diverged. A scaffold entry missing from the list gets `yes s` instead, so the
# first out-of-band write to it freezes it at that version on every boot
# afterwards with nothing failing -- which is how a two-day-old spaces.sh came
# to abort on a constant its current library no longer defined, and report herdr
# as not running while herdr was running.
tooling/dotfiles/scaffold-list --check
scaffold_list=system_files/usr/share/workstation-os-image/scaffold-targets
chezmoi_apply=system_files/usr/libexec/workstation-chezmoi-apply
require_file "$scaffold_list"
require_file "$chezmoi_apply"
grep -qx 'scaffold=/usr/share/workstation-os-image/scaffold-targets' "$chezmoi_apply"
grep -q 'chezmoi apply --force --no-tty --keep-going' "$chezmoi_apply"
# The audit reads the manifest itself rather than the baked list, so gate that
# it still selects by kind instead of naming paths again.
grep -q 'kind == scaffold' tooling/audit/dotfiles

# Worktree untracked-file propagation: every creation path (herdr, Claude Code,
# the post-checkout hook) reaches the same committed .worktreeinclude through
# `git worktree add`, so assert the wiring that keeps them in sync.
grep -q 'workstation-worktree-sync' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/template/hooks/create_executable_post-checkout
grep -q 'satococoa/tap/git-worktreeinclude' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/homebrew/create_Brewfile
grep -q 'templateDir' system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config
[[ -x tooling/worktree/init ]]

# The version in the hook's ownership sentinel is what lets `just worktree-init`
# replace an older copy of the hook in a repository that already has one. Without
# it every edit below this line is dead code in every existing repository.
grep -qE '^# workstation-worktree-init: managed post-checkout hook v[0-9]+$' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/template/hooks/create_executable_post-checkout

# One mechanism, three files. `git lfs install` writes its own post-checkout into
# the same slot and refuses to merge with an incumbent, and init.templateDir makes
# ours the incumbent in every new clone -- so the managed hook is the only thing
# carrying Git LFS here. The chain, the filter config the chain resolves content
# through, and the binary both of them call must ship together or LFS is silently
# half-configured.
grep -q 'git lfs post-checkout' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/template/hooks/create_executable_post-checkout
grep -q '^\[filter "lfs"\]' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config
grep -qE '^git-lfs([[:space:]]|$)' build_files/packages/dev.list

tooling/worktree/test-init

# The `dev` wrapper's --mount strings have to satisfy the devcontainer CLI's own
# grammar, which takes type/source/target plus an optional external= and rejects
# anything else at parse time. A `,readonly` suffix once slipped in here and
# broke `dev` for every project on the machine; `fish --no-execute` cannot see
# inside a string literal, so assert the grammar itself. Fish interpolation --
# "(command)" and $var -- collapses to a placeholder first.
dev_fish=system_files/usr/share/workstation-os-image/dotfiles/dot_config/fish/functions/create_dev.fish
require_file "$dev_fish"
dev_mounts=0
while read -r dev_mount; do
    dev_mounts=$((dev_mounts + 1))
    [[ $dev_mount =~ ^type=(bind|volume),source=[^,]+,target=[^,]+(,external=(true|false))?$ ]] \
        || { echo "not valid devcontainer --mount syntax: $dev_mount" >&2; exit 1; }
done < <(
    grep -oE '"type=(bind|volume),.*"' "$dev_fish" \
        | sed -E 's/"\(.*\)"/X/; s/\$[A-Za-z_][A-Za-z0-9_]*/X/g; s/^"//; s/"$//'
)
(( dev_mounts >= 6 ))

# One mechanism, two files: `dev nvim` creates the per-project stores and
# `nvim-store-gc` removes the abandoned ones, so they have to agree on where the
# stores live and on the one directory in there that is NOT a store. Disagreeing
# spellings would not fail anything -- the collector would simply find nothing,
# or classify the shared toolchain as an orphan and delete it out from under
# every running container. See docs/design-records/dev-nvim-store.md.
nvim_gc=tooling/dev/nvim-store-gc
require_file "$nvim_gc"
grep -q '"[$]HOME/[.]local/share/dev-nvim/"' "$dev_fish"
grep -q 'store_root="[$]HOME/[.]local/share/dev-nvim"' "$nvim_gc"
grep -q 'dev-nvim/toolchain"$' "$dev_fish"
grep -q '[$]name == toolchain' "$nvim_gc"
# The store records its own checkout so the collector can be exact rather than
# hashing candidate paths; without the writer, every new store looks legacy.
grep -q '>"[$]store/[.]root"' "$dev_fish"
grep -q '[$]path/[.]root' "$nvim_gc"

# One mechanism, two files: `dev` mounts a linked worktree's common .git, which
# the CLI honours only where the checkout records a RELATIVE path, so the git
# config seed is what makes the flag do anything at all.
grep -q -- '--mount-git-worktree-common-dir' "$dev_fish"
grep -q 'useRelativePaths = true' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config

# `up` and `exec` both derive the container workspace path from that flag, so a
# call that omits it chdirs into a path the container does not have.
while read -r dev_call; do
    # The single quotes are the point: match the literal fish variable name.
    # shellcheck disable=SC2016
    [[ $dev_call == *'$dcflags'* ]] \
        || { echo "devcontainer call without \$dcflags: $dev_call" >&2; exit 1; }
done < <(grep -E 'devcontainer (up|exec) --workspace-folder' "$dev_fish")

# One mechanism, two files: the local lint and the CI step must read the same
# script list and the same shellcheck version, or a rule passes on one side and
# fails on the other. That is not hypothetical -- the two kept separate lists
# for long enough that seventeen dev-flow scripts were linted locally and
# nowhere else, under a comment asserting they could not diverge.
require_file tooling/validate/shell-files
require_file tooling/data/shellcheck-version
[[ -x tooling/validate/shell-files ]]
grep -q 'tooling/validate/shell-files' tooling/validate/all
grep -q 'tooling/validate/shell-files' .github/workflows/build.yml
grep -q 'tooling/data/shellcheck-version' tooling/validate/all
grep -q 'tooling/data/shellcheck-version' .github/workflows/build.yml
grep -q -- '-x --source-path=SCRIPTDIR' tooling/validate/all
grep -q -- '-x --source-path=SCRIPTDIR' .github/workflows/build.yml
[[ $(cat tooling/data/shellcheck-version) =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]

# The herdr bar widget spans four files that have to agree, and every way they
# can disagree is silent: a plugin whose id is missing from the bar config loads
# and never renders, a bar id with no enablement seed renders nothing, a stray
# "launcher" capability routes the widget off the bar entirely, and a renamed
# dev-flow script leaves a pill that polls an empty list forever. Nothing here
# parses QML -- there is no qmllint on this machine and the widget is the only
# QML the repo ships -- so these are the only mechanical checks it gets.
herdr_widget=system_files/usr/share/workstation-os-image/dotfiles/dot_config/DankMaterialShell/plugins/herdrJobs
herdr_widget_seed=system_files/usr/share/workstation-os-image/dotfiles/dot_config/DankMaterialShell/create_plugin_settings.json
dev_flow=system_files/usr/share/workstation-os-image/dotfiles/dot_config/herdr/plugins/dev-flow
require_file "$herdr_widget/plugin.json"
require_file "$herdr_widget_seed"
require_file "$dev_flow/executable_focus-space.sh"
herdr_widget_id=$(jq -r '.id' "$herdr_widget/plugin.json")
[[ -f $herdr_widget/$(jq -r '.component' "$herdr_widget/plugin.json") ]]
# index() answers 0 for a first-element hit, which jq -e reads as false, so both
# tests compare against null rather than relying on truthiness.
jq -e '(.capabilities | index("dankbar-widget") != null)
       and (.capabilities | index("launcher") == null)' "$herdr_widget/plugin.json" >/dev/null
jq -e --arg id "$herdr_widget_id" '.[$id].enabled == true' "$herdr_widget_seed" >/dev/null
jq -e --arg id "$herdr_widget_id" \
    '[.barConfigs[]
      | (.leftWidgets // []) + (.centerWidgets // []) + (.rightWidgets // [])
      | .[] | if type == "string" then . else .id end] | index($id) != null' \
    system_files/usr/share/workstation-os-image/dms-settings.json >/dev/null
# One mechanism, two files: the widget is a view of the space picker's rows, so
# it shells out to the picker's own script rather than asking herdr again.
grep -q 'spaces.sh --json' "$herdr_widget/HerdrJobsWidget.qml"
grep -q 'focus-space.sh' "$herdr_widget/HerdrJobsWidget.qml"
grep -q '"--json"' "$dev_flow/executable_spaces.sh"

# Removing a checkout spans three scripts and the manifest, and every way they
# can disagree is silent or destructive. merge-state.sh is sourced, not run, so
# a missing manifest entry ships two popups that die at their first line on a
# fresh machine. A second base resolver makes the branch a PR is opened against
# and the branch the removal checks it against two different answers. A second
# `branch -D` is a branch deleted without the merge check that earns it, and a
# second `sudo rm -rf` is that command without the guard proving its argument is
# a checkout.
require_file "$dev_flow/merge-state.sh"
grep -q '^scaffold|\.config/herdr/plugins/dev-flow/merge-state\.sh|' tooling/data/dotfiles.manifest
for sourcing in executable_checkout-remove.sh executable_worktree-ship.sh; do
    # The single quotes are the point: these are lines of another script being
    # matched, not expressions to expand here.
    # shellcheck disable=SC2016
    grep -qF '. "$plugin_dir/merge-state.sh"' "$dev_flow/$sourcing"
done
[[ $(grep -rlc 'refs/remotes/origin/HEAD' "$dev_flow" | wc -l) -eq 1 ]]
# Two callers now, and the pair is the assertion: the popup that removes the
# checkout in front of you, and the sweep that covers everything no popup can
# reach. Naming both keeps the original point -- a third one cannot appear
# quietly -- while allowing the second that was added on purpose.
[[ $(grep -rl 'branch -D' "$dev_flow" | sort | tr '\n' ' ') == "$dev_flow/executable_checkout-remove.sh $dev_flow/executable_cleanup-residue.sh " ]]
[[ $(grep -rl 'sudo rm -rf' "$dev_flow" | sort | tr '\n' ' ') == "$dev_flow/executable_checkout-remove.sh $dev_flow/executable_cleanup-residue.sh " ]]
# Deleting a branch on the remote is the one action here that reaches a
# repository other people share, so it is allowed exactly one caller, and that
# caller is reachable only from the merged verdict that also deletes the local
# branch: one answer, both sides, or neither. Requiring GitHub's `MERGED` for
# the remote half instead is what the first version did, and it is what left
# eight remote branches whose checkout and local branch were both already gone --
# reachable by no popup and no sweep, because deleting the local side is what
# makes the remote side invisible. `delete_remote` is asserted to have exactly
# one assignment so that a later edit cannot reintroduce a second, weaker path
# to the same push.
[[ $(grep -rl 'push origin --delete' "$dev_flow" | sort | tr '\n' ' ') == "$dev_flow/executable_checkout-remove.sh $dev_flow/executable_cleanup-residue.sh " ]]
# shellcheck disable=SC2016 # literal fragment of the guarded script
grep -qF '[ "$verdict" = merged ]' "$dev_flow/executable_checkout-remove.sh"
[[ $(grep -c 'delete_remote=yes' "$dev_flow/executable_checkout-remove.sh") -eq 1 ]]
# The guard itself: root is only ever pointed at a directory inside a
# `__worktrees` parent, under $HOME, that is not the repository root.
# shellcheck disable=SC2016 # literal fragments of the guarded script
for guard in '__worktrees}" = "$parent"' '"$resolved" = "$repo"' '"$home"/}" = "$resolved"'; do
    grep -qF "$guard" "$dev_flow/executable_checkout-remove.sh"
done

# A checkout parked on background work spans five files that have to agree, and
# every way they can disagree is silent: herdr calls the pane idle either way,
# so a probe that never runs, a state word the row builder does not emit, or a
# colour the widget does not know produce exactly the behaviour this feature
# exists to replace, with nothing to show that it failed.
probes=system_files/usr/libexec/workstation-agent-probes
require_file "$probes/lib.sh"
require_file docs/subsystems/agent-probes.md
require_file tooling/data/agent-probe-registry
# Assert coverage, not success: require_file above proves the glob is non-empty,
# because a loop fed by a find that matches nothing passes without running.
require_file "$probes/probes/claude"
for probe in "$probes"/probes/*; do
    probe_name=$(basename "$probe")
    [[ -x $probe ]]
    grep -q "^## $probe_name" docs/subsystems/agent-probes.md
    grep -q "^$probe_name|probe|" tooling/data/agent-probe-registry
done
# The registry is the audit's list of what is covered and what is knowingly not,
# so a line claiming a probe must have one.
while IFS='|' read -r registry_agent registry_kind _; do
    [[ $registry_agent == \#* || -z $registry_agent ]] && continue
    [[ $registry_kind != probe ]] || require_file "$probes/probes/$registry_agent"
    [[ $registry_kind == probe || $registry_kind == none ]]
done < tooling/data/agent-probe-registry
# Both plugin scripts define a no-op fallback for the machine where the image
# half is absent, so grepping for the function name alone passes in the state
# where lib.sh is never sourced and the whole feature is quietly dead. Gate the
# source line itself.
grep -q '^agent_parked_probe()' "$probes/lib.sh"
grep -q '^agent_parked_write()' "$probes/lib.sh"
for wired in executable_spaces.sh executable_agent-freshness.sh; do
    grep -qF '. /usr/libexec/workstation-agent-probes/lib.sh' "$dev_flow/$wired"
    grep -q 'agent_parked_probe' "$dev_flow/$wired"
done
grep -q 'sweep_parked' "$dev_flow/executable_spaces.sh"
grep -q 'agent_parked_write' "$dev_flow/executable_spaces.sh"

# More than one agent per checkout spans the plugin, the key map and the
# manifest, and every way they can disagree is silent. A slot is a tab whose
# LABEL is the agent's own name, which is what makes the set of agents durable
# (herdr persists a tab's custom_name) and every lookup an equality test.
#
# AGENT_KINDS is that vocabulary, and agent_command is the only thing that turns
# one back into a command line. A kind listed with no arm there is a tab that
# gets created and then handed nothing: agent-add.sh refuses it at the last
# step, and relaunch_role_pane leaves the pane at a shell forever.
herdr_config_seed=system_files/usr/share/workstation-os-image/dotfiles/dot_config/herdr/create_config.toml
require_file "$herdr_config_seed"
agent_kinds=$(sed -n 's/^AGENT_KINDS="\(.*\)"$/\1/p' "$dev_flow/layout-common.sh")
[[ -n $agent_kinds ]] || { echo "AGENT_KINDS is missing from layout-common.sh" >&2; exit 1; }
agent_command_body=$(sed -n '/^agent_command() {/,/^}/p' "$dev_flow/layout-common.sh")
[[ -n $agent_command_body ]] || { echo "agent_command is missing from layout-common.sh" >&2; exit 1; }
for agent_kind in $agent_kinds; do
    grep -q "^  $agent_kind)" <<<"$agent_command_body" ||
        { echo "AGENT_KINDS names $agent_kind but agent_command has no arm for it" >&2; exit 1; }
done
# The reverse: the stamp that decides whether to resume is keyed per agent, and
# claude_command was the single-agent version that read it keyed on the checkout
# alone. Two builders would put `claude --continue` back into a checkout where
# only codex ever ran, which fails that pane into a bare shell.
if grep -rq 'claude_command' "$dev_flow"; then
    echo "the single-agent command builder is back: $dev_flow" >&2
    exit 1
fi
# shellcheck disable=SC2016 # literal fragment of the guarded script
grep -qF 'agent_finished_write "$checkout" "$agent"' "$dev_flow/executable_spaces.sh"
# shellcheck disable=SC2016 # literal fragment of the guarded script
grep -qF 'agent_finished_write "$(agent_checkout_key "$checkout")" "$agent"' "$dev_flow/executable_agent-freshness.sh"
# A tab running an agent under the editor's or the terminal's name is claimed as
# that agent's slot before either layout resolves anything. Without it the split
# layout adopts a live agent as its terminal and folds it into the sliver under
# the editor -- which is what a hand-started second agent actually hit.
#
# The pane half of the same rule: an agent started into a split of another
# agent's tab is not a slot either -- prefix+m steps past it, agent-add offers
# its kind again, and the tab bar names one agent while two are running.
for claiming in executable_layout.sh executable_layout-split.sh; do
    # shellcheck disable=SC2016 # literal fragment of the guarded script
    grep -qF 'claim_agent_tabs "$workspace"' "$dev_flow/$claiming"
    # shellcheck disable=SC2016 # literal fragment of the guarded script
    grep -qF 'claim_agent_panes "$workspace"' "$dev_flow/$claiming"
done
# A layout run is not the only way a workspace acquires an agent: herdr restores
# a session with its agents, and a checkout restored from session.json carries
# whatever labels it was saved with. The startup pass is what converges those --
# both claims, over every workspace, once per server start. Wired in the manifest
# or it never runs at all, and herdr reports nothing when a hook is absent.
for startup_claim in claim_legacy_agent_tabs claim_agent_panes; do
    grep -q "^$startup_claim() {" "$dev_flow/layout-common.sh" ||
        { echo "$startup_claim is missing from layout-common.sh" >&2; exit 1; }
    grep -q "$startup_claim" "$dev_flow/executable_agent-claim.sh" ||
        { echo "agent-claim.sh no longer runs $startup_claim" >&2; exit 1; }
done
grep -q 'agent-claim.sh' "$dev_flow/herdr-plugin.toml"
# The startup pass claims tabs and panes but never a `nvim` or `term` tab: that
# rename takes the editor or the shell away and only a layout run builds the
# missing one back, which is why claim_agent_tabs lives in the layouts instead.
# Comments stripped first: the script explains at length why it leaves those
# tabs alone, and a gate that reads prose fails on the explanation.
if grep -vE '^[[:space:]]*#' "$dev_flow/executable_agent-claim.sh" |
    grep -qE 'claim_agent_tabs|nvim|term'; then
    echo "agent-claim.sh claims a role tab it cannot rebuild: $dev_flow" >&2
    exit 1
fi
# Which agents a space runs, with each agent's state, on all three surfaces.
#
# A row is a checkout and its state word is herdr's rollup, so with two agents
# the word alone cannot say which one wants you. Space rows remain one per
# checkout, but their marks and names now use pane state. The picker on prefix+a
# stays the detailed per-pane view.
# shellcheck disable=SC2016 # literal fragment of the guarded jq program
grep -qF 'agents: agents,' "$dev_flow/executable_spaces.sh"
grep -qF 'kind: .agent,' "$dev_flow/executable_spaces.sh"
# shellcheck disable=SC2016 # literal fragment of the guarded jq program
grep -qF 'state: (if $parked_panes[.pane_id] == true' "$dev_flow/executable_spaces.sh"
# Appended, never inserted: the picker cache is read positionally. Names remain
# field 8 and aligned states append as field 9, so existing readers keep their
# indices. Newlines and indentation are squeezed out first.
# shellcheck disable=SC2016 # literal fragment of the guarded jq program
tr -s '[:space:]' ' ' < "$dev_flow/executable_spaces.sh" |
    grep -qF '[ .workspace_id, (.marked_state | pad(8)), (((if .is_worktree then " └ " else "" end) + .label) | pad(38)), .checkout, .repo, (.is_worktree | tostring), .label, ([.agents[].kind] | join(" ") | pad($agent_width)), ([.agents[].state] | join(" ")) ]' ||
    { echo "the picker cache columns moved; every positional reader takes a fixed index" >&2; exit 1; }
grep -q 'modelData.agents' "$herdr_widget/HerdrJobsWidget.qml"
grep -qF 'color: root.stateColor(modelData.state)' "$herdr_widget/HerdrJobsWidget.qml" ||
    { echo "the widget no longer colours each agent mark from its own state" >&2; exit 1; }
# shellcheck disable=SC2016 # literal fragment of the guarded awk program
grep -qF 'coloured_agents($8, $9)' "$dev_flow/executable_spaces.sh" ||
    { echo "the space picker no longer colours each agent name from its own state" >&2; exit 1; }
# The widget draws them as codicon marks, and that spans three files: the mark
# map here, the font the build installs, and the build gate that asserts the
# codepoints are in it. The widget asks for the FILE and not the family, because
# three copies of `FiraCode Nerd Font` are installed under one name and only the
# image's carries the codicons -- by name it resolves to one of the others and
# every mark is a tofu box, silently.
firacode_dir=/usr/share/fonts/firacode-nerd-fonts
grep -qF "file://$firacode_dir/FiraCodeNerdFont-Regular.ttf" "$herdr_widget/HerdrJobsWidget.qml" ||
    { echo "the widget no longer pins the codicon font by path" >&2; exit 1; }
grep -qF "$firacode_dir" build_files/00-toolchain.sh ||
    { echo "the build no longer installs the font the widget pins: $firacode_dir" >&2; exit 1; }
grep -qF "':charset=ec82 ec81 ec67'" build_files/99-check-build.sh ||
    { echo "the codicon agent marks are no longer gated in the image" >&2; exit 1; }
for mark in 'uec82' 'uec81' 'uec67'; do
    grep -qF "\\$mark" "$herdr_widget/HerdrJobsWidget.qml" ||
        { echo "the widget lost the agent mark \\$mark" >&2; exit 1; }
done
# The kind has to reach the RENDERED row, not just the jq array behind it: the
# picker hides field 1 and shows what the printf builds, so a column dropped
# there is invisible while the data still looks right.
# shellcheck disable=SC2016 # literal fragment of the guarded script
grep -qF '{ printf "%s\t%-8s %-8s %-34s %s\n", $1, $2, $3, $4, $5 }' "$dev_flow/executable_agents.sh" ||
    { echo "the agent picker no longer renders the kind as its own column" >&2; exit 1; }
# claim_agent_panes reaches only into a tab that is already an agent slot. The
# split layout keeps the editor and the shell as PANES of a tab called `dev`, and
# a restored session has no pane labels at all -- session.json persists a tab
# custom_name but of a pane only cwd and agent session -- so without this filter
# the startup pass moves a role pane out of a workspace nothing will rebuild.
# shellcheck disable=SC2016 # literal fragment of the guarded jq program
grep -qF 'and (.tab_id | IN($agent_tabs[]))' "$dev_flow/layout-common.sh" ||
    { echo "claim_agent_panes is no longer restricted to agent tabs" >&2; exit 1; }
# One key reaches every agent, so it asks for the next slot rather than for a
# label. Left pointing at a label, prefix+m would reach whichever agent happened
# to be named there and nothing else.
grep -q 'focus-tab.sh agent' "$herdr_config_seed"
grep -q 'agent-add.sh' "$herdr_config_seed"
grep -q 'agent-add.sh' "$dev_flow/herdr-plugin.toml"
# Every script of the plugin needs a manifest entry: herdr discovers the plugin
# from the linked directory, so one missing file is a popup or a sourced library
# that dies at its first line on a fresh machine.
for plugin_script in "$dev_flow"/*.sh; do
    grep -qF "|dot_config/herdr/plugins/dev-flow/$(basename "$plugin_script")|" tooling/data/dotfiles.manifest ||
        { echo "dev-flow script has no manifest entry: $plugin_script" >&2; exit 1; }
done

# The herdr server owns its own cgroup, and one directive is the whole reason.
# Left at systemd's default of control-group, the unit SIGTERMs the server and
# every pane it owns in one broadcast; a pane that handles it first looks like an
# ordinary pane exit, so herdr drops the now-empty workspace and then persists
# the pruned state. Nothing catches that until the next reboot, and what it
# costs is a workspace, silently -- hence a gate rather than a comment.
herdr_unit=system_files/usr/lib/systemd/user/workstation-herdr-server.service
herdr_exec=system_files/usr/libexec/workstation-herdr-server
require_file "$herdr_unit"
require_file "$herdr_exec"
grep -q '^KillMode=mixed$' "$herdr_unit"
# Owning that cgroup makes every pane a process of this unit, which turns
# systemd's default `OOMPolicy=stop` into "one OOM-killed build SIGKILLs the work
# in every other pane" -- measured twice, 2026-09-07 and 2026-09-08. The oomd half
# is a second, independent route: systemd-oomd selects a whole cgroup, so
# OOMPolicy cannot cover it, and every user slice already carries
# ManagedOOMMemoryPressure=kill at 80%. Both are one line, both read as noise to
# anyone tidying the unit, and neither failure appears until the machine is
# already out of memory -- hence gates rather than comments.
grep -q '^OOMPolicy=continue$' "$herdr_unit"
grep -q '^ManagedOOMPreference=avoid$' "$herdr_unit"
# ExecStart cannot be the Homebrew path: 99-check-build.sh runs
# `systemd-analyze verify` over these units at build time, and verify exits 1 on
# an ExecStart command that is not executable in the layer. The ExecCondition is
# the other half -- a machine with no herdr yet SKIPs instead of failing forever.
grep -q '^ExecStart=/usr/libexec/workstation-herdr-server$' "$herdr_unit"
grep -q '^ExecCondition=/usr/bin/test -x /home/linuxbrew/.linuxbrew/bin/herdr$' "$herdr_unit"
# One mechanism, three files: a client that reaches a running server attaches to
# it, and a client that does not forks its own back into foot-server.service's
# cgroup, which is the state this unit exists to leave. Both paths that open a
# session therefore start the unit first, and neither failure is visible.
#
# The Mod+Shift+T half is the helper rather than the bind: the bind spawns it
# and nothing else, so the assertion follows the systemctl call into the file
# that now makes it. The bind is still gated -- on naming the helper -- because
# a bind that went back to spawning a terminal directly would satisfy neither.
herdr_binds=system_files/usr/share/workstation-os-image/niri/includes/binds.kdl
herdr_window=system_files/usr/libexec/workstation-herdr-window
herdr_dev=system_files/usr/share/workstation-os-image/dotfiles/private_dot_local/bin/create_executable_workstation-dev
require_file "$herdr_binds"
require_file "$herdr_window"
require_file "$herdr_dev"
grep -q 'spawn "/usr/libexec/workstation-herdr-window"' "$herdr_binds"
for launcher in "$herdr_window" "$herdr_dev"; do
    grep -q 'systemctl --user start workstation-herdr-server.service' "$launcher"
done
# Both launch binds can hold a client, so both app-ids have to be matched or the
# key opens a clone beside the picker's window -- the exact case this helper
# exists to prevent, and one that only shows up with a picker window already up.
grep -q 'app_id == "herdr" or .app_id == "dev-terminal"' "$herdr_window"
# The stamp is a fact with no expiry: the picker's rows are bounded by
# `git worktree list` rather than by a clock, and herdr restores a conversation
# with no age limit of its own, so a second window here could only disagree with
# it. Re-adding one would silently change what a reboot does.
# A plain `! grep` is exempt from errexit and would pass silently, so branch.
if grep -rq 'AGENT_EXPIRED_SECONDS' "$dev_flow"; then
    echo "the recency stamp grew an expiry window again: $dev_flow" >&2
    exit 1
fi
# The split layout's only restore-surviving mark. session.json persists a tab's
# custom_name and nothing about a pane beyond cwd and agent session, so without
# the tab test the toggle rebuilds the default layout over a live split one
# after every reboot.
# The single quotes are the point: match the literal shell variable names.
# shellcheck disable=SC2016
grep -q 'tab rename "$dev_tab" dev' "$dev_flow/executable_layout-split.sh"
# shellcheck disable=SC2016
grep -q 'layout_tab_for_label "$workspace" dev' "$dev_flow/executable_layout-toggle.sh"
# A remembered pane status belongs to the server that wrote it. Restored pane
# ids are the same ids, so without this the first idle after a restore reads as
# a turn that ended while the server was off.
grep -q '^agent_status_forget_all()' "$dev_flow/agent-finished.sh"
grep -q 'agent_status_forget_all' "$dev_flow/executable_agent-status-reset.sh"
grep -q 'agent-status-reset.sh' "$dev_flow/herdr-plugin.toml"
# One mechanism, two files: lib.sh documents the marker columns and spaces.sh is
# the only thing that writes them.
grep -q 'nagged' "$probes/lib.sh"
grep -q 'nagged' "$dev_flow/executable_spaces.sh"
grep -q 'def is_parked' "$dev_flow/executable_spaces.sh"
grep -q 'colour\["parked"\]' "$dev_flow/executable_spaces.sh"
grep -q 'case "parked"' "$herdr_widget/HerdrJobsWidget.qml"
grep -q 'parkedCount' "$herdr_widget/HerdrJobsWidget.qml"
# The widget's in-flight latch must expire on its own. DMS's Proc fires a
# command callback only once exit, stdout AND stderr have all been seen, and its
# timeout path sets exit alone, so a child whose streams never finish -- what
# suspending the machine does to one in flight -- leaves the callback uncalled
# forever. A latch cleared only by that callback then stops the widget polling
# for the rest of the session, reporting herdr down with herdr up, leaving no
# orphan process and no logged error behind to find it by.
grep -q 'pollStartedMs' "$herdr_widget/HerdrJobsWidget.qml"
grep -q 'pollCeilingMs' "$herdr_widget/HerdrJobsWidget.qml"

# The probe against fixtures, which is the half that runs with no live machine.
# procStart is substituted rather than pinned: it is the starttime of a live
# process, and the point of the stale fixture is that a wrong one is rejected.
probe_fixtures=$(mktemp -d)
cp -r tooling/fixtures/agent-probes/claude/sessions "$probe_fixtures/"
sed -i "s/__PROC1_START__/$(sed 's/.*) //' /proc/1/stat | awk '{print $20}')/" \
    "$probe_fixtures"/sessions/*.json
probe_saw=$(CLAUDE_CONFIG_DIR=$probe_fixtures "$probes/probes/claude" \
    <tooling/fixtures/agent-probes/claude/panes.json)
rm -rf "$probe_fixtures"
# pA is parked. pB is busy, which is a foreground turn. pC carries a procStart
# that no longer matches its pid, which is a session file outliving its session.
# pD has no session id at all.
[[ $probe_saw == '["pA"]' ]] || { echo "claude probe: expected [\"pA\"], got $probe_saw" >&2; exit 1; }
probe_saw=$(CLAUDE_CONFIG_DIR=/nonexistent "$probes/probes/claude" \
    <tooling/fixtures/agent-probes/claude/panes.json)
[[ $probe_saw == '[]' ]] || { echo "claude probe with no sessions: got $probe_saw" >&2; exit 1; }

# A probe that is there and does not answer must stay distinguishable from one
# that says no. Conflating them turns a single bad tick -- a timeout under load,
# a session file read mid-rewrite -- into a finish that never happened, which is
# the exact false mark the parked state exists to remove.
probe_stub=$(mktemp -d)
printf '#!/usr/bin/env bash\ncat >/dev/null\nexit 1\n' >"$probe_stub/claude"
chmod +x "$probe_stub/claude"
probe_pane='[{"pane_id":"pA","agent":"claude"}]'
if (
    # shellcheck source=../../system_files/usr/libexec/workstation-agent-probes/lib.sh
    . "$probes/lib.sh"
    AGENT_PROBE_DIR=$probe_stub agent_parked_probe "$probe_pane" >/dev/null
); then
    echo "agent_parked_probe reported success for a probe that failed" >&2
    exit 1
fi
# An agent with no probe is not a failure: that is the degrade path, and a
# machine running an unprobed agent must not have every tick read as unknown.
if ! (
    # shellcheck source=../../system_files/usr/libexec/workstation-agent-probes/lib.sh
    . "$probes/lib.sh"
    AGENT_PROBE_DIR=$probe_stub agent_parked_probe '[{"pane_id":"pA","agent":"codex"}]' >/dev/null
); then
    echo "agent_parked_probe reported failure for an agent with no probe" >&2
    exit 1
fi
rm -rf "$probe_stub"

# One mechanism, two files: DataGrip has no package on Linux -- the Homebrew cask
# is macOS-only and the Flathub build was retired -- so the image ships the
# launcher while workstation-bootstrap-user unpacks the vendor tarball, puts the
# binary on the session PATH and installs the icon into the user's hicolor theme.
# Either half alone is a launcher that does nothing or an install with no way to
# start it, and neither failure is visible until someone clicks the icon.
datagrip_desktop=system_files/usr/share/applications/datagrip.desktop
datagrip_bootstrap=system_files/usr/libexec/workstation-bootstrap-user
require_file "$datagrip_desktop"
require_file "$datagrip_bootstrap"
datagrip_exec="$(sed -nE 's/^Exec=([^ ]+).*/\1/p' "$datagrip_desktop")"
datagrip_icon="$(sed -nE 's/^Icon=(.+)/\1/p' "$datagrip_desktop")"
[[ -n $datagrip_exec && -n $datagrip_icon ]]
grep -q "local/bin/$datagrip_exec\"" "$datagrip_bootstrap" \
    || { echo "$datagrip_desktop runs $datagrip_exec, which $datagrip_bootstrap never links" >&2; exit 1; }
grep -q "icons/hicolor/scalable/apps" "$datagrip_bootstrap"
grep -q "$datagrip_icon.svg\"" "$datagrip_bootstrap" \
    || { echo "$datagrip_desktop names icon $datagrip_icon, which $datagrip_bootstrap never installs" >&2; exit 1; }

# One mechanism, three files: the browser automation path. Every way it breaks
# is silent, which is why each of these is a gate rather than a comment.
#
# The npm cache pin first. $HOME is /home/<user> while /home is a symlink to
# var/home, and npm reaching its cache through that symlink makes arborist
# prepend one more `var/` component to every tree path on each reify --
# unbounded, and invisible until an `npx <pkg>@latest` costs 51 s of pinned CPU.
# Measured before the pin: an 18.8 MB package-lock.json, 5014 entries, a
# 6588-character key, ~41 s of the run across path.normalizeString, path.resolve and path.relative.
#
# It is a systemd user-environment generator and not a chezmoi seed for
# ~/.npmrc, which was written first and reverted: npm writes that file itself on
# `npm login` and `npm config set`, so a manifest entry would put a
# credential-bearing file under tooling/audit/personal-config's byte-exact
# live-vs-rendered comparison, and tooling/dotfiles/sync is an empty case for
# the template kind -- leaving `copy`, which commits the token, as the only
# apparent way to clear the drift. Gated negatively for that reason.
npm_gen=system_files/usr/lib/systemd/user-environment-generators/70-workstation-npm-cache
require_file "$npm_gen"
require_file tooling/data/dotfiles.manifest
[[ -x $npm_gen ]] \
    || { echo "$npm_gen is not executable; systemd will not run it" >&2; exit 1; }
if grep -q 'npmrc' tooling/data/dotfiles.manifest; then
    echo "tooling/data/dotfiles.manifest tracks an npmrc: npm writes credentials there" >&2
    exit 1
fi
# Comments stripped throughout: this file argues its own design at length in
# prose that repeats every term the gates match, so an unstripped grep passes on
# the explanation after the code beneath it has changed. Two gates in this block
# were caught doing exactly that by the mutation suite.
npm_gen_code=$(grep -vE '^[[:space:]]*#' "$npm_gen")
grep -q 'npm_config_cache=' <<<"$npm_gen_code" \
    || { echo "$npm_gen emits no npm_config_cache assignment" >&2; exit 1; }
grep -q 'readlink -m' <<<"$npm_gen_code" \
    || { echo "$npm_gen must resolve the home path; \$HOME is the symlinked one here" >&2; exit 1; }
if grep -qE '/home/[a-z]|/var/home/[a-z]' <<<"$npm_gen_code"; then
    echo "$npm_gen hardcodes a home path; it must resolve one at runtime" >&2
    exit 1
fi

# The other two are one teardown path split across two files. `playwright-cli
# close` cannot end a CDP-attached browser on its own -- playwright-core builds
# the attach's browserProcess as a pair of transport closers -- so the wrapper
# has to reach the helper, and the helper identifies the browser by its own
# per-boot profile path, which is the only handle that works: flatpak moves the
# app into its own transient scope, so killing `flatpak run`'s bwrap left 16
# processes alive with the CDP port still answering.
#
# --die-with-parent is the flag that looks like the fix and is a regression. It
# does repair the ancestry, but it binds the app to the INVOKING SHELL: Chrome
# then dies the instant the helper exits, so the browser no longer survives
# between subcommands and every one of them relaunches it. Both halves measured.
# Gated negatively because the failure is silent -- teardown still works, and
# only the reuse this file exists for quietly stops happening.
pw_wrapper=system_files/usr/bin/playwright-cli
pw_chrome=system_files/usr/libexec/workstation-playwright-chrome
require_file "$pw_wrapper"
require_file "$pw_chrome"
# Comment lines stripped first: the file documents the flag at length precisely
# so nobody re-adds it, and the gate must read the code, not the warning.
if grep -vE '^[[:space:]]*#' "$pw_chrome" | grep -q -- '--die-with-parent'; then
    echo "$pw_chrome passes --die-with-parent: Chrome will not survive the script's own exit" >&2
    exit 1
fi
# Every gate below reads code with the comments stripped. Both files argue their
# own design at length in prose that repeats the exact terms being matched, so an
# unstripped grep goes green on the explanation after the code beneath it has
# changed -- four of these were doing precisely that.
pw_chrome_code=$(grep -vE '^[[:space:]]*#' "$pw_chrome")
pw_wrapper_code=$(grep -vE '^[[:space:]]*#' "$pw_wrapper")
grep -qE 'curl .*--max-time' <<<"$pw_chrome_code" \
    || { echo "$pw_chrome CDP probe needs --max-time; --connect-timeout does not bound the response" >&2; exit 1; }
# A cmdline SUBSTRING match also hits any process merely mentioning the profile
# path, the caller's own shell included; three were killed that way. The kill
# must test an exact argv element out of /proc.
# shellcheck disable=SC2016
grep -q '/proc/\$pid/cmdline' <<<"$pw_chrome_code" \
    || { echo "$pw_chrome must match an exact argv element from /proc, not a cmdline substring" >&2; exit 1; }
# The single quotes are the point: match the literal variable name in the helper.
# shellcheck disable=SC2016
grep -q 'user-data-dir=\$profile_dir' <<<"$pw_chrome_code" \
    || { echo "$pw_chrome must identify the browser by its profile path to stop it" >&2; exit 1; }
# The helper's half of the mechanism. Without these two, deleting the --stop
# branch leaves every wrapper gate green while `playwright-cli close` silently
# becomes `launch another browser` -- measured, 15 processes and a live endpoint.
grep -q -- '== --stop' <<<"$pw_chrome_code" \
    || { echo "$pw_chrome does not answer the --stop that $pw_wrapper sends it" >&2; exit 1; }
grep -q '^stop_chrome()' <<<"$pw_chrome_code" \
    || { echo "$pw_chrome defines no stop_chrome" >&2; exit 1; }
grep -q -- '--stop' <<<"$pw_wrapper_code" \
    || { echo "$pw_wrapper never stops the browser it starts" >&2; exit 1; }
grep -q 'workstation-playwright-chrome' <<<"$pw_wrapper_code" \
    || { echo "$pw_wrapper does not reach $pw_chrome" >&2; exit 1; }
# The subcommand is the first non-flag argument. Testing $1 matched only the bare
# form, so every `-s=NAME close` skipped the teardown and every `-s=NAME open`
# fell through to upstream and launched a downloaded chromium.
grep -q 'close-all' <<<"$pw_wrapper_code" \
    || { echo "$pw_wrapper does not translate close-all, so it leaves the browser running" >&2; exit 1; }
# Positive, because the ways to reintroduce the bug do not share a shape: the
# dispatch must be on the resolved subcommand, whatever the surrounding syntax.
# shellcheck disable=SC2016
grep -q 'case "\$subcommand" in' <<<"$pw_wrapper_code" \
    || { echo "$pw_wrapper does not dispatch on a resolved subcommand; \$1 misses every -s=NAME invocation" >&2; exit 1; }
if grep -qE '\$\{1:-\}' <<<"$pw_wrapper_code"; then
    echo "$pw_wrapper still reads \$1 directly, which misses every -s=NAME invocation" >&2
    exit 1
fi
# A bare `pkill -f` on that pattern also matches the shell that invoked the
# script, which killed exactly that during development.
if grep -qE '^\s*pkill -f' <<<"$pw_chrome_code"; then
    echo "$pw_chrome uses a bare pkill -f, which can match its own caller" >&2
    exit 1
fi

# --- every tracked structured config file parses -----------------------------
# A malformed greeter/settings.json fails at the login screen, which is the one
# place on this machine where a bad file is genuinely expensive to discover.
# Most of these 31 files were never parsed by anything. Deliberately not a
# pre-commit framework: that would be a second enforcement surface, and this
# already runs in CI.
parse_failures=0
while IFS= read -r f; do
    case "$f" in
        *.json)
            # .json5 is excluded below: comments and trailing commas are valid
            # there and jq rejects both.
            jq -e . "$f" >/dev/null 2>&1 || { echo "invalid JSON: $f" >&2; parse_failures=1; } ;;
        *.toml)
            python3 -c 'import sys,tomllib;tomllib.load(open(sys.argv[1],"rb"))' "$f" \
                || { echo "invalid TOML: $f" >&2; parse_failures=1; } ;;
        *.yml | *.yaml)
            yq -e . "$f" >/dev/null 2>&1 || { echo "invalid YAML: $f" >&2; parse_failures=1; } ;;
    esac
done < <(git ls-files '*.json' '*.toml' '*.yml' '*.yaml')
(( parse_failures == 0 )) || exit 1

# --- shipped scripts use one of two shebangs ---------------------------------
# #!/usr/bin/env bash for bash, #!/bin/sh for the POSIX ones. Anything else is
# an outlier rather than a decision -- workstation-ocr carried #!/usr/bin/bash
# alone among ten. build_files/ is excluded deliberately: those run inside the
# image where bash is at a known path, and they all use #!/usr/bin/bash.
while IFS= read -r f; do
    head -1 "$f" | grep -qxE '#!/usr/bin/env bash|#!/bin/sh' \
        || { echo "unexpected shebang in $f: $(head -1 "$f")" >&2; exit 1; }
done < <(find system_files/usr/bin system_files/usr/libexec system_files/usr/lib \
    -type f \( -perm /111 -o -name '*.sh' \))

echo "Repo-only source gates passed."
