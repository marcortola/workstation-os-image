#!/usr/bin/env bash
# Repo-only gates: everything provable from the checkout alone, with no live
# account, no installed IDEs and no running desktop.
#
# Split out of tooling/validate/all so CI can run it. CI previously ran only
# validate/repo, image-build, source-images and rpm-keys, which left the
# AGENTS.md reference gates, the AI seed and scrub assertions, and the worktree
# wiring checks unrun on every push -- and those are the ones that rot silently,
# because nothing else proves a renamed path or a leaked key.
#
# Anything needing the live machine (DMS overlay, JetBrains, foot, chezmoi
# against $HOME, audit/workstation) deliberately stays in validate/all.
set -euo pipefail
# Several assertions here are bare `[[ ]]` with no message, so a failure used
# to exit 1 printing nothing at all. Name the line instead.
trap 'echo "FAILED ${BASH_SOURCE[0]}:${LINENO}" >&2' ERR

# A `while read ... done < <(grep FILE)` on a missing FILE iterates zero times
# and passes. Assert the inputs exist so a rename breaks the gate loudly.
require_file() { test -f "$1" || { echo "gate input is missing: $1" >&2; exit 1; }; }

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

require_file AGENTS.md
require_file README.md
[[ $(< CLAUDE.md) == '@AGENTS.md' ]]
# Raised from 210 when AGENTS.md gained its Conventions section, then to 266 for
# the upstream-Zirconium watermark entry -- a source of truth an agent has to
# know exists, since nothing else in the tree implies that upstream is tracked
# at all. The cap is a forcing function against AGENTS.md becoming a second
# README, and invariants are exactly what it should protect -- but it only works
# if each rise is deliberate, so keep it in one place with a reason attached.
(( $(wc -l < AGENTS.md) <= 266 ))

# The agent guide and the README state policy; nothing else proves their
# references still exist, so they silently rot as recipes and paths are renamed.
# Assert the two classes that are mechanically checkable: every `just`/`wjust`
# target either names must be a real recipe, and every repo-root-relative path
# AGENTS.md and README.md cite must exist. Prose stays the author's problem; dangling
# pointers do not. The path alternation must name the CURRENT top-level trees --
# it named the deleted ones for two commits and matched nothing under either
# new tree.
agents_stale=0
recipes=" $(just --summary) "
# The prose files plus the checked-in agent commands. A slash command is prose
# that an agent executes, so a stale recipe or path in one is worse than in
# AGENTS.md: nothing reads it until the moment it is being relied on.
docs=(AGENTS.md README.md)
while IFS= read -r f; do docs+=("$f"); done < <(find .claude/commands -name '*.md' 2>/dev/null | sort)
(( ${#docs[@]} > 2 )) || { echo "no agent commands found under .claude/commands" >&2; exit 1; }
while read -r target; do
    [[ $recipes == *" $target "* ]] && continue
    echo "docs reference unknown recipe: just $target" >&2
    agents_stale=1
done < <(grep -ohE '`w?just [a-z][a-z0-9-]*' "${docs[@]}" \
    | sed -E 's/`w?just //' | sort -u)
while read -r path; do
    [[ -e $path ]] && continue
    echo "docs reference missing path: $path" >&2
    agents_stale=1
done < <(grep -ohE '`?(system_files|build_files|tooling)/[A-Za-z0-9._/-]*' "${docs[@]}" \
    | tr -d '`' | sed 's/[.,]$//' | sort -u)
(( agents_stale == 0 ))

# AI CLI config seeds must be secret-free by construction: the scrub filters
# strip secrets/machine-state on capture, and these positive gates assert the
# committed seeds (visible to CI even when live files are absent). gitleaks
# above is the generic backstop; these catch the tool-specific shapes it misses
# (e.g. the dash-broken context7 key gitleaks does not flag).
ai_seeds=system_files/usr/share/workstation-os-image/dotfiles
assert_absent() {
    # Fail if the extended-regexp $1 matches (case-insensitively) anywhere in
    # file $2. A plain `! grep` would be exempt from errexit and silently pass,
    # so branch.
    if grep -qiE "$1" "$2"; then
        echo "Secret/machine-state leaked into $2 (matched: $1)" >&2
        exit 1
    fi
}
claude_settings="$ai_seeds/dot_claude/create_settings.json"
jq -e 'has("env") | not' "$claude_settings" >/dev/null
# Help Scout leaks as the env-var values (HELPSCOUT_APP_*) AND as the lowercase
# plugin/marketplace identifiers (helpscout-navigator, help-scout-mcp).
assert_absent 'helpscout|help-scout' "$claude_settings"
assert_absent 'enabledPlugins|extraKnownMarketplaces' "$claude_settings"
assert_absent '/(var/)?home/' "$claude_settings"
# opencode.json is generated by the fusion installer (just ai-tools-install), not
# captured; only our context7 mcp fragment is tracked, and its key must be a
# {file:}/{env:} placeholder, never a literal.
jq -e '.mcp.context7.headers.CONTEXT7_API_KEY
        | startswith("{file:") or startswith("{env:")' \
    tooling/data/ai-tools/opencode-mcp-fragment.json >/dev/null
codex_config="$ai_seeds/dot_codex/create_config.toml"
# Only the canonical, secret-free OpenAI developer-docs MCP table may survive
# codex scrub.
if grep '^\[' "$codex_config" \
    | grep -Fvx \
        -e '[mcp_servers.openaiDeveloperDocs]' >/dev/null; then
    echo "Unapproved table leaked into $codex_config" >&2
    exit 1
fi
[[ $(grep -Fxc '[mcp_servers.openaiDeveloperDocs]' "$codex_config") -eq 1 ]]
grep -Fqx 'url = "https://developers.openai.com/mcp"' "$codex_config"
assert_absent 'HELPSCOUT_APP_(ID|SECRET)[[:space:]]*=' "$codex_config"
assert_absent '/(var/)?home/' "$codex_config"
assert_absent \
    '(\.local/share/opencode/auth\.json|\.codex/auth\.json|\.claude/\.credentials\.json)' \
    tooling/data/dotfiles.manifest
# The portable bundle is a projection of the seeds; it too must carry no key or
# absolute home path.
if grep -rIliE 'ctx7sk-|/home/[a-z]' \
    tooling/ai/ai-cli-setup/config tooling/ai/ai-cli-setup/opencode-mcp-fragment.json \
    >/dev/null 2>&1; then
    echo "Secret or absolute home path leaked into tooling/ai/ai-cli-setup" >&2
    exit 1
fi

# Claude Code's auto mode rewrites autoMode.environment for whichever project it
# is run in: organisation, private repository names, secret names, internal
# domains. It regenerates constantly, this repository is public, and gitleaks
# does not recognise any of it as a secret, so assert the scrub actually held.
jq -e '.autoMode.environment == null' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_claude/create_settings.json >/dev/null
jq -e '.autoMode.environment == null' \
    tooling/ai/ai-cli-setup/config/claude/settings.json >/dev/null

# Worktree untracked-file propagation: every creation path (herdr, Claude Code,
# the post-checkout hook, the JetBrains External Tool) reaches the same
# committed .worktreeinclude through `git worktree add`, so assert the wiring
# that keeps them in sync.
grep -q 'workstation-worktree-sync' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/template/hooks/create_executable_post-checkout
grep -q 'satococoa/tap/git-worktreeinclude' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/homebrew/create_Brewfile
grep -q 'templateDir' system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config
[[ -x tooling/worktree/init ]]
tooling/worktree/test-init

# --- every tracked structured config file parses -----------------------------
# A malformed greeter/settings.json fails at the login screen, which is the one
# place on this machine where a bad file is genuinely expensive to discover.
# Most of these 31 files were never parsed by anything. Deliberately not a
# pre-commit framework: that would be a second enforcement surface, and this
# already runs in CI.
parse_failures=0
while IFS= read -r f; do
    case "$f" in
        *.json)
            # .json5 is excluded below: comments and trailing commas are valid
            # there and jq rejects both.
            jq -e . "$f" >/dev/null 2>&1 || { echo "invalid JSON: $f" >&2; parse_failures=1; } ;;
        *.toml)
            python3 -c 'import sys,tomllib;tomllib.load(open(sys.argv[1],"rb"))' "$f" \
                || { echo "invalid TOML: $f" >&2; parse_failures=1; } ;;
        *.yml | *.yaml)
            yq -e . "$f" >/dev/null 2>&1 || { echo "invalid YAML: $f" >&2; parse_failures=1; } ;;
    esac
done < <(git ls-files '*.json' '*.toml' '*.yml' '*.yaml')
(( parse_failures == 0 )) || exit 1

# --- shipped scripts use one of two shebangs ---------------------------------
# #!/usr/bin/env bash for bash, #!/bin/sh for the POSIX ones. Anything else is
# an outlier rather than a decision -- workstation-ocr carried #!/usr/bin/bash
# alone among ten. build_files/ is excluded deliberately: those run inside the
# image where bash is at a known path, and they all use #!/usr/bin/bash.
while IFS= read -r f; do
    head -1 "$f" | grep -qxE '#!/usr/bin/env bash|#!/bin/sh' \
        || { echo "unexpected shebang in $f: $(head -1 "$f")" >&2; exit 1; }
done < <(find system_files/usr/bin system_files/usr/libexec -type f)

echo "Repo-only source gates passed."
