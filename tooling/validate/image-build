#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

fail() {
    echo "image build validation: $*" >&2
    exit 1
}

require_literal() {
    local file=$1
    local text=$2
    grep -Fq -- "$text" "$file" || fail "$file is missing: $text"
}

line_of() {
    local file=$1
    local text=$2
    grep -Fn -- "$text" "$file" | head -n 1 | cut -d: -f1
}

# --- base ---------------------------------------------------------------
require_literal Containerfile 'ARG BASE_IMAGE=ghcr.io/ublue-os/base-main'
# Both ublue inputs must be digest-pinned. A floating tag is the one pin that
# would actually hold, and leaving it floating makes no build reproducible.
for ref in 'ARG BASE_IMAGE=' 'FROM ghcr.io/ublue-os/brew'; do
    grep -F -- "$ref" Containerfile | grep -qE '@sha256:[0-9a-f]{64}' \
        || fail "not digest-pinned: $ref"
done
# A single full reference. A split image/tag pair silently produces
# `repo:tag:tag` as soon as anything passes a tagged --build-arg.
if grep -qE '^ARG BASE_TAG' Containerfile; then
    fail "BASE_IMAGE must be one full reference, not an image plus a separate tag"
fi
require_literal Containerfile 'FROM scratch AS ctx'
require_literal Containerfile 'COPY system_files/ /'
require_literal Containerfile 'COPY image.env /usr/share/workstation-os-image/image.env'
# Nothing else asserts the image is linted, or that warnings are fatal.
require_literal Containerfile 'bootc container lint --fatal-warnings'
require_literal Containerfile '/ctx/build_files/99-check-build.sh'

# Build inputs must be bind-mounted from the ctx stage, never COPYd into the
# final image, or they ship inside it.
if grep -Eq '^COPY build_files/' Containerfile; then
    fail "build inputs must reach the final stage via the ctx bind mount, not COPY"
fi

# --- layer ordering (the cache invariant) --------------------------------
package_layer=$(line_of Containerfile '/ctx/build_files/10-repos.sh')
config_layer=$(line_of Containerfile 'COPY system_files/ /')
(( package_layer < config_layer )) || \
    fail "runtime packages must be installed before copying volatile configuration"

# --- the chezmoi source must be immutable after COPY ---------------------
# tooling/dotfiles/preflight-migration proves things about the REPO tree. That
# proof only transfers to the machine if the image ships that tree byte for
# byte, so nothing may patch it in place the way the old workstation-patch-zdots
# helper (removed with the Zirconium base) did.
if grep -n 'workstation-os-image/dotfiles' build_files/*.sh 2>/dev/null | grep -v '^build_files/99-check-build.sh:'; then
    fail "no build step may mutate the chezmoi source tree"
fi

# --- pinning -------------------------------------------------------------
require_literal Containerfile 'KEYD_SHA256='
require_literal Containerfile 'FIRACODE_SHA256='

# --- repos are vendored, not fetched -------------------------------------
# A repofile pulled from a vendor URL at build time makes whatever baseurl and
# gpgkey it carries that day into this build's trust anchors.
if grep -Eq 'config-manager +addrepo +--from-repofile' build_files/*.sh Containerfile; then
    fail "third-party repos must be vendored under repos/, not fetched at build time"
fi
for r in build_files/repos/*.repo; do
    grep -q '^gpgcheck=1' "$r" || fail "$r must set gpgcheck=1"
done

# --- workflow ------------------------------------------------------------
require_literal .github/workflows/build.yml 'cache_args=(--layers)'
require_literal .github/workflows/build.yml "--cache-from \"\$CACHE_IMAGE\" --cache-ttl 25h"
require_literal .github/workflows/build.yml "--cache-to \"\$CACHE_IMAGE\""
require_literal .github/workflows/build.yml "if [[ \"\$EVENT_NAME\" != schedule ]]"
require_literal .github/workflows/build.yml "if: needs.image-inputs.outputs.changed == 'true'"

if grep -Eq 'redhat-actions/(buildah-build|podman-login|push-to-registry)' \
    .github/workflows/build.yml; then
    fail "deprecated Node-based Red Hat image actions must not be reintroduced"
fi

# --- build context -------------------------------------------------------
require_literal .containerignore '!Containerfile'
require_literal .containerignore '!system_files/**'
require_literal .containerignore '!build_files/**'

require_literal system_files/usr/lib/sysusers.d/workstation-docker.conf 'g docker - -'

echo "Image build cache and layering validation passed."
