#!/usr/bin/env bash
set -euo pipefail
# Several assertions here are bare `[[ ]]` with no message, so a failure used
# to exit 1 printing nothing at all. Name the line instead.
trap 'echo "FAILED ${BASH_SOURCE[0]}:${LINENO}" >&2' ERR

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

git diff --check

tooling/validate/repo
command -v cosign >/dev/null && tooling/validate/source-images
tooling/validate/rpm-keys

# One list, shared with the Shell lint step in .github/workflows/build.yml.
mapfile -t shell_files < <(tooling/validate/shell-files)
# The list cannot be empty, and a loop fed by a find that matches nothing passes
# without running -- which is how the two halves came to disagree unnoticed.
(( ${#shell_files[@]} > 50 ))
bash -n "${shell_files[@]}"

# One version, shared with that same step, which runs it as a pinned container.
# Findings move between shellcheck releases -- 0.9.0 and 0.10.0 report an SC2015
# on this tree that 0.11.0 does not -- so an unpinned local binary means a rule
# that passes here and fails in CI, or worse the reverse. A machine whose linter
# has rolled over stops rather than quietly reporting a different tree: confirm
# the new version is clean, then move the pin in the same change.
shellcheck_pin=$(cat tooling/data/shellcheck-version)
shellcheck_have=$(shellcheck --version | awk '$1 == "version:" { print $2 }')
[[ $shellcheck_have == "$shellcheck_pin" ]] || {
    echo "shellcheck $shellcheck_have is not the pin $shellcheck_pin in tooling/data/shellcheck-version" >&2
    echo "  re-run the lint under $shellcheck_have, then move the pin in the same change" >&2
    exit 1
}
# -x follows sourced files, which is what makes the source= directives already
# scattered through these scripts do anything at all; SCRIPTDIR resolves those
# relative paths against the sourcing file rather than the invocation directory,
# since the plugin scripts source their siblings.
shellcheck -x --source-path=SCRIPTDIR "${shell_files[@]}"

# Dictation records a complete WAV before uploading it, so it uses the
# completed-audio model and consumes that model's JSON response contract.
dictate_seed=system_files/usr/share/workstation-os-image/dotfiles/private_dot_local/bin/create_executable_workstation-dictate
grep -Fq -- '--form model=gpt-transcribe' "$dictate_seed"
grep -Fq -- '--form response_format=json' "$dictate_seed"
grep -Fq -- '.text | select(type == "string")' "$dictate_seed"
if grep -qE -- '--form model=(whisper-1|gpt-4o-transcribe)|--form response_format=text' \
    "$dictate_seed"; then
    echo "Legacy dictation transcription contract found in $dictate_seed" >&2
    exit 1
fi

# Neovim config seeds must be valid Lua (compile-check, no execution — the Lua
# analog of `bash -n` above), using the image's own Neovim so the check matches
# its LuaJIT dialect. Restricted to *.lua so JSON/TOML seeds are not fed to it;
# skipped where Neovim is unavailable (e.g. minimal CI), like other local gates.
if command -v nvim >/dev/null 2>&1; then
    mapfile -t nvim_lua < <(
        find system_files/usr/share/workstation-os-image/dotfiles/dot_config/nvim -name '*.lua' -print | sort
    )
    (( ${#nvim_lua[@]} )) && nvim --clean -l tooling/validate/lint-nvim-seeds.lua "${nvim_lua[@]}"
fi

just --fmt --check
just --list >/dev/null

# Lint the image build and CI workflows, and scan the tree for committed
# secrets. CI enforces the same three checks in .github/workflows/lint.yml.
tooling/validate/image-build
hadolint --config .hadolint.yaml Containerfile
actionlint
gitleaks dir . --no-banner --redact

tooling/validate/sources

tooling/dms/validate-overlay
jq -n -e \
    --slurpfile defaults <(tooling/dms/defaults) \
    --rawfile denied tooling/data/dms-settings-denylist '
    ($denied | split("\n")
      | map(sub("[[:space:]]*#.*$"; "") | select(length > 0))) as $keys
    | $keys | all(. as $key | $defaults[0] | has($key))
' >/dev/null

tooling/dms/test

fish --no-execute \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/fish/create_config.fish \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/fish/conf.d/*.fish \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/fish/functions/*.fish

python3 tooling/keybindings/build-cheatsheet.py --check

tooling/dotfiles/validate-manifest
tooling/ai/test-reset
tooling/ai/build-ai-cli-bundle --check

tmp="$(mktemp -d)"
trap 'rm -rf -- "$tmp"' EXIT

# Git reads the XDG global config before ~/.gitconfig, so a create-only
# identity seed coexists with credential helpers and lets explicit user
# identity overrides in ~/.gitconfig continue to win.
git_home="$tmp/git-home"
install -D -m 0644 \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config \
    "$git_home/.config/git/config"
git config --file "$git_home/.gitconfig" credential.helper store
# Assert the seed is what git resolves, not who the author is: hardcoding an
# identity here fails for anyone who forks the repo, and the property under
# test is that the XDG seed is readable and that ~/.gitconfig still outranks it.
seed_name=$(git config --file \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config user.name)
seed_email=$(git config --file \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config user.email)
[[ -n $seed_name && -n $seed_email ]]
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config user.name
) == "$seed_name" ]]
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config user.email
) == "$seed_email" ]]
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config credential.helper
) == store ]]
git config --file "$git_home/.gitconfig" user.name "Local Override"
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config user.name
) == "Local Override" ]]

tooling/audit/workstation
foot --check-config -c "$HOME/.config/foot/foot.ini"

# The repo tree IS the chezmoi source now. Nothing is overlaid from the live
# image, so these assertions test only what this repository ships.
cp -a system_files/usr/share/workstation-os-image/dotfiles/. "$tmp/"
chezmoi managed -S "$tmp" > "$tmp/managed"

# Every target the apply wrapper forces must actually be managed by the source
# tree it forces them from, or `chezmoi apply --force <target>` fails on a name
# no source entry answers to.
scaffold_seen=0
while IFS= read -r scaffold_target; do
    [[ -z $scaffold_target || $scaffold_target == \#* ]] && continue
    grep -Fqx "$scaffold_target" "$tmp/managed"
    scaffold_seen=$((scaffold_seen + 1))
done < system_files/usr/share/workstation-os-image/scaffold-targets
(( scaffold_seen > 0 ))

for target in \
    .config/foot/foot.ini \
    .config/foot/workstation.ini \
    .config/DankMaterialShell/themes/tokyoNightDark/theme.json \
    .config/DankMaterialShell/cheatsheets/workstation.json \
    .config/DankMaterialShell/plugins/herdrJobs/plugin.json \
    .config/DankMaterialShell/plugins/herdrJobs/HerdrJobsWidget.qml \
    .config/DankMaterialShell/plugin_settings.json \
    .config/herdr/plugins/dev-flow/focus-space.sh \
    .config/git/config \
    .config/git/ignore \
    .config/git/template/hooks/post-checkout \
    .config/niri/config.kdl \
    .config/niri/local.kdl \
    .config/homebrew/Brewfile; do
    grep -Fqx "$target" "$tmp/managed"
done

echo "Repository and local workstation validation passed."
