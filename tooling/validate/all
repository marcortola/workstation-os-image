#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

git diff --check

tooling/validate/repo
command -v cosign >/dev/null && tooling/validate/source-images
tooling/validate/rpm-keys

mapfile -t shell_files < <(
    find tooling system_files/usr/bin system_files/usr/libexec -type f \
        \( -perm /111 -o -name '*.sh' \) -print | sort
    find system_files/usr/share/workstation-os-image/dotfiles -type f \
        -name 'create_executable_*' -print | sort
    # Bundle scripts only (maxdepth 1 skips the vendored Node installer).
    find tooling/ai/ai-cli-setup -maxdepth 1 -name '*.sh' -print | sort
)
bash -n "${shell_files[@]}"
shellcheck "${shell_files[@]}"

# Dictation records a complete WAV before uploading it, so it uses the
# completed-audio model and consumes that model's JSON response contract.
dictate_seed=system_files/usr/share/workstation-os-image/dotfiles/private_dot_local/bin/create_executable_workstation-dictate
grep -Fq -- '--form model=gpt-transcribe' "$dictate_seed"
grep -Fq -- '--form response_format=json' "$dictate_seed"
grep -Fq -- '.text | select(type == "string")' "$dictate_seed"
if grep -qE -- '--form model=(whisper-1|gpt-4o-transcribe)|--form response_format=text' \
    "$dictate_seed"; then
    echo "Legacy dictation transcription contract found in $dictate_seed" >&2
    exit 1
fi

# Neovim config seeds must be valid Lua (compile-check, no execution — the Lua
# analog of `bash -n` above), using the image's own Neovim so the check matches
# its LuaJIT dialect. Restricted to *.lua so JSON/TOML seeds are not fed to it;
# skipped where Neovim is unavailable (e.g. minimal CI), like other local gates.
if command -v nvim >/dev/null 2>&1; then
    mapfile -t nvim_lua < <(
        find system_files/usr/share/workstation-os-image/dotfiles/dot_config/nvim -name '*.lua' -print | sort
    )
    (( ${#nvim_lua[@]} )) && nvim --clean -l tooling/validate/lint-nvim-seeds.lua "${nvim_lua[@]}"
fi

just --fmt --check
just --list >/dev/null

# Lint the image build and CI workflows, and scan the tree for committed
# secrets. CI enforces the same three checks in .github/workflows/lint.yml.
tooling/validate/image-build
hadolint --config .hadolint.yaml Containerfile
actionlint
gitleaks dir . --no-banner --redact

[[ $(< CLAUDE.md) == '@AGENTS.md' ]]
(( $(wc -l < AGENTS.md) <= 200 ))

# The agent guide states policy; nothing else proves its references still exist,
# so it silently rots as recipes and paths are renamed. Assert the two classes
# that are mechanically checkable: every `just <target>` it names must be a real
# recipe, and every repo-root-relative path it cites must exist. Prose stays the
# author's problem; dangling pointers do not.
agents_stale=0
recipes=" $(just --summary) "
while read -r target; do
    [[ $recipes == *" $target "* ]] && continue
    echo "AGENTS.md references unknown recipe: just $target" >&2
    agents_stale=1
done < <(grep -oE '`just [a-z][a-z0-9-]*' AGENTS.md | sed 's/`just //' | sort -u)
while read -r path; do
    [[ -e $path ]] && continue
    echo "AGENTS.md references missing path: $path" >&2
    agents_stale=1
done < <(grep -oE '`(image|tooling|config|rootfs)/[A-Za-z0-9._/-]*' AGENTS.md \
    | tr -d '`' | sort -u)
(( agents_stale == 0 ))

# AI CLI config seeds must be secret-free by construction: the scrub filters
# strip secrets/machine-state on capture, and these positive gates assert the
# committed seeds (visible to CI even when live files are absent). gitleaks
# above is the generic backstop; these catch the tool-specific shapes it misses
# (e.g. the dash-broken context7 key gitleaks does not flag).
ai_seeds=system_files/usr/share/workstation-os-image/dotfiles
assert_absent() {
    # Fail if the extended-regexp $1 matches (case-insensitively) anywhere in
    # file $2. A plain `! grep` would be exempt from errexit and silently pass,
    # so branch.
    if grep -qiE "$1" "$2"; then
        echo "Secret/machine-state leaked into $2 (matched: $1)" >&2
        exit 1
    fi
}
claude_settings="$ai_seeds/dot_claude/create_settings.json"
jq -e 'has("env") | not' "$claude_settings" >/dev/null
# Help Scout leaks as the env-var values (HELPSCOUT_APP_*) AND as the lowercase
# plugin/marketplace identifiers (helpscout-navigator, help-scout-mcp).
assert_absent 'helpscout|help-scout' "$claude_settings"
assert_absent 'enabledPlugins|extraKnownMarketplaces' "$claude_settings"
assert_absent '/(var/)?home/' "$claude_settings"
# opencode.json is generated by the fusion installer (just ai-tools-install), not
# captured; only our context7 mcp fragment is tracked, and its key must be a
# {file:}/{env:} placeholder, never a literal.
jq -e '.mcp.context7.headers.CONTEXT7_API_KEY
        | startswith("{file:") or startswith("{env:")' \
    tooling/data/ai-tools/opencode-mcp-fragment.json >/dev/null
codex_config="$ai_seeds/dot_codex/create_config.toml"
# Only canonical, secret-free Help Scout and OpenAI developer-docs MCP tables
# may survive codex scrub.
if grep '^\[' "$codex_config" \
    | grep -Fvx \
        -e '[mcp_servers.helpscout]' \
        -e '[mcp_servers.openaiDeveloperDocs]' >/dev/null; then
    echo "Unapproved table leaked into $codex_config" >&2
    exit 1
fi
[[ $(grep -Fxc '[mcp_servers.helpscout]' "$codex_config") -eq 1 ]]
[[ $(grep -Fxc '[mcp_servers.openaiDeveloperDocs]' "$codex_config") -eq 1 ]]
grep -Fqx 'command = "bash"' "$codex_config"
# Match literal $HOME in canonical TOML.
# shellcheck disable=SC2016
grep -Fqx 'args = ["-c", "exec bash \"$HOME/.codex/bin/helpscout-mcp\""]' \
    "$codex_config"
grep -Fqx 'url = "https://developers.openai.com/mcp"' "$codex_config"
assert_absent 'HELPSCOUT_APP_(ID|SECRET)[[:space:]]*=' "$codex_config"
assert_absent '/(var/)?home/' "$codex_config"
assert_absent \
    '(\.local/share/opencode/auth\.json|\.codex/auth\.json|\.claude/\.credentials\.json)' \
    tooling/data/dotfiles.manifest
# The portable bundle is a projection of the seeds; it too must carry no key or
# absolute home path. Help Scout identifiers are expected; credential values
# remain only in local 0600 files.
if grep -rIliE 'ctx7sk-|/home/[a-z]' \
    tooling/ai/ai-cli-setup/config tooling/ai/ai-cli-setup/opencode-mcp-fragment.json \
    >/dev/null 2>&1; then
    echo "Secret or absolute home path leaked into tooling/ai/ai-cli-setup" >&2
    exit 1
fi

# Claude Code's auto mode rewrites autoMode.environment for whichever project it
# is run in: organisation, private repository names, secret names, internal
# domains. It regenerates constantly, this repository is public, and gitleaks
# does not recognise any of it as a secret, so assert the scrub actually held.
jq -e '.autoMode.environment == null' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_claude/create_settings.json >/dev/null
jq -e '.autoMode.environment == null' \
    tooling/ai/ai-cli-setup/config/claude/settings.json >/dev/null

# Worktree untracked-file propagation: every creation path (herdr, Claude Code,
# the post-checkout hook, the JetBrains External Tool) reaches the same
# committed .worktreeinclude through `git worktree add`, so assert the wiring
# that keeps them in sync.
grep -q 'workstation-worktree-sync' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/template/hooks/create_executable_post-checkout
grep -q 'satococoa/tap/git-worktreeinclude' \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/homebrew/create_Brewfile
grep -q 'templateDir' system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config
[[ -x tooling/worktree/init ]]
tooling/worktree/test-init

tooling/dms/validate-overlay
jq -n -e \
    --slurpfile defaults <(tooling/dms/defaults) \
    --rawfile denied tooling/data/dms-settings-denylist '
    ($denied | split("\n")
      | map(sub("[[:space:]]*#.*$"; "") | select(length > 0))) as $keys
    | $keys | all(. as $key | $defaults[0] | has($key))
' >/dev/null

tooling/dms/test

fish --no-execute \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/fish/create_config.fish \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/fish/conf.d/*.fish \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/fish/functions/*.fish

tooling/dotfiles/validate-manifest
tooling/jetbrains/validate
tooling/ai/test-reset
tooling/ai/build-ai-cli-bundle --check

tmp="$(mktemp -d)"
trap 'rm -rf -- "$tmp"' EXIT

# Git reads the XDG global config before ~/.gitconfig, so a create-only
# identity seed coexists with credential helpers and lets explicit user
# identity overrides in ~/.gitconfig continue to win.
git_home="$tmp/git-home"
install -D -m 0644 \
    system_files/usr/share/workstation-os-image/dotfiles/dot_config/git/create_config \
    "$git_home/.config/git/config"
git config --file "$git_home/.gitconfig" credential.helper store
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config user.name
) == marcortola ]]
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config user.email
) == 15958009+marcortola@users.noreply.github.com ]]
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config credential.helper
) == store ]]
git config --file "$git_home/.gitconfig" user.name "Local Override"
[[ $(
    HOME="$git_home" XDG_CONFIG_HOME="$git_home/.config" \
        GIT_CONFIG_NOSYSTEM=1 git -C "$git_home" config user.name
) == "Local Override" ]]

tooling/audit/workstation
foot --check-config -c "$HOME/.config/foot/foot.ini"

# The repo tree IS the chezmoi source now. Nothing is overlaid from the live
# image, so these assertions test only what this repository ships.
cp -a system_files/usr/share/workstation-os-image/dotfiles/. "$tmp/"
chezmoi managed -S "$tmp" > "$tmp/managed"

for target in \
    .config/foot/foot.ini \
    .config/foot/workstation.ini \
    .config/DankMaterialShell/themes/tokyoNightDark/theme.json \
    .config/git/config \
    .config/git/ignore \
    .config/git/template/hooks/post-checkout \
    .config/niri/config.kdl \
    .config/niri/local.kdl \
    .config/homebrew/Brewfile; do
    grep -Fqx "$target" "$tmp/managed"
done

echo "Repository and local workstation validation passed."
