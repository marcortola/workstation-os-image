#!/usr/bin/env bash
# Exercise tooling/ai/reset-ai-cli against the real repository seeds with a throwaway
# $HOME, asserting the merge model: canonical portable keys are restored while
# machine-local state (codex trust tables, claude env, the live context7 key) is
# preserved, dry-run writes nothing, --replace drops machine state, and a backup
# is taken. Run by tooling/validate.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
reset="$repo_root/tooling/ai/reset-ai-cli"

tmp="$(mktemp -d)"
trap 'rm -rf -- "$tmp"' EXIT

fail() { echo "test-reset-ai-cli: FAIL: $*" >&2; exit 1; }

# Fresh fake home with drifted live files carrying machine-local state.
seed_home() {
    local home=$1
    rm -rf -- "$home"
    install -D -m 0644 /dev/stdin "$home/.codex/config.toml" <<'EOF'
model = "gpt-DRIFT"
model_reasoning_effort = "low"
[projects."/tmp/trusted-project"]
trust_level = "trusted"
[tui.model_availability_nux]
"gpt-DRIFT" = 1
EOF
    install -D -m 0644 /dev/stdin "$home/.claude/settings.json" <<'EOF'
{ "theme": "DRIFT", "env": { "HELPSCOUT_APP_SECRET": "live-secret" } }
EOF
}

run() {
    local home=$1; shift
    HOME="$home" XDG_STATE_HOME="$home/.local/state" \
        RESET_AI_CLI_SKIP_PROC_GUARD=1 "$reset" "$@"
}

# 1. Dry run writes nothing.
home="$tmp/dry"; seed_home "$home"
run "$home" --tool codex >/dev/null
grep -q '^model = "gpt-DRIFT"' "$home/.codex/config.toml" \
    || fail "dry run modified codex config.toml"

# 2. Merge reset: canonical head restored, machine tables preserved.
home="$tmp/merge"; seed_home "$home"
run "$home" --tool codex --force >/dev/null
grep -q '^model = "gpt-5.6-sol"' "$home/.codex/config.toml" \
    || fail "codex canonical model not restored"
grep -q '^model_reasoning_effort = "high"' "$home/.codex/config.toml" \
    || fail "codex canonical reasoning effort not restored"
grep -q '\[projects."/tmp/trusted-project"\]' "$home/.codex/config.toml" \
    || fail "codex project-trust table not preserved"
grep -q '\[tui.model_availability_nux\]' "$home/.codex/config.toml" \
    || fail "codex tui table not preserved"

# 3. Claude merge: shared key restored, live env (secret) preserved.
run "$home" --tool claude --force >/dev/null
jq -e '.theme == "auto"' "$home/.claude/settings.json" >/dev/null \
    || fail "claude canonical theme not restored"
jq -e '.model == "opus[1m]"' "$home/.claude/settings.json" >/dev/null \
    || fail "claude canonical model not restored"
jq -e '.env.HELPSCOUT_APP_SECRET == "live-secret"' \
    "$home/.claude/settings.json" >/dev/null \
    || fail "claude live env not preserved"

# 4. Backup was taken on the --force runs.
find "$home/.local/state/workstation-os-image/ai-cli-reset-backup" \
    -name config.toml -print -quit 2>/dev/null | grep -q . \
    || fail "no timestamped backup written on --force"

# 6. --replace hard-overwrites: machine tables dropped.
home="$tmp/replace"; seed_home "$home"
run "$home" --tool codex --force --replace >/dev/null
grep -q '^model = "gpt-5.6-sol"' "$home/.codex/config.toml" \
    || fail "--replace did not restore canonical head"
if grep -q '\[projects.' "$home/.codex/config.toml"; then
    fail "--replace kept the project-trust table (should drop it)"
fi

# 7. --diff is read-only and reports drift.
home="$tmp/diff"; seed_home "$home"
out="$(run "$home" --diff --tool codex || true)"
grep -q 'drift' <<<"$out" || fail "--diff did not report drift"
grep -q '^model = "gpt-DRIFT"' "$home/.codex/config.toml" \
    || fail "--diff modified live config.toml"

# 8. A portable table after a machine table must not be duplicated (would make
#    the TOML unparseable) -- the merge copies machine tables per-table only.
home="$tmp/codextable"; rm -rf -- "$home"
install -D -m 0644 /dev/stdin "$home/.codex/config.toml" <<'EOF'
model = "gpt-DRIFT"
[projects."/tmp/p"]
trust_level = "trusted"
[history]
persistence = "none"
EOF
run "$home" --tool codex --force >/dev/null
got="$home/.codex/config.toml"
grep -q '^model = "gpt-5.6-sol"' "$got" || fail "canonical head not restored (table case)"
[[ $(grep -c '^\[projects."/tmp/p"\]' "$got") -eq 1 ]] \
    || fail "projects table not preserved exactly once"
[[ $(grep -c '^\[history\]' "$got") -eq 0 ]] \
    || fail "non-machine table should be dropped on reset, never duplicated"
if command -v python3 >/dev/null 2>&1 && python3 -c 'import tomllib' 2>/dev/null; then
    python3 -c 'import tomllib,sys; tomllib.load(open(sys.argv[1],"rb"))' "$got" \
        || fail "reset produced unparseable TOML"
fi

echo "reset-ai-cli tests passed."
